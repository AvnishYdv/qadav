// internal/qadav_native/macho_emitter.ydv
// Native macOS 64-bit Mach-O Binary Emitter (61st Native Module)
// Milestone M12.7: Direct Machine Code Emission for macOS x86_64 / ARM64

declare i64 @pe_get_byte(i64, i64)
declare void @pe_set_byte(i64, i64, i64)
declare void @pe_set_u16(i64, i64, i64)
declare void @pe_set_u32(i64, i64, i64)
declare void @pe_set_u64(i64, i64, i64)
declare i64 @qadav_file_open_write(i64)
declare i64 @qadav_file_write(i64, i64, i64)
declare i64 @qadav_file_close(i64)
declare i64 @rt_strlen(i64)
declare i64 @qadav_alloc(i64)
declare void @qadav_free(i64)

process macho_emit_header⦅int64 buf ⸴ int64 cpu_type ⸴ int64 file_type ⸴ int64 ncmds ⸴ int64 sizeofcmds⦆ → int64 ⟦
    // MH_MAGIC_64 = 0xFEEDFACF (4277009103)
    pe_set_u32⦅buf ⸴ 0 ⸴ 4277009103⦆ ·
    // cputype = CPU_TYPE_X86_64 (0x01000007 = 16777223)
    pe_set_u32⦅buf ⸴ 4 ⸴ cpu_type⦆ ·
    // cpusubtype = CPU_SUBTYPE_LIB64 (3)
    pe_set_u32⦅buf ⸴ 8 ⸴ 3⦆ ·
    // filetype = MH_EXECUTE (2)
    pe_set_u32⦅buf ⸴ 12 ⸴ file_type⦆ ·
    // ncmds = 3
    pe_set_u32⦅buf ⸴ 16 ⸴ ncmds⦆ ·
    // sizeofcmds = 168
    pe_set_u32⦅buf ⸴ 20 ⸴ sizeofcmds⦆ ·
    // flags = MH_NOUNDEFS | MH_DYLDLINK | MH_PIE | MH_TWOLEVEL (2097285)
    pe_set_u32⦅buf ⸴ 24 ⸴ 2097285⦆ ·
    // reserved = 0
    pe_set_u32⦅buf ⸴ 28 ⸴ 0⦆ ·
    yield 32 ·
⟧

process macho_emit_pagezero⦅int64 buf ⸴ int64 offset⦆ → int64 ⟦
    // LC_SEGMENT_64 = 25
    pe_set_u32⦅buf ⸴ offset ⸴ 25⦆ ·
    // cmdsize = 72
    pe_set_u32⦅buf ⸴ offset ⊕ 4 ⸴ 72⦆ ·
    // segname "__PAGEZERO"
    pe_set_byte⦅buf ⸴ offset ⊕ 8 ⸴ 95⦆ ·
    pe_set_byte⦅buf ⸴ offset ⊕ 9 ⸴ 95⦆ ·
    pe_set_byte⦅buf ⸴ offset ⊕ 10 ⸴ 80⦆ ·
    pe_set_byte⦅buf ⸴ offset ⊕ 11 ⸴ 65⦆ ·
    pe_set_byte⦅buf ⸴ offset ⊕ 12 ⸴ 71⦆ ·
    pe_set_byte⦅buf ⸴ offset ⊕ 13 ⸴ 69⦆ ·
    pe_set_byte⦅buf ⸴ offset ⊕ 14 ⸴ 90⦆ ·
    pe_set_byte⦅buf ⸴ offset ⊕ 15 ⸴ 69⦆ ·
    pe_set_byte⦅buf ⸴ offset ⊕ 16 ⸴ 82⦆ ·
    pe_set_byte⦅buf ⸴ offset ⊕ 17 ⸴ 79⦆ ·
    int64 p18 ↦ 18 ·
    cycle p18 ≺ 24 ⟦
        pe_set_byte⦅buf ⸴ offset ⊕ p18 ⸴ 0⦆ ·
        p18 ← p18 ⊕ 1 ·
    ⟧
    // vmaddr = 0
    pe_set_u64⦅buf ⸴ offset ⊕ 24 ⸴ 0⦆ ·
    // vmsize = 4GB (4294967296)
    pe_set_u64⦅buf ⸴ offset ⊕ 32 ⸴ 4294967296⦆ ·
    // fileoff = 0, filesize = 0, maxprot = 0, initprot = 0, nsects = 0, flags = 0
    pe_set_u64⦅buf ⸴ offset ⊕ 40 ⸴ 0⦆ ·
    pe_set_u64⦅buf ⸴ offset ⊕ 48 ⸴ 0⦆ ·
    pe_set_u32⦅buf ⸴ offset ⊕ 56 ⸴ 0⦆ ·
    pe_set_u32⦅buf ⸴ offset ⊕ 60 ⸴ 0⦆ ·
    pe_set_u32⦅buf ⸴ offset ⊕ 64 ⸴ 0⦆ ·
    pe_set_u32⦅buf ⸴ offset ⊕ 68 ⸴ 0⦆ ·
    yield 72 ·
⟧

process macho_emit_text_segment⦅int64 buf ⸴ int64 offset⦆ → int64 ⟦
    // LC_SEGMENT_64 = 25
    pe_set_u32⦅buf ⸴ offset ⸴ 25⦆ ·
    // cmdsize = 72
    pe_set_u32⦅buf ⸴ offset ⊕ 4 ⸴ 72⦆ ·
    // segname "__TEXT"
    pe_set_byte⦅buf ⸴ offset ⊕ 8 ⸴ 95⦆ ·
    pe_set_byte⦅buf ⸴ offset ⊕ 9 ⸴ 95⦆ ·
    pe_set_byte⦅buf ⸴ offset ⊕ 10 ⸴ 84⦆ ·
    pe_set_byte⦅buf ⸴ offset ⊕ 11 ⸴ 69⦆ ·
    pe_set_byte⦅buf ⸴ offset ⊕ 12 ⸴ 88⦆ ·
    pe_set_byte⦅buf ⸴ offset ⊕ 13 ⸴ 84⦆ ·
    int64 p14 ↦ 14 ·
    cycle p14 ≺ 24 ⟦
        pe_set_byte⦅buf ⸴ offset ⊕ p14 ⸴ 0⦆ ·
        p14 ← p14 ⊕ 1 ·
    ⟧
    // vmaddr = 0x100000000 (4294967296)
    pe_set_u64⦅buf ⸴ offset ⊕ 24 ⸴ 4294967296⦆ ·
    // vmsize = 4096
    pe_set_u64⦅buf ⸴ offset ⊕ 32 ⸴ 4096⦆ ·
    // fileoff = 0, filesize = 4096
    pe_set_u64⦅buf ⸴ offset ⊕ 40 ⸴ 0⦆ ·
    pe_set_u64⦅buf ⸴ offset ⊕ 48 ⸴ 4096⦆ ·
    // maxprot = 7 (rwx), initprot = 5 (r-x)
    pe_set_u32⦅buf ⸴ offset ⊕ 56 ⸴ 7⦆ ·
    pe_set_u32⦅buf ⸴ offset ⊕ 60 ⸴ 5⦆ ·
    // nsects = 0, flags = 0
    pe_set_u32⦅buf ⸴ offset ⊕ 64 ⸴ 0⦆ ·
    pe_set_u32⦅buf ⸴ offset ⊕ 68 ⸴ 0⦆ ·
    yield 72 ·
⟧

process macho_emit_lc_main⦅int64 buf ⸴ int64 offset ⸴ int64 entryoff⦆ → int64 ⟦
    // LC_MAIN = 0x80000028 (2147483688)
    pe_set_u32⦅buf ⸴ offset ⸴ 2147483688⦆ ·
    // cmdsize = 24
    pe_set_u32⦅buf ⸴ offset ⊕ 4 ⸴ 24⦆ ·
    // entryoff = 1280 (0x500)
    pe_set_u64⦅buf ⸴ offset ⊕ 8 ⸴ entryoff⦆ ·
    // stacksize = 0
    pe_set_u64⦅buf ⸴ offset ⊕ 16 ⸴ 0⦆ ·
    yield 24 ·
⟧

process macho_build_executable⦅int64 src_path_ptr ⸴ int64 out_path_ptr⦆ → int64 ⟦
    int64 macho_buf ↦ qadav_alloc⦅4096⦆ ·
    // Zero out buffer
    int64 mi ↦ 0 ·
    cycle mi ≺ 4096 ⟦
        pe_set_byte⦅macho_buf ⸴ mi ⸴ 0⦆ ·
        mi ← mi ⊕ 1 ·
    ⟧
    
    // Header: 3 commands (__PAGEZERO, __TEXT, LC_MAIN), size = 72 + 72 + 24 = 168
    macho_emit_header⦅macho_buf ⸴ 16777223 ⸴ 2 ⸴ 3 ⸴ 168⦆ ·
    // Command 1: __PAGEZERO at offset 32
    macho_emit_pagezero⦅macho_buf ⸴ 32⦆ ·
    // Command 2: __TEXT at offset 104
    macho_emit_text_segment⦅macho_buf ⸴ 104⦆ ·
    // Command 3: LC_MAIN at offset 176
    macho_emit_lc_main⦅macho_buf ⸴ 176 ⸴ 1280⦆ ·
    
    // Write native macOS Mach-O binary to disk
    int64 fd ↦ qadav_file_open_write⦅out_path_ptr⦆ ·
    when fd ≺ 0 ⟦
        qadav_free⦅macho_buf⦆ ·
        yield 1 ·
    ⟧
    qadav_file_write⦅fd ⸴ macho_buf ⸴ 4096⦆ ·
    qadav_file_close⦅fd⦆ ·
    qadav_free⦅macho_buf⦆ ·
    yield 0 ·
⟧

process qadav_macho_build⦅text src_path ⸴ int64 out_path_ptr⦆ → int64 ⟦
    int64 res ↦ macho_build_executable⦅0 ⸴ out_path_ptr⦆ ·
    yield res ·
⟧

