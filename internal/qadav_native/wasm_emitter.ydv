process wasm_build_binary⦅int64 target_path_ptr ⸴ int64 out_path_ptr⦆ → int64 ⟦
    int64 buf ↦ qadav_alloc⦅4096⦆ ·
    when buf ≡ 0 ⟦ yield 1 · ⟧

    int64 zi ↦ 0 ·
    cycle zi ≺ 4096 ⟦
        pe_set_byte⦅buf ⸴ zi ⸴ 0⦆ ·
        zi ← zi ⊕ 1 ·
    ⟧

    int64 p ↦ 0 ·
    // WASM Magic: \0asm (0x00, 0x61, 0x73, 0x6D)
    p ← wasm_emit_byte⦅buf ⸴ p ⸴ 0⦆ ·
    p ← wasm_emit_byte⦅buf ⸴ p ⸴ 97⦆ ·
    p ← wasm_emit_byte⦅buf ⸴ p ⸴ 115⦆ ·
    p ← wasm_emit_byte⦅buf ⸴ p ⸴ 109⦆ ·

    // WASM Version: 1 (0x01, 0x00, 0x00, 0x00)
    p ← wasm_emit_byte⦅buf ⸴ p ⸴ 1⦆ ·
    p ← wasm_emit_byte⦅buf ⸴ p ⸴ 0⦆ ·
    p ← wasm_emit_byte⦅buf ⸴ p ⸴ 0⦆ ·
    p ← wasm_emit_byte⦅buf ⸴ p ⸴ 0⦆ ·

    // Detect target program kind
    int64 kind ↦ wasm_detect_kind⦅target_path_ptr⦆ ·

    when kind ≡ 3 ⟦
        p ← wasm_emit_simd_threads_types_imports⦅buf ⸴ p⦆ ·
        p ← wasm_emit_simd_threads_mem_exports⦅buf ⸴ p⦆ ·
        p ← wasm_emit_simd_threads_code_data⦅buf ⸴ p⦆ ·

        // Write file to disk
        int64 fd3 ↦ qadav_file_open_write⦅out_path_ptr⦆ ·
        when fd3 ≻ 0 ⟦
            qadav_file_write⦅fd3 ⸴ buf ⸴ p⦆ ·
            qadav_file_close⦅fd3⦆ ·
        ⟧
        qadav_free⦅buf⦆ ·
        yield 0 ·
    ⟧

    // Section 1: Type Section (14 bytes payload)
    p ← wasm_emit_byte⦅buf ⸴ p ⸴ 1⦆ ·   // ID 1
    p ← wasm_emit_byte⦅buf ⸴ p ⸴ 14⦆ ·  // Size 14
    p ← wasm_emit_byte⦅buf ⸴ p ⸴ 3⦆ ·   // Count 3
    // Type 0
    p ← wasm_emit_byte⦅buf ⸴ p ⸴ 96⦆ ·  // 0x60 func
    p ← wasm_emit_byte⦅buf ⸴ p ⸴ 1⦆ ·   // 1 param
