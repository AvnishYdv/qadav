    // Import 1: env.qadav_emit_text
    p ← wasm_emit_byte⦅buf ⸴ p ⸴ 3⦆ ·   // "env" len 3
    p ← wasm_emit_byte⦅buf ⸴ p ⸴ 101⦆ · // 'e'
