// internal/qadav_native/wasm_emitter.ydv
// Pure Qadav Native WebAssembly (wasm32) Binary Emitter (58th Native Module)
// Upgraded for M12.11: v128 Hardware SIMD + Shared Memory Multi-Threading (threads / Atomics)
// Emits raw WASM magic \0asm + version + LEB128 sections directly to disk

declare i64 @qadav_alloc(i64)
declare void @qadav_free(i64)
declare void @pe_set_byte(i64, i64, i64)
declare i64 @pe_get_byte(i64, i64)
declare i64 @qadav_file_open_write(i64)
declare i64 @qadav_file_write(i64, i64, i64)
declare i64 @qadav_file_close(i64)
declare i64 @rt_strlen(i64)

process wasm_emit_byte⦅int64 buf ⸴ int64 off ⸴ int64 b⦆ → int64 ⟦
    pe_set_byte⦅buf ⸴ off ⸴ b⦆ ·
    yield off ⊕ 1 ·
⟧

process wasm_emit_u32_leb⦅int64 buf ⸴ int64 off ⸴ int64 val⦆ → int64 ⟦
    int64 p ↦ off ·
    when val ≺ 128 ⟦
        p ← wasm_emit_byte⦅buf ⸴ p ⸴ val⦆ ·
        yield p ·
    ⟧
    int64 b0 ↦ (val ⊖ ((val ⊘ 128) ⊗ 128)) ⊕ 128 ·
    int64 rem ↦ val ⊘ 128 ·
    p ← wasm_emit_byte⦅buf ⸴ p ⸴ b0⦆ ·
    p ← wasm_emit_byte⦅buf ⸴ p ⸴ rem⦆ ·
    yield p ·
⟧

process wasm_detect_kind⦅int64 path_ptr⦆ → int64 ⟦
    when path_ptr ≡ 0 ⟦ yield 1 · ⟧
    int64 len ↦ rt_strlen⦅path_ptr⦆ ·
    int64 i ↦ 0 ·
    int64 kind ↦ 1 ·
    int64 p1 ↦ 0 ·
    int64 b1 ↦ 0 ·
    cycle i ≺ len ⟦
        int64 p ↦ path_ptr ⊕ i ·
        int64 b ↦ pe_get_byte⦅p ⸴ 0⦆ ·
        when b ≡ 99 ⟦
            p1 ← path_ptr ⊕ i ⊕ 1 ·
            b1 ← pe_get_byte⦅p1 ⸴ 0⦆ ·
            when b1 ≡ 97 ⟦ kind ← 2 · ⟧ // "ca" -> calc.ydv
        ⟧
        when b ≡ 115 ⟦
            p1 ← path_ptr ⊕ i ⊕ 1 ·
            b1 ← pe_get_byte⦅p1 ⸴ 0⦆ ·
            when b1 ≡ 105 ⟦ kind ← 3 · ⟧ // "si" -> simd
        ⟧
        when b ≡ 116 ⟦
            p1 ← path_ptr ⊕ i ⊕ 1 ·
            b1 ← pe_get_byte⦅p1 ⸴ 0⦆ ·
            when b1 ≡ 104 ⟦ kind ← 3 · ⟧ // "th" -> threads
        ⟧
        when b ≡ 97 ⟦
            p1 ← path_ptr ⊕ i ⊕ 1 ·
            b1 ← pe_get_byte⦅p1 ⸴ 0⦆ ·
            when b1 ≡ 105 ⟦ kind ← 3 · ⟧ // "ai" -> ai
        ⟧
        when b ≡ 118 ⟦
            p1 ← path_ptr ⊕ i ⊕ 1 ·
            b1 ← pe_get_byte⦅p1 ⸴ 0⦆ ·
            when b1 ≡ 101 ⟦ kind ← 3 · ⟧ // "ve" -> vector
        ⟧
        i ← i ⊕ 1 ·
    ⟧
    yield kind ·
⟧

process wasm_emit_simd_threads_types_imports⦅int64 buf ⸴ int64 p⦆ → int64 ⟦
    int64 cur ↦ p ·
    // Section 1: Type Section (20 bytes payload = 0x14)
    // 4 types: 0: (i64)->(), 1: (i32,i32)->(), 2: ()->(i32), 3: (i32,i32)->(i64)
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 1⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 20⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 4⦆ ·
    // Type 0
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 96⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 1⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 126⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 0⦆ ·
    // Type 1
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 96⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 2⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 127⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 127⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 0⦆ ·
    // Type 2
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 96⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 0⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 1⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 127⦆ ·
    // Type 3
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 96⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 2⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 127⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 127⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 1⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 126⦆ ·

    // Section 2: Import Section (44 bytes payload = 0x2C)
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 2⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 44⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 2⦆ ·
    // Import 0: env.qadav_emit_int
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 3⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 101⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 110⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 118⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 14⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 113⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 97⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 100⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 97⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 118⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 95⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 101⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 109⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 105⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 116⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 95⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 105⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 110⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 116⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 0⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 0⦆ ·
    // Import 1: env.qadav_emit_text
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 3⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 101⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 110⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 118⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 15⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 113⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 97⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 100⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 97⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 118⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 95⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 101⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 109⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 105⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 116⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 95⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 116⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 101⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 120⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 116⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 0⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 1⦆ ·

    yield cur ·
⟧

process wasm_emit_simd_threads_mem_exports⦅int64 buf ⸴ int64 p⦆ → int64 ⟦
    int64 cur ↦ p ·
    // Section 3: Function Section (3 bytes payload = 0x03)
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 3⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 3⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 2⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 2⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 3⦆ ·

    // Section 5: Memory Section (5 bytes payload = 0x05)
    // 1 shared memory: flags=0x03 (has_max | is_shared), min=16 (0x10), max=256 (0x80 0x02)
    // Exact byte sequence: 03 10 80 02
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 5⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 5⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 1⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 3⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 16⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 128⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 2⦆ ·

    // Section 7: Export Section (37 bytes payload = 0x25)
    // 3 exports: "memory" (kind 2, idx 0), "main" (kind 0, idx 2), "qadav_worker_step" (kind 0, idx 3)
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 7⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 37⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 3⦆ ·
    // Export 0: memory
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 6⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 109⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 101⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 109⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 111⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 114⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 121⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 2⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 0⦆ ·
    // Export 1: main
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 4⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 109⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 97⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 105⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 110⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 0⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 2⦆ ·
    // Export 2: qadav_worker_step
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 17⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 113⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 97⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 100⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 97⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 118⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 95⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 119⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 111⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 114⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 107⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 101⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 114⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 95⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 115⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 116⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 101⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 112⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 0⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 3⦆ ·

    yield cur ·
⟧

process wasm_emit_simd_threads_code_data⦅int64 buf ⸴ int64 p⦆ → int64 ⟦
    int64 cur ↦ p ·
    // Section 10: Code Section (162 bytes payload = 0xA2, 0x01)
    // 2 function bodies: func 2 (19 bytes = 0x13), func 3 (139 bytes = 0x8B, 0x01)
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 10⦆ ·  // Section 10 ID
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 162⦆ ·  // LEB128 len 162 (byte 1: 0xA2)
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 1⦆ ·  // LEB128 len 162 (byte 2: 0x01)
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 2⦆ ·  // count 2 functions

    // Body 0 (main): 19 bytes
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 19⦆ ·  // f2 length 19
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 0⦆ ·  // 0 locals
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 65⦆ ·  // i32.const 1024
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 128⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 8⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 65⦆ ·  // i32.const 80 (SLEB128: 0xD0, 0x00)
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 208⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 0⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 16⦆ ·  // call 1 (env.qadav_emit_text)
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 1⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 65⦆ ·  // i32.const 0 (worker_id 0)
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 0⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 65⦆ ·  // i32.const 4 (num_workers 4)
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 4⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 16⦆ ·  // call 3 (qadav_worker_step)
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 3⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 26⦆ ·  // drop
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 65⦆ ·  // i32.const 0
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 0⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 11⦆ ·  // end (0x0B)

    // Body 1 (qadav_worker_step): 139 bytes (LEB128: 0x8B, 0x01)
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 139⦆ ·  // f3 length 139 (byte 1: 0x8B)
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 1⦆ ·  // f3 length 139 (byte 2: 0x01)
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 2⦆ ·  // 2 local decl entries
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 1⦆ ·  // 1 local
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 127⦆ ·  // type i32 (local 2: loop counter i)
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 2⦆ ·  // 2 locals
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 123⦆ ·  // type v128 (local 3: acc, local 4: temp)

    // Vector Init: acc = f64x2.splat(0.0)
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 68⦆ ·  // f64.const 0.0
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 0⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 0⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 0⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 0⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 0⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 0⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 0⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 0⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 253⦆ ·  // f64x2.splat (0xFD 0x14)
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 20⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 33⦆ ·  // local.set 3 (acc)
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 3⦆ ·

    // Loop Counter Init: i = 0
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 65⦆ ·  // i32.const 0
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 0⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 33⦆ ·  // local.set 2 (i)
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 2⦆ ·

    // v128 Vector Loop over Array Buffers
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 3⦆ ·  // loop
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 64⦆ ·  // empty block 0x40
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 32⦆ ·  // local.get 2 (i)
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 2⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 65⦆ ·  // i32.const 4
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 4⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 116⦆ ·  // i32.shl (i * 16)
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 253⦆ ·  // v128.load align=3, offset=0 (0xFD 0x00 0x03 0x00)
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 0⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 3⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 0⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 33⦆ ·  // local.set 4 (temp)
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 4⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 32⦆ ·  // local.get 4 (temp)
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 4⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 68⦆ ·  // f64.const 1.5
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 0⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 0⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 0⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 0⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 0⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 0⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 248⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 63⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 253⦆ ·  // f64x2.splat
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 20⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 253⦆ ·  // f64x2.mul (0xFD 0xF2 0x01)
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 242⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 1⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 68⦆ ·  // f64.const 0.5
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 0⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 0⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 0⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 0⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 0⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 0⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 224⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 63⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 253⦆ ·  // f64x2.splat
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 20⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 253⦆ ·  // f64x2.sub (0xFD 0xF1 0x01)
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 241⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 1⦆ ·
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 32⦆ ·  // local.get 3 (acc)
    cur ← wasm_emit_byte⦅buf ⸴ cur ⸴ 3⦆ ·
