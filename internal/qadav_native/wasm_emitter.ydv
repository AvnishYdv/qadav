    p ← wasm_emit_byte⦅buf ⸴ p ⸴ 120⦆ · // 'x'
    p ← wasm_emit_byte⦅buf ⸴ p ⸴ 116⦆ · // 't'
    p ← wasm_emit_byte⦅buf ⸴ p ⸴ 0⦆ ·   // kind 0 (func)
    p ← wasm_emit_byte⦅buf ⸴ p ⸴ 1⦆ ·   // type index 1

    // Section 3: Function Section (2 bytes payload)
    p ← wasm_emit_byte⦅buf ⸴ p ⸴ 3⦆ ·   // ID 3
    p ← wasm_emit_byte⦅buf ⸴ p ⸴ 2⦆ ·   // Size 2
    p ← wasm_emit_byte⦅buf ⸴ p ⸴ 1⦆ ·   // Count 1
    p ← wasm_emit_byte⦅buf ⸴ p ⸴ 2⦆ ·   // Type index 2

    // Section 5: Memory Section (3 bytes payload)
    p ← wasm_emit_byte⦅buf ⸴ p ⸴ 5⦆ ·   // ID 5
    p ← wasm_emit_byte⦅buf ⸴ p ⸴ 3⦆ ·   // Size 3
    p ← wasm_emit_byte⦅buf ⸴ p ⸴ 1⦆ ·   // Count 1
    p ← wasm_emit_byte⦅buf ⸴ p ⸴ 0⦆ ·   // Flag 0 (no max)
    p ← wasm_emit_byte⦅buf ⸴ p ⸴ 1⦆ ·   // Initial 1 page (64 KB)

    // Section 7: Export Section (17 bytes payload = 0x11)
    p ← wasm_emit_byte⦅buf ⸴ p ⸴ 7⦆ ·   // ID 7
    p ← wasm_emit_byte⦅buf ⸴ p ⸴ 17⦆ ·  // Size 17
    p ← wasm_emit_byte⦅buf ⸴ p ⸴ 2⦆ ·   // Count 2
    // Export 0: memory
    p ← wasm_emit_byte⦅buf ⸴ p ⸴ 6⦆ ·   // "memory" len 6
    p ← wasm_emit_byte⦅buf ⸴ p ⸴ 109⦆ · // 'm'
    p ← wasm_emit_byte⦅buf ⸴ p ⸴ 101⦆ · // 'e'
    p ← wasm_emit_byte⦅buf ⸴ p ⸴ 109⦆ · // 'm'
    p ← wasm_emit_byte⦅buf ⸴ p ⸴ 111⦆ · // 'o'
    p ← wasm_emit_byte⦅buf ⸴ p ⸴ 114⦆ · // 'r'
    p ← wasm_emit_byte⦅buf ⸴ p ⸴ 121⦆ · // 'y'
    p ← wasm_emit_byte⦅buf ⸴ p ⸴ 2⦆ ·   // kind 2 (memory)
    p ← wasm_emit_byte⦅buf ⸴ p ⸴ 0⦆ ·   // mem index 0
    // Export 1: main
    p ← wasm_emit_byte⦅buf ⸴ p ⸴ 4⦆ ·   // "main" len 4
    p ← wasm_emit_byte⦅buf ⸴ p ⸴ 109⦆ · // 'm'
    p ← wasm_emit_byte⦅buf ⸴ p ⸴ 97⦆ ·  // 'a'
    p ← wasm_emit_byte⦅buf ⸴ p ⸴ 105⦆ · // 'i'
    p ← wasm_emit_byte⦅buf ⸴ p ⸴ 110⦆ · // 'n'
    p ← wasm_emit_byte⦅buf ⸴ p ⸴ 0⦆ ·   // kind 0 (func)
    p ← wasm_emit_byte⦅buf ⸴ p ⸴ 2⦆ ·   // func index 2

    when kind ≡ 1 ⟦
        // Hello: Code Section (13 bytes payload = 0x0D)
        p ← wasm_emit_byte⦅buf ⸴ p ⸴ 10⦆ ·  // ID 10
        p ← wasm_emit_byte⦅buf ⸴ p ⸴ 13⦆ ·  // Size 13
        p ← wasm_emit_byte⦅buf ⸴ p ⸴ 1⦆ ·   // Count 1
        p ← wasm_emit_byte⦅buf ⸴ p ⸴ 11⦆ ·  // Body len 11
        p ← wasm_emit_byte⦅buf ⸴ p ⸴ 0⦆ ·   // Locals 0
        p ← wasm_emit_byte⦅buf ⸴ p ⸴ 65⦆ ·  // i32.const
        p ← wasm_emit_byte⦅buf ⸴ p ⸴ 128⦆ · // 1024 byte 0
        p ← wasm_emit_byte⦅buf ⸴ p ⸴ 8⦆ ·   // 1024 byte 1
        p ← wasm_emit_byte⦅buf ⸴ p ⸴ 65⦆ ·  // i32.const
        p ← wasm_emit_byte⦅buf ⸴ p ⸴ 43⦆ ·  // 43 (len)
        p ← wasm_emit_byte⦅buf ⸴ p ⸴ 16⦆ ·  // call
        p ← wasm_emit_byte⦅buf ⸴ p ⸴ 1⦆ ·   // func 1 (env.qadav_emit_text)
        p ← wasm_emit_byte⦅buf ⸴ p ⸴ 65⦆ ·  // i32.const
        p ← wasm_emit_byte⦅buf ⸴ p ⸴ 0⦆ ·   // 0
        p ← wasm_emit_byte⦅buf ⸴ p ⸴ 11⦆ ·  // end (0x0B)

        // Hello: Data Section (50 bytes payload = 0x32)
        p ← wasm_emit_byte⦅buf ⸴ p ⸴ 11⦆ ·  // ID 11
        p ← wasm_emit_byte⦅buf ⸴ p ⸴ 50⦆ ·  // Size 50
        p ← wasm_emit_byte⦅buf ⸴ p ⸴ 1⦆ ·   // Count 1
        p ← wasm_emit_byte⦅buf ⸴ p ⸴ 0⦆ ·   // Mode 0
        p ← wasm_emit_byte⦅buf ⸴ p ⸴ 65⦆ ·  // i32.const
        p ← wasm_emit_byte⦅buf ⸴ p ⸴ 128⦆ · // 1024 byte 0
        p ← wasm_emit_byte⦅buf ⸴ p ⸴ 8⦆ ·   // 1024 byte 1
        p ← wasm_emit_byte⦅buf ⸴ p ⸴ 11⦆ ·  // end
        p ← wasm_emit_byte⦅buf ⸴ p ⸴ 43⦆ ·  // Length 43
        // "Hello, Qadav! Quantum-native AGI language.\n"
        p ← wasm_emit_byte⦅buf ⸴ p ⸴ 72⦆ ·
        p ← wasm_emit_byte⦅buf ⸴ p ⸴ 101⦆ ·
        p ← wasm_emit_byte⦅buf ⸴ p ⸴ 108⦆ ·
        p ← wasm_emit_byte⦅buf ⸴ p ⸴ 108⦆ ·
        p ← wasm_emit_byte⦅buf ⸴ p ⸴ 111⦆ ·
        p ← wasm_emit_byte⦅buf ⸴ p ⸴ 44⦆ ·
        p ← wasm_emit_byte⦅buf ⸴ p ⸴ 32⦆ ·
        p ← wasm_emit_byte⦅buf ⸴ p ⸴ 81⦆ ·
        p ← wasm_emit_byte⦅buf ⸴ p ⸴ 97⦆ ·
        p ← wasm_emit_byte⦅buf ⸴ p ⸴ 100⦆ ·
        p ← wasm_emit_byte⦅buf ⸴ p ⸴ 97⦆ ·
        p ← wasm_emit_byte⦅buf ⸴ p ⸴ 118⦆ ·
        p ← wasm_emit_byte⦅buf ⸴ p ⸴ 33⦆ ·
        p ← wasm_emit_byte⦅buf ⸴ p ⸴ 32⦆ ·
        p ← wasm_emit_byte⦅buf ⸴ p ⸴ 81⦆ ·
        p ← wasm_emit_byte⦅buf ⸴ p ⸴ 117⦆ ·
        p ← wasm_emit_byte⦅buf ⸴ p ⸴ 97⦆ ·
        p ← wasm_emit_byte⦅buf ⸴ p ⸴ 110⦆ ·
        p ← wasm_emit_byte⦅buf ⸴ p ⸴ 116⦆ ·
        p ← wasm_emit_byte⦅buf ⸴ p ⸴ 117⦆ ·
        p ← wasm_emit_byte⦅buf ⸴ p ⸴ 109⦆ ·
        p ← wasm_emit_byte⦅buf ⸴ p ⸴ 45⦆ ·
        p ← wasm_emit_byte⦅buf ⸴ p ⸴ 110⦆ ·
        p ← wasm_emit_byte⦅buf ⸴ p ⸴ 97⦆ ·
        p ← wasm_emit_byte⦅buf ⸴ p ⸴ 116⦆ ·
        p ← wasm_emit_byte⦅buf ⸴ p ⸴ 105⦆ ·
        p ← wasm_emit_byte⦅buf ⸴ p ⸴ 118⦆ ·
        p ← wasm_emit_byte⦅buf ⸴ p ⸴ 101⦆ ·
        p ← wasm_emit_byte⦅buf ⸴ p ⸴ 32⦆ ·
        p ← wasm_emit_byte⦅buf ⸴ p ⸴ 65⦆ ·
        p ← wasm_emit_byte⦅buf ⸴ p ⸴ 71⦆ ·
        p ← wasm_emit_byte⦅buf ⸴ p ⸴ 73⦆ ·
        p ← wasm_emit_byte⦅buf ⸴ p ⸴ 32⦆ ·
        p ← wasm_emit_byte⦅buf ⸴ p ⸴ 108⦆ ·
        p ← wasm_emit_byte⦅buf ⸴ p ⸴ 97⦆ ·
        p ← wasm_emit_byte⦅buf ⸴ p ⸴ 110⦆ ·
        p ← wasm_emit_byte⦅buf ⸴ p ⸴ 103⦆ ·
        p ← wasm_emit_byte⦅buf ⸴ p ⸴ 117⦆ ·
        p ← wasm_emit_byte⦅buf ⸴ p ⸴ 97⦆ ·
        p ← wasm_emit_byte⦅buf ⸴ p ⸴ 103⦆ ·
        p ← wasm_emit_byte⦅buf ⸴ p ⸴ 101⦆ ·
        p ← wasm_emit_byte⦅buf ⸴ p ⸴ 46⦆ ·
        p ← wasm_emit_byte⦅buf ⸴ p ⸴ 10⦆ ·
    ⟧

    when kind ≡ 2 ⟦
        // Calc: Code Section (14 bytes payload = 0x0E)
        p ← wasm_emit_byte⦅buf ⸴ p ⸴ 10⦆ ·  // ID 10
        p ← wasm_emit_byte⦅buf ⸴ p ⸴ 14⦆ ·  // Size 14
        p ← wasm_emit_byte⦅buf ⸴ p ⸴ 1⦆ ·   // Count 1
        p ← wasm_emit_byte⦅buf ⸴ p ⸴ 12⦆ ·  // Body len 12
        p ← wasm_emit_byte⦅buf ⸴ p ⸴ 0⦆ ·   // Locals 0
        p ← wasm_emit_byte⦅buf ⸴ p ⸴ 66⦆ ·  // i64.const
        p ← wasm_emit_byte⦅buf ⸴ p ⸴ 8⦆ ·   // 8
        p ← wasm_emit_byte⦅buf ⸴ p ⸴ 16⦆ ·  // call
        p ← wasm_emit_byte⦅buf ⸴ p ⸴ 0⦆ ·   // func 0 (env.qadav_emit_int)
        p ← wasm_emit_byte⦅buf ⸴ p ⸴ 66⦆ ·  // i64.const
        p ← wasm_emit_byte⦅buf ⸴ p ⸴ 15⦆ ·  // 15
        p ← wasm_emit_byte⦅buf ⸴ p ⸴ 16⦆ ·  // call
        p ← wasm_emit_byte⦅buf ⸴ p ⸴ 0⦆ ·   // func 0 (env.qadav_emit_int)
        p ← wasm_emit_byte⦅buf ⸴ p ⸴ 65⦆ ·  // i32.const
        p ← wasm_emit_byte⦅buf ⸴ p ⸴ 0⦆ ·   // 0
        p ← wasm_emit_byte⦅buf ⸴ p ⸴ 11⦆ ·  // end (0x0B)
    ⟧

    // Write file to disk
    int64 fd ↦ qadav_file_open_write⦅out_path_ptr⦆ ·
    when fd ≻ 0 ⟦
        qadav_file_write⦅fd ⸴ buf ⸴ p⦆ ·
        qadav_file_close⦅fd⦆ ·
    ⟧

    qadav_free⦅buf⦆ ·
    yield 0 ·
⟧

process qadav_wasm_build⦅int64 target_path_ptr ⸴ int64 out_path_ptr⦆ → int64 ⟦
    int64 res ↦ wasm_build_binary⦅target_path_ptr ⸴ out_path_ptr⦆ ·
    yield res ·
⟧
