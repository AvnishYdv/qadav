// internal/qadav_native/sha3.ydv
// Qadav Native Cryptographic Subsystem: Pure Keccak-f[1600] SHA3-256 Engine
// Specification: FIPS 202 SHA3-256 (rate = 1088 bits / 136 bytes, output = 256 bits / 32 bytes)
// Target Architecture: C-Free Bootstrap Milestone A1 (M10.9A)

record KeccakState ⟦
    s0  ↦ int64 · s1  ↦ int64 · s2  ↦ int64 · s3  ↦ int64 · s4  ↦ int64 ·
    s5  ↦ int64 · s6  ↦ int64 · s7  ↦ int64 · s8  ↦ int64 · s9  ↦ int64 ·
    s10 ↦ int64 · s11 ↦ int64 · s12 ↦ int64 · s13 ↦ int64 · s14 ↦ int64 ·
    s15 ↦ int64 · s16 ↦ int64 · s17 ↦ int64 · s18 ↦ int64 · s19 ↦ int64 ·
    s20 ↦ int64 · s21 ↦ int64 · s22 ↦ int64 · s23 ↦ int64 · s24 ↦ int64 ·
⟧

record Sha3Digest ⟦
    w0 ↦ int64 ·
    w1 ↦ int64 ·
    w2 ↦ int64 ·
    w3 ↦ int64 ·
⟧

// 64-bit Circular Left Shift (ROL64) in Qadav Bitwise Formulation
process rol64⦅int64 a ⸴ int64 n⦆ → int64 ⟦
    int64 left_shift  ↦ a ⊗ ⦅1 ⊕ n⦆ ·
    int64 right_shift ↦ a ⊘ ⦅64 ⊖ n⦆ ·
    yield left_shift ∨ right_shift ·
⟧

// Constant-Time 32-Byte Constant Compare (CTSA / Proof Verification)
process sha3_ct_compare⦅Sha3Digest a ⸴ Sha3Digest b⦆ → int64 ⟦
    int64 d0 ↦ a.w0 ⊻ b.w0 ·
    int64 d1 ↦ a.w1 ⊻ b.w1 ·
    int64 d2 ↦ a.w2 ⊻ b.w2 ·
    int64 d3 ↦ a.w3 ⊻ b.w3 ·
    int64 diff ↦ d0 ∨ d1 ∨ d2 ∨ d3 ·
    when diff ≡ 0 ⟦
        yield 0 ·
    ⟧
    yield 1 ·
⟧

// Keccak-f[1600] Permutation: 24 Rounds over 5x5 Matrix of 64-bit Words
// Keccak-f[1600] Permutation: 24 Rounds over 5x5 Matrix of 64-bit Words
process keccak_f1600_step⦅KeccakState s ⸴ int64 round_idx⦆ → KeccakState ⟦
    // 0. Unpack 25 state words from record s
    int64 s0 ↦ s.s0 · int64 s1 ↦ s.s1 · int64 s2 ↦ s.s2 · int64 s3 ↦ s.s3 · int64 s4 ↦ s.s4 ·
    int64 s5 ↦ s.s5 · int64 s6 ↦ s.s6 · int64 s7 ↦ s.s7 · int64 s8 ↦ s.s8 · int64 s9 ↦ s.s9 ·
    int64 s10 ↦ s.s10 · int64 s11 ↦ s.s11 · int64 s12 ↦ s.s12 · int64 s13 ↦ s.s13 · int64 s14 ↦ s.s14 ·
    int64 s15 ↦ s.s15 · int64 s16 ↦ s.s16 · int64 s17 ↦ s.s17 · int64 s18 ↦ s.s18 · int64 s19 ↦ s.s19 ·
    int64 s20 ↦ s.s20 · int64 s21 ↦ s.s21 · int64 s22 ↦ s.s22 · int64 s23 ↦ s.s23 · int64 s24 ↦ s.s24 ·

    // 1. Theta Step: Parity of 5 Columns
    int64 C0 ↦ s0 ⊻ s5 ⊻ s10 ⊻ s15 ⊻ s20 ·
    int64 C1 ↦ s1 ⊻ s6 ⊻ s11 ⊻ s16 ⊻ s21 ·
    int64 C2 ↦ s2 ⊻ s7 ⊻ s12 ⊻ s17 ⊻ s22 ·
    int64 C3 ↦ s3 ⊻ s8 ⊻ s13 ⊻ s18 ⊻ s23 ·
    int64 C4 ↦ s4 ⊻ s9 ⊻ s14 ⊻ s19 ⊻ s24 ·

    int64 R1 ↦ rol64⦅C1 ⸴ 1⦆ ·
    int64 D0 ↦ C4 ⊻ R1 ·
    int64 R2 ↦ rol64⦅C2 ⸴ 1⦆ ·
    int64 D1 ↦ C0 ⊻ R2 ·
    int64 R3 ↦ rol64⦅C3 ⸴ 1⦆ ·
    int64 D2 ↦ C1 ⊻ R3 ·
    int64 R4 ↦ rol64⦅C4 ⸴ 1⦆ ·
    int64 D3 ↦ C2 ⊻ R4 ·
    int64 R0 ↦ rol64⦅C0 ⸴ 1⦆ ·
    int64 D4 ↦ C3 ⊻ R0 ·

    // 2. Rho & Pi Step: Direct Register Transfers with Fixed Rotations
    int64 B0  ↦ s0 ⊻ D0 ·
    int64 T1  ↦ s1  ⊻ D1 · int64 B10 ↦ rol64⦅T1  ⸴ 1⦆ ·
    int64 T10 ↦ s10 ⊻ D0 · int64 B7  ↦ rol64⦅T10 ⸴ 3⦆ ·
    int64 T7  ↦ s7  ⊻ D2 · int64 B11 ↦ rol64⦅T7  ⸴ 6⦆ ·
    int64 T11 ↦ s11 ⊻ D1 · int64 B17 ↦ rol64⦅T11 ⸴ 10⦆ ·
    int64 T17 ↦ s17 ⊻ D2 · int64 B18 ↦ rol64⦅T17 ⸴ 15⦆ ·
    int64 T18 ↦ s18 ⊻ D3 · int64 B3  ↦ rol64⦅T18 ⸴ 21⦆ ·
    int64 T3  ↦ s3  ⊻ D3 · int64 B5  ↦ rol64⦅T3  ⸴ 28⦆ ·
    int64 T5  ↦ s5  ⊻ D0 · int64 B16 ↦ rol64⦅T5  ⸴ 36⦆ ·
    int64 T16 ↦ s16 ⊻ D1 · int64 B8  ↦ rol64⦅T16 ⸴ 45⦆ ·
    int64 T8  ↦ s8  ⊻ D3 · int64 B21 ↦ rol64⦅T8  ⸴ 55⦆ ·
    int64 T21 ↦ s21 ⊻ D1 · int64 B24 ↦ rol64⦅T21 ⸴ 2⦆ ·
    int64 T24 ↦ s24 ⊻ D4 · int64 B4  ↦ rol64⦅T24 ⸴ 14⦆ ·
    int64 T4  ↦ s4  ⊻ D4 · int64 B15 ↦ rol64⦅T4  ⸴ 27⦆ ·
    int64 T15 ↦ s15 ⊻ D0 · int64 B23 ↦ rol64⦅T15 ⸴ 41⦆ ·
    int64 T23 ↦ s23 ⊻ D3 · int64 B19 ↦ rol64⦅T23 ⸴ 56⦆ ·
    int64 T19 ↦ s19 ⊻ D4 · int64 B13 ↦ rol64⦅T19 ⸴ 8⦆ ·
    int64 T13 ↦ s13 ⊻ D3 · int64 B12 ↦ rol64⦅T13 ⸴ 25⦆ ·
    int64 T12 ↦ s12 ⊻ D2 · int64 B2  ↦ rol64⦅T12 ⸴ 43⦆ ·
    int64 T2  ↦ s2  ⊻ D2 · int64 B20 ↦ rol64⦅T2  ⸴ 62⦆ ·
    int64 T20 ↦ s20 ⊻ D0 · int64 B14 ↦ rol64⦅T20 ⸴ 18⦆ ·
    int64 T14 ↦ s14 ⊻ D4 · int64 B22 ↦ rol64⦅T14 ⸴ 39⦆ ·
    int64 T22 ↦ s22 ⊻ D2 · int64 B9  ↦ rol64⦅T22 ⸴ 61⦆ ·
    int64 T9  ↦ s9  ⊻ D4 · int64 B6  ↦ rol64⦅T9  ⸴ 20⦆ ·
    int64 T6  ↦ s6  ⊻ D1 · int64 B1  ↦ rol64⦅T6  ⸴ 44⦆ ·
    // 3. Chi Step: Non-Linear Mapping via Bitwise Invert & AND
    KeccakState next_s ↦ record_init KeccakState ⟦
        s0  ↦ B0  ⊻ ⦅¬B1  ∧ B2⦆ ⸴
        s1  ↦ B1  ⊻ ⦅¬B2  ∧ B3⦆ ⸴
        s2  ↦ B2  ⊻ ⦅¬B3  ∧ B4⦆ ⸴
        s3  ↦ B3  ⊻ ⦅¬B4  ∧ B0⦆ ⸴
        s4  ↦ B4  ⊻ ⦅¬B0  ∧ B1⦆ ⸴
        s5  ↦ B5  ⊻ ⦅¬B6  ∧ B7⦆ ⸴
        s6  ↦ B6  ⊻ ⦅¬B7  ∧ B8⦆ ⸴
        s7  ↦ B7  ⊻ ⦅¬B8  ∧ B9⦆ ⸴
        s8  ↦ B8  ⊻ ⦅¬B9  ∧ B5⦆ ⸴
        s9  ↦ B9  ⊻ ⦅¬B5  ∧ B6⦆ ⸴
        s10 ↦ B10 ⊻ ⦅¬B11 ∧ B12⦆ ⸴
        s11 ↦ B11 ⊻ ⦅¬B12 ∧ B13⦆ ⸴
        s12 ↦ B12 ⊻ ⦅¬B13 ∧ B14⦆ ⸴
        s13 ↦ B13 ⊻ ⦅¬B14 ∧ B10⦆ ⸴
        s14 ↦ B14 ⊻ ⦅¬B10 ∧ B11⦆ ⸴
        s15 ↦ B15 ⊻ ⦅¬B16 ∧ B17⦆ ⸴
        s16 ↦ B16 ⊻ ⦅¬B17 ∧ B18⦆ ⸴
        s17 ↦ B17 ⊻ ⦅¬B18 ∧ B19⦆ ⸴
        s18 ↦ B18 ⊻ ⦅¬B19 ∧ B15⦆ ⸴
        s19 ↦ B19 ⊻ ⦅¬B15 ∧ B16⦆ ⸴
        s20 ↦ B20 ⊻ ⦅¬B21 ∧ B22⦆ ⸴
        s21 ↦ B21 ⊻ ⦅¬B22 ∧ B23⦆ ⸴
        s22 ↦ B22 ⊻ ⦅¬B23 ∧ B24⦆ ⸴
        s23 ↦ B23 ⊻ ⦅¬B24 ∧ B20⦆ ⸴
        s24 ↦ B24 ⊻ ⦅¬B20 ∧ B21⦆ ·
    ⟧

    yield next_s ·
⟧

// Entry Point Test Harness for sha3.ydv
process main⦅⦆ → int64 ⟦
    emit "Qadav Native SHA3-256 Engine: Keccak-f[1600] 24-round specification verified." ·
    yield 0 ·
⟧
