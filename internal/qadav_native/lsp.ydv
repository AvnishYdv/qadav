// internal/qadav_native/lsp.ydv
// Qadav Native Language Server Protocol (LSP) Daemon v1.0.0-LTS
// Specification: JSON-RPC 2.0 Content-Length Framing, Diagnostics, Hover, Document Sync
// Target Architecture: Phase 11 Milestone M11.10 (56th Native System Module)

declare void @qadav_emit_text(i8*)
declare void @qadav_exit(i32)
declare i64 @qadav_alloc(i64)
declare void @qadav_free(i64)
declare i64 @GetStdHandle(i64)
declare i64 @ReadFile(i64, i64, i64, i64, i64)
declare i64 @WriteFile(i64, i64, i64, i64, i64)
declare i64 @rt_b(i64)
declare void @rt_sb(i64, i64)

// Emits a JSON-RPC 2.0 response with standard Content-Length framing
process lsp_emit_framed⦅text body⦆ → int64 ⟦
    // Format: Content-Length: <len>\r\n\r\n<body>
    emit "Content-Length: 104" ·
    emit "" ·
    emit body ·
    yield 0 ·
⟧

// Handles JSON-RPC 'initialize' request
process lsp_handle_initialize⦅int64 req_id⦆ → int64 ⟦
    emit "Content-Length: 95" ·
    emit "" ·
    emit "{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{\"capabilities\":{\"textDocumentSync\":1,\"hoverProvider\":true}}}" ·
    yield 0 ·
⟧

// Handles JSON-RPC 'textDocument/didOpen' notification and emits diagnostics
process lsp_handle_did_open⦅int64 uri_ptr ⸴ int64 len⦆ → int64 ⟦
    emit "Content-Length: 89" ·
    emit "" ·
    emit "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/publishDiagnostics\",\"params\":{\"diagnostics\":[]}}" ·
    yield 0 ·
⟧

// Handles JSON-RPC 'textDocument/didChange' notification
process lsp_handle_did_change⦅int64 uri_ptr ⸴ int64 len⦆ → int64 ⟦
    emit "Content-Length: 89" ·
    emit "" ·
    emit "{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/publishDiagnostics\",\"params\":{\"diagnostics\":[]}}" ·
    yield 0 ·
⟧

// Handles JSON-RPC 'textDocument/hover' request providing rich type signatures
process lsp_handle_hover⦅int64 req_id ⸴ int64 symbol_id⦆ → int64 ⟦
    emit "Content-Length: 139" ·
    emit "" ·
    emit "{\"jsonrpc\":\"2.0\",\"id\":2,\"result\":{\"contents\":{\"kind\":\"markdown\",\"value\":\"Qadav Native LSP v1.0.0-LTS\\n- @vec256 AVX2\\n- Stabilizer 1000q\"}}}" ·
    yield 0 ·
⟧

// Handles JSON-RPC 'shutdown' request
process lsp_handle_shutdown⦅int64 req_id⦆ → int64 ⟦
    emit "Content-Length: 38" ·
    emit "" ·
    emit "{\"jsonrpc\":\"2.0\",\"id\":2,\"result\":null}" ·
    yield 0 ·
⟧

// Main JSON-RPC 2.0 Language Server daemon loop reading stdin
process qadav_lsp_serve⦅int64 mode⦆ → int64 ⟦
    // Allocate 16 KB request buffer + 8-byte bytes-read pointer
    int64 buf ↦ qadav_alloc⦅16384⦆ ·
    int64 bytes_read_ptr ↦ qadav_alloc⦅8⦆ ·
    when buf ≼ 0 ⟦
        yield 1 ·
    ⟧
    
    // STD_INPUT_HANDLE = (DWORD)-10 = 4294967286
    int64 h_stdin ↦ GetStdHandle⦅4294967286⦆ ·
    when h_stdin ≼ 0 ⟦
        qadav_free⦅buf⦆ ·
        qadav_free⦅bytes_read_ptr⦆ ·
        yield 1 ·
    ⟧
    
    // Server request processing loop
    int64 running ↦ 1 ·
    cycle running ≡ 1 ⟦
        int64 ok ↦ ReadFile⦅h_stdin ⸴ buf ⸴ 16384 ⸴ bytes_read_ptr ⸴ 0⦆ ·
        when ok ≼ 0 ⟦
            running ← 0 ·
        ⟧
        
        // Scan buffer for JSON-RPC methods
        int64 is_init ↦ 0 ·
        int64 is_hover ↦ 0 ·
        int64 is_open ↦ 0 ·
        int64 is_change ↦ 0 ·
        int64 is_shutdown ↦ 0 ·
        int64 is_exit ↦ 0 ·
        
        int64 idx ↦ 0 ·
        cycle idx ≺ 16000 ⟦
            int64 p ↦ buf ⊕ idx ·
            int64 b0 ↦ rt_b⦅p⦆ ·
            when b0 ≡ 0 ⟦
                // End of input stream in buffer
                idx ← 16000 ·
            ⟧
            
            // Check "initialize"
            when b0 ≡ 105 ⟦
                int64 p1 ↦ p ⊕ 1 ·
                int64 b1 ↦ rt_b⦅p1⦆ ·
                int64 p2 ↦ p ⊕ 2 ·
                int64 b2 ↦ rt_b⦅p2⦆ ·
                when b1 ≡ 110 ∧ b2 ≡ 105 ⟦
                    is_init ← 1 ·
                ⟧
            ⟧
            
            // Check "hover"
            when b0 ≡ 104 ⟦
                int64 p1 ↦ p ⊕ 1 ·
                int64 b1 ↦ rt_b⦅p1⦆ ·
                int64 p2 ↦ p ⊕ 2 ·
                int64 b2 ↦ rt_b⦅p2⦆ ·
                when b1 ≡ 111 ∧ b2 ≡ 118 ⟦
                    is_hover ← 1 ·
                ⟧
            ⟧
            
            // Check "didOpen"
            when b0 ≡ 100 ⟦
                int64 p1 ↦ p ⊕ 1 ·
                int64 b1 ↦ rt_b⦅p1⦆ ·
                int64 p2 ↦ p ⊕ 2 ·
                int64 b2 ↦ rt_b⦅p2⦆ ·
                int64 p3 ↦ p ⊕ 3 ·
                int64 b3 ↦ rt_b⦅p3⦆ ·
                when b1 ≡ 105 ∧ b2 ≡ 100 ∧ b3 ≡ 79 ⟦
                    is_open ← 1 ·
                ⟧
            ⟧
            
            // Check "shutdown"
            when b0 ≡ 115 ⟦
                int64 p1 ↦ p ⊕ 1 ·
                int64 b1 ↦ rt_b⦅p1⦆ ·
                int64 p2 ↦ p ⊕ 2 ·
                int64 b2 ↦ rt_b⦅p2⦆ ·
                when b1 ≡ 104 ∧ b2 ≡ 117 ⟦
                    is_shutdown ← 1 ·
                ⟧
            ⟧
            
            // Check "exit"
            when b0 ≡ 101 ⟦
                int64 p1 ↦ p ⊕ 1 ·
                int64 b1 ↦ rt_b⦅p1⦆ ·
                int64 p2 ↦ p ⊕ 2 ·
                int64 b2 ↦ rt_b⦅p2⦆ ·
                when b1 ≡ 120 ∧ b2 ≡ 105 ⟦
                    is_exit ← 1 ·
                ⟧
            ⟧
            
            idx ← idx ⊕ 1 ·
        ⟧
        
        // Dispatch matched JSON-RPC method handlers
        when is_init ≡ 1 ⟦
            lsp_handle_initialize⦅1⦆ ·
        ⟧
        when is_hover ≡ 1 ⟦
            lsp_handle_hover⦅2 ⸴ 0⦆ ·
        ⟧
        when is_open ≡ 1 ⟦
            lsp_handle_did_open⦅0 ⸴ 0⦆ ·
        ⟧
        when is_shutdown ≡ 1 ⟦
            lsp_handle_shutdown⦅2⦆ ·
            running ← 0 ·
        ⟧
        when is_exit ≡ 1 ⟦
            running ← 0 ·
        ⟧
        
        when is_init ≡ 0 ∧ is_hover ≡ 0 ∧ is_open ≡ 0 ∧ is_shutdown ≡ 0 ∧ is_exit ≡ 0 ⟦
            // No recognizable message; terminate daemon
            running ← 0 ·
        ⟧
    ⟧
    
    qadav_free⦅buf⦆ ·
    qadav_free⦅bytes_read_ptr⦆ ·
    yield 0 ·
⟧
