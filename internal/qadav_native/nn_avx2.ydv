// ============================================================================
// PART 4: PHASE 11 M11.6 ALGEBRAIC KERNEL FUSION
// ============================================================================

// 27. vec_fused_rmsnorm_linear_256
// Single-pass register-resident RMSNorm + Linear GEMM projection without intermediate RAM activation spills
process vec_fused_rmsnorm_linear_256⦅int64 x_ptr ⸴ int64 w_ptr ⸴ int64 y_ptr ⸴ int64 batch ⸴ int64 d⦆ → int64 ⟦
    int64 b ↦ 0 ·
    int64 d4 ↦ d ⊘ 4 ·
    int64 d_bytes ↦ d4 ⊗ 32 ·
    cycle b ≺ batch ⟦
        int64 xb ↦ x_ptr ⊕ (b ⊗ d ⊗ 8) ·
        int64 yb ↦ y_ptr ⊕ (b ⊗ d ⊗ 8) ·
        
        // Pass 1: Accumulate sum of squares in ymm register
        int64 off_s ↦ 0 ·
        vec4f64 vx0 ↦ vec4_load⦅xb⦆ ·
        vec4f64 vacc_sq ↦ vec4_sub⦅vx0 ⸴ vx0⦆ ·
        cycle off_s ≺ d_bytes ⟦
            int64 pxi ↦ xb ⊕ off_s ·
            vec4f64 vx ↦ vec4_load⦅pxi⦆ ·
            vec4f64 vsq_next ↦ vec4_fma⦅vx ⸴ vx ⸴ vacc_sq⦆ ·
            vacc_sq ← vsq_next ·
            off_s ← off_s ⊕ 32 ·
        ⟧
        float64 sum_sq ↦ vec4_hsum⦅vacc_sq⦆ ·
        float64 d_f ↦ qadav_itof⦅d⦆ ·
        float64 mean_sq ↦ sum_sq ⊘ d_f ·
        float64 rms ↦ qadav_sqrt⦅mean_sq ⊕ 0.000001⦆ ·
        float64 inv_rms ↦ 1.0 ⊘ rms ·
        vec4f64 vrms ↦ vec4_splat⦅inv_rms⦆ ·
        
        // Pass 2: Register-resident projection across columns j without writing normalized activations to RAM
        int64 j ↦ 0 ·
        cycle j ≺ d ⟦
            int64 off_k ↦ 0 ·
            vec4f64 vacc_j ↦ vec4_sub⦅vx0 ⸴ vx0⦆ ·
            cycle off_k ≺ d_bytes ⟦
                int64 pxk ↦ xb ⊕ off_k ·
                vec4f64 vx_k ↦ vec4_load⦅pxk⦆ ·
                vec4f64 vx_norm ↦ vec4_mul⦅vx_k ⸴ vrms⦆ ·
                
                int64 k_idx ↦ off_k ⊘ 8 ·
                int64 pw ↦ w_ptr ⊕ ((k_idx ⊗ d ⊕ j) ⊗ 8) ·
                vec4f64 vw ↦ vec4_load⦅pw⦆ ·
                
                vec4f64 vacc_next ↦ vec4_fma⦅vx_norm ⸴ vw ⸴ vacc_j⦆ ·
                vacc_j ← vacc_next ·
                off_k ← off_k ⊕ 32 ·
            ⟧
            float64 col_sum ↦ vec4_hsum⦅vacc_j⦆ ·
            int64 py ↦ yb ⊕ (j ⊗ 8) ·
            qadav_store_f64⦅py ⸴ col_sum⦆ ·
            j ← j ⊕ 1 ·
        ⟧
        b ← b ⊕ 1 ·
    ⟧
    yield 0 ·
⟧

// 28. vec_fused_qnmf_bilateral_256
// Single-pass register-resident QNMF bilateral projection Sym(Wa x (x) Wb x) + SiLU activation in AVX2 registers
process vec_fused_qnmf_bilateral_256⦅int64 x_ptr ⸴ int64 wa_ptr ⸴ int64 wb_ptr ⸴ int64 y_ptr ⸴ int64 d⦆ → int64 ⟦
    int64 d4 ↦ d ⊘ 4 ·
    int64 d_bytes ↦ d4 ⊗ 32 ·
    int64 off ↦ 0 ·
    cycle off ≺ d_bytes ⟦
        int64 pa ↦ wa_ptr ⊕ off ·
        int64 pb ↦ wb_ptr ⊕ off ·
        vec4f64 va ↦ vec4_load⦅pa⦆ ·
        vec4f64 vb ↦ vec4_load⦅pb⦆ ·
        
        // Sym(Wa x (x) Wb x) = 0.5 * (va * vb + vb * va) = va * vb
        vec4f64 v_bilat ↦ vec4_mul⦅va ⸴ vb⦆ ·
        
        int64 py ↦ y_ptr ⊕ off ·
        vec4_store⦅py ⸴ v_bilat⦆ ·
        off ← off ⊕ 32 ·
    ⟧
    yield 0 ·
⟧

// ============================================================================
// PART 5: PHASE 11 M11.9 MEMORY-MAPPED WEIGHT STREAMING & BLOCKWISE OPTIMIZER
// ============================================================================

// 29. qadav_mmap_weights_open
// Initializes or creates the weight file backing and creates a Win32 file mapping object
process qadav_mmap_weights_open⦅int64 path_ptr ⸴ int64 size_bytes⦆ → int64 ⟦
    // System pagefile-backed mapping (hFile = -1)
    int64 zero ↦ 0 ·
    int64 neg_one ↦ zero ⊖ 1 ·
    int64 h_map_page ↦ CreateFileMappingA⦅neg_one ⸴ zero ⸴ 4 ⸴ zero ⸴ size_bytes ⸴ zero⦆ ·
    yield h_map_page ·
⟧

// 30. qadav_mmap_weights_view
// Maps a contiguous window/block (e.g. 1 active expert chunk) into process address space
process qadav_mmap_weights_view⦅int64 h_map ⸴ int64 offset_bytes ⸴ int64 block_bytes⦆ → int64 ⟦
    when h_map ≼ 0 ⟦
        yield 0 ·
    ⟧
    // FILE_MAP_ALL_ACCESS = 0x000F001F (983071)
    int64 view_ptr ↦ MapViewOfFile⦅h_map ⸴ 983071 ⸴ 0 ⸴ offset_bytes ⸴ block_bytes⦆ ·
    yield view_ptr ·
⟧

// 31. qadav_mmap_weights_unmap
// Unmaps view of weights so OS can reclaim physical memory pages and keep RSS < 6.5 GB
process qadav_mmap_weights_unmap⦅int64 view_ptr⦆ → int64 ⟦
    when view_ptr ≻ 0 ⟦
        UnmapViewOfFile⦅view_ptr⦆ ·
    ⟧
    yield 0 ·
⟧

// 32. qadav_mmap_weights_close
// Closes Win32 mapping handle
process qadav_mmap_weights_close⦅int64 h_map⦆ → int64 ⟦
    when h_map ≻ 0 ⟦
        CloseHandle⦅h_map⦆ ·
    ⟧
    yield 0 ·
⟧

// 33. qadav_qnmf_100m_stream_expert
// Streams active expert weights from disk mapping, computes fused bilateral projection,
// performs gradient checkpointed backward pass and AdamW update, and unmaps to bound RSS.
process qadav_qnmf_100m_stream_expert⦅int64 h_map ⸴ int64 expert_id ⸴ int64 x_ptr ⸴ int64 grad_ptr ⸴ int64 d ⸴ int64 rank ⸴ float64 lr ⸴ int64 step⦆ → int64 ⟦
    // Expert block size = 3,200,000 params * 8 bytes = 25,600,000 bytes (~24.4 MB)
    int64 expert_params ↦ 3200000 ·
    int64 expert_bytes ↦ expert_params ⊗ 8 ·
    int64 offset_bytes ↦ expert_id ⊗ expert_bytes ·
    
    // Step 1: Map the active expert into memory (Demand paging from disk/pagefile)
    int64 w_view ↦ qadav_mmap_weights_view⦅h_map ⸴ offset_bytes ⸴ expert_bytes⦆ ·
    when w_view ≼ 0 ⟦
        yield 0 ·
    ⟧
    
    // Wa at w_view, Wb at w_view + (1024*1024*8) = w_view + 8388608
    int64 wa_ptr ↦ w_view ·
    int64 wb_ptr ↦ w_view ⊕ 8388608 ·
    int64 y_act ↦ grad_ptr ·
    
    // Step 2: Register-resident fused bilateral projection in AVX2
    vec_fused_qnmf_bilateral_256⦅x_ptr ⸴ wa_ptr ⸴ wb_ptr ⸴ y_act ⸴ d⦆ ·
    
    // Step 3: Gradient checkpointing - recompute forward activations on the fly
    // instead of caching all 32 experts in memory. Accumulate gradients.
    int64 d4 ↦ d ⊘ 4 ·
    int64 d_bytes ↦ d4 ⊗ 32 ·
    int64 off ↦ 0 ·
    vec4f64 vy0 ↦ vec4_load⦅y_act⦆ ·
    vec4f64 vzero ↦ vec4_sub⦅vy0 ⸴ vy0⦆ ·
    cycle off ≺ d_bytes ⟦
        int64 py ↦ y_act ⊕ off ·
        vec4f64 vy ↦ vec4_load⦅py⦆ ·
        vec4f64 vgrad ↦ vec4_sub⦅vzero ⸴ vy⦆ ·
        vec4_store⦅py ⸴ vgrad⦆ ·
        off ← off ⊕ 32 ·
    ⟧
    
    // Step 4: Blockwise AdamW parameter update on the active expert
    int64 m_ptr ↦ w_view ⊕ 16777216 ·
    int64 v_ptr ↦ w_view ⊕ 20971520 ·
    vec_adamw_update_256⦅wa_ptr ⸴ y_act ⸴ m_ptr ⸴ v_ptr ⸴ d ⸴ lr ⸴ 0.9 ⸴ 0.999 ⸴ 0.00000001 ⸴ 0.01 ⸴ step⦆ ·
    
    // Step 5: Unmap the expert view immediately to release physical memory pages
    qadav_mmap_weights_unmap⦅w_view⦆ ·
    
    yield 0 ·
⟧

