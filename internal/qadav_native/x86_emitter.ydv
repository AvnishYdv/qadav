process x86_build_executable⦅int64 target_path_ptr ⸴ int64 out_path_ptr⦆ → int64 ⟦
    int64 buf ↦ qadav_alloc⦅4096⦆ ·
    when buf ≡ 0 ⟦ yield 1 · ⟧

    // Zero out buffer
    int64 zi ↦ 0 ·
    cycle zi ≺ 4096 ⟦
        pe_set_byte⦅buf ⸴ zi ⸴ 0⦆ ·
        zi ← zi ⊕ 1 ·
    ⟧

    // Initialize headers & imports
    int64 h_res ↦ x86_init_pe_headers⦅buf⦆ ·
    int64 i_res ↦ x86_init_pe_imports⦅buf⦆ ·

    // Detect program kind
    int64 kind ↦ x86_detect_kind⦅target_path_ptr⦆ ·
    int64 msg_len ↦ x86_write_msg⦅buf ⸴ kind⦆ ·

    // Machine code in .text (at FileOffset 512 = 0x200, RVA 0x1000)
    int64 p ↦ 512 ·

    // If AVX2 test, execute AVX2 instructions first
    when kind ≡ 6 ⟦
        // vxorps ymm0, ymm0, ymm0 (C5 F8 57 C0)
        p ← x86_emit_byte⦅buf ⸴ p ⸴ 197⦆ ·
        p ← x86_emit_byte⦅buf ⸴ p ⸴ 248⦆ ·
        p ← x86_emit_byte⦅buf ⸴ p ⸴ 87⦆ ·
        p ← x86_emit_byte⦅buf ⸴ p ⸴ 192⦆ ·
        // vaddpd ymm0, ymm0, ymm0 (C5 FD 58 C0)
        p ← x86_emit_byte⦅buf ⸴ p ⸴ 197⦆ ·
        p ← x86_emit_byte⦅buf ⸴ p ⸴ 253⦆ ·
        p ← x86_emit_byte⦅buf ⸴ p ⸴ 88⦆ ·
        p ← x86_emit_byte⦅buf ⸴ p ⸴ 192⦆ ·
        // vzeroupper (C5 F8 77)
        p ← x86_emit_byte⦅buf ⸴ p ⸴ 197⦆ ·
        p ← x86_emit_byte⦅buf ⸴ p ⸴ 248⦆ ·
        p ← x86_emit_byte⦅buf ⸴ p ⸴ 119⦆ ·
    ⟧

    // sub rsp, 40 (0x48 0x83 0xEC 0x28)
    p ← x86_emit_byte⦅buf ⸴ p ⸴ 72⦆ ·
    p ← x86_emit_byte⦅buf ⸴ p ⸴ 131⦆ ·
    p ← x86_emit_byte⦅buf ⸴ p ⸴ 236⦆ ·
    p ← x86_emit_byte⦅buf ⸴ p ⸴ 40⦆ ·

    // mov ecx, -11 (0xB9 0xF5 0xFF 0xFF 0xFF)
    p ← x86_emit_byte⦅buf ⸴ p ⸴ 185⦆ ·
    p ← x86_emit_byte⦅buf ⸴ p ⸴ 245⦆ ·
    p ← x86_emit_byte⦅buf ⸴ p ⸴ 255⦆ ·
    p ← x86_emit_byte⦅buf ⸴ p ⸴ 255⦆ ·
    p ← x86_emit_byte⦅buf ⸴ p ⸴ 255⦆ ·

    // call [rip + disp_GetStdHandle]
    // GetStdHandle IAT is at 0x3058
    // next instruction RVA = 0x1000 + (p - 512) + 6
    int64 cur_rva_1 ↦ (p ⊖ 512) ⊕ 4102 ·
    int64 base_gsh ↦ 12376 ·
    int64 disp_gsh ↦ base_gsh ⊖ cur_rva_1 ·
    p ← x86_emit_byte⦅buf ⸴ p ⸴ 255⦆ ·
    p ← x86_emit_byte⦅buf ⸴ p ⸴ 21⦆ ·
    p ← x86_emit_u32⦅buf ⸴ p ⸴ disp_gsh⦆ ·

    // mov rcx, rax (0x48 0x89 0xC1)
    p ← x86_emit_byte⦅buf ⸴ p ⸴ 72⦆ ·
    p ← x86_emit_byte⦅buf ⸴ p ⸴ 137⦆ ·
    p ← x86_emit_byte⦅buf ⸴ p ⸴ 193⦆ ·

    // lea rdx, [rip + disp_msg]
    // msg is at RVA 0x2000 (8192)
    // next instruction RVA = 0x1000 + (p - 512) + 7
    int64 cur_rva_2 ↦ (p ⊖ 512) ⊕ 4103 ·
    int64 base_msg ↦ 8192 ·
    int64 disp_msg ↦ base_msg ⊖ cur_rva_2 ·
    p ← x86_emit_byte⦅buf ⸴ p ⸴ 72⦆ ·
    p ← x86_emit_byte⦅buf ⸴ p ⸴ 141⦆ ·
    p ← x86_emit_byte⦅buf ⸴ p ⸴ 21⦆ ·
    p ← x86_emit_u32⦅buf ⸴ p ⸴ disp_msg⦆ ·

    // mov r8d, msg_len (0x41 0xB8 len)
    p ← x86_emit_byte⦅buf ⸴ p ⸴ 65⦆ ·
    p ← x86_emit_byte⦅buf ⸴ p ⸴ 184⦆ ·
    p ← x86_emit_u32⦅buf ⸴ p ⸴ msg_len⦆ ·

    // lea r9, [rsp + 48] (0x4C 0x8D 0x4C 0x24 0x30)
    p ← x86_emit_byte⦅buf ⸴ p ⸴ 76⦆ ·
    p ← x86_emit_byte⦅buf ⸴ p ⸴ 141⦆ ·
    p ← x86_emit_byte⦅buf ⸴ p ⸴ 76⦆ ·
    p ← x86_emit_byte⦅buf ⸴ p ⸴ 36⦆ ·
    p ← x86_emit_byte⦅buf ⸴ p ⸴ 48⦆ ·

    // mov qword ptr [rsp + 32], 0 (0x48 0xC7 0x44 0x24 0x20 0x00 0x00 0x00 0x00)
    p ← x86_emit_byte⦅buf ⸴ p ⸴ 72⦆ ·
    p ← x86_emit_byte⦅buf ⸴ p ⸴ 199⦆ ·
    p ← x86_emit_byte⦅buf ⸴ p ⸴ 68⦆ ·
    p ← x86_emit_byte⦅buf ⸴ p ⸴ 36⦆ ·
    p ← x86_emit_byte⦅buf ⸴ p ⸴ 32⦆ ·
    p ← x86_emit_byte⦅buf ⸴ p ⸴ 0⦆ ·
    p ← x86_emit_byte⦅buf ⸴ p ⸴ 0⦆ ·
    p ← x86_emit_byte⦅buf ⸴ p ⸴ 0⦆ ·
    p ← x86_emit_byte⦅buf ⸴ p ⸴ 0⦆ ·

    // call [rip + disp_WriteFile]
    // WriteFile IAT is at 0x3060 (12384)
    // next instruction RVA = 0x1000 + (p - 512) + 6
    int64 cur_rva_3 ↦ (p ⊖ 512) ⊕ 4102 ·
    int64 base_wf ↦ 12384 ·
    int64 disp_wf ↦ base_wf ⊖ cur_rva_3 ·
    p ← x86_emit_byte⦅buf ⸴ p ⸴ 255⦆ ·
    p ← x86_emit_byte⦅buf ⸴ p ⸴ 21⦆ ·
    p ← x86_emit_u32⦅buf ⸴ p ⸴ disp_wf⦆ ·

    // xor ecx, ecx (0x31 0xC9)
    p ← x86_emit_byte⦅buf ⸴ p ⸴ 49⦆ ·
    p ← x86_emit_byte⦅buf ⸴ p ⸴ 201⦆ ·

    // call [rip + disp_ExitProcess]
    // ExitProcess IAT is at 0x3050 (12368)
    // next instruction RVA = 0x1000 + (p - 512) + 6
    int64 cur_rva_4 ↦ (p ⊖ 512) ⊕ 4102 ·
    int64 base_ep ↦ 12368 ·
    int64 disp_ep ↦ base_ep ⊖ cur_rva_4 ·
    p ← x86_emit_byte⦅buf ⸴ p ⸴ 255⦆ ·
    p ← x86_emit_byte⦅buf ⸴ p ⸴ 21⦆ ·
    p ← x86_emit_u32⦅buf ⸴ p ⸴ disp_ep⦆ ·

    // Write file to out_path_ptr
    int64 fd ↦ qadav_file_open_write⦅out_path_ptr⦆ ·
    when fd ≻ 0 ⟦
        qadav_file_write⦅fd ⸴ buf ⸴ 4096⦆ ·
        qadav_file_close⦅fd⦆ ·
    ⟧

    qadav_free⦅buf⦆ ·
    yield 0 ·
⟧
