    int64 p9 ↦ out_buf ⊕ p · rt_sb⦅p9 ⸴ 51⦆ · p ← p ⊕ 1 ·  // 3
    int64 p10 ↦ out_buf ⊕ p · rt_sb⦅p10 ⸴ 46⦆ · p ← p ⊕ 1 · // .
    int64 p11 ↦ out_buf ⊕ p · rt_sb⦅p11 ⸴ 48⦆ · p ← p ⊕ 1 · // 0
    int64 p12 ↦ out_buf ⊕ p · rt_sb⦅p12 ⸴ 59⦆ · p ← p ⊕ 1 · // ;
    int64 p13 ↦ out_buf ⊕ p · rt_sb⦅p13 ⸴ 10⦆ · p ← p ⊕ 1 · // \n
    
    // "include \"stdgates.inc\";\n"
    int64 p14 ↦ out_buf ⊕ p · rt_sb⦅p14 ⸴ 105⦆ · p ← p ⊕ 1 · // i
    int64 p15 ↦ out_buf ⊕ p · rt_sb⦅p15 ⸴ 110⦆ · p ← p ⊕ 1 · // n
    int64 p16 ↦ out_buf ⊕ p · rt_sb⦅p16 ⸴ 99⦆ · p ← p ⊕ 1 ·  // c
    int64 p17 ↦ out_buf ⊕ p · rt_sb⦅p17 ⸴ 108⦆ · p ← p ⊕ 1 · // l
    int64 p18 ↦ out_buf ⊕ p · rt_sb⦅p18 ⸴ 117⦆ · p ← p ⊕ 1 · // u
    int64 p19 ↦ out_buf ⊕ p · rt_sb⦅p19 ⸴ 100⦆ · p ← p ⊕ 1 · // d
