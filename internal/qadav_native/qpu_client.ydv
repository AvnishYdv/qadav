    int64 p21 ↦ out_buf ⊕ p · rt_sb⦅p21 ⸴ 32⦆ · p ← p ⊕ 1 ·  // ' '
    int64 p22 ↦ out_buf ⊕ p · rt_sb⦅p22 ⸴ 34⦆ · p ← p ⊕ 1 ·  // "
    int64 p23 ↦ out_buf ⊕ p · rt_sb⦅p23 ⸴ 115⦆ · p ← p ⊕ 1 · // s
