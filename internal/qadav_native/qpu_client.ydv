    int64 p6 ↦ out_buf ⊕ p · rt_sb⦅p6 ⸴ 114⦆ · p ← p ⊕ 1 · // r
    int64 p7 ↦ out_buf ⊕ p · rt_sb⦅p7 ⸴ 97⦆ · p ← p ⊕ 1 ·  // a
    int64 p8 ↦ out_buf ⊕ p · rt_sb⦅p8 ⸴ 109⦆ · p ← p ⊕ 1 · // m
    int64 p9 ↦ out_buf ⊕ p · rt_sb⦅p9 ⸴ 95⦆ · p ← p ⊕ 1 ·  // _
    int64 p10 ↦ out_buf ⊕ p · rt_sb⦅p10 ⸴ 105⦆ · p ← p ⊕ 1 · // i
    int64 p11 ↦ out_buf ⊕ p · rt_sb⦅p11 ⸴ 100⦆ · p ← p ⊕ 1 · // d
    int64 p12 ↦ out_buf ⊕ p · rt_sb⦅p12 ⸴ 34⦆ · p ← p ⊕ 1 ·  // "
    int64 p13 ↦ out_buf ⊕ p · rt_sb⦅p13 ⸴ 58⦆ · p ← p ⊕ 1 ·  // :
    int64 p14 ↦ out_buf ⊕ p · rt_sb⦅p14 ⸴ 34⦆ · p ← p ⊕ 1 ·  // "
    int64 p15 ↦ out_buf ⊕ p · rt_sb⦅p15 ⸴ 115⦆ · p ← p ⊕ 1 · // s
    int64 p16 ↦ out_buf ⊕ p · rt_sb⦅p16 ⸴ 97⦆ · p ← p ⊕ 1 ·  // a
    int64 p17 ↦ out_buf ⊕ p · rt_sb⦅p17 ⸴ 109⦆ · p ← p ⊕ 1 · // m
    int64 p18 ↦ out_buf ⊕ p · rt_sb⦅p18 ⸴ 112⦆ · p ← p ⊕ 1 · // p
    int64 p19 ↦ out_buf ⊕ p · rt_sb⦅p19 ⸴ 108⦆ · p ← p ⊕ 1 · // l
    int64 p20 ↦ out_buf ⊕ p · rt_sb⦅p20 ⸴ 101⦆ · p ← p ⊕ 1 · // e
    int64 p21 ↦ out_buf ⊕ p · rt_sb⦅p21 ⸴ 114⦆ · p ← p ⊕ 1 · // r
    int64 p22 ↦ out_buf ⊕ p · rt_sb⦅p22 ⸴ 34⦆ · p ← p ⊕ 1 ·  // "
    int64 p23 ↦ out_buf ⊕ p · rt_sb⦅p23 ⸴ 44⦆ · p ← p ⊕ 1 ·  // ,
