    int64 p60 ↦ out_buf ⊕ p · rt_sb⦅p60 ⸴ 10⦆ · p ← p ⊕ 1 ·  // \n
    
    // "cx q[0], q[1];\n"
    int64 p61 ↦ out_buf ⊕ p · rt_sb⦅p61 ⸴ 99⦆ · p ← p ⊕ 1 ·  // c
    int64 p62 ↦ out_buf ⊕ p · rt_sb⦅p62 ⸴ 120⦆ · p ← p ⊕ 1 · // x
    int64 p63 ↦ out_buf ⊕ p · rt_sb⦅p63 ⸴ 32⦆ · p ← p ⊕ 1 ·  // ' '
