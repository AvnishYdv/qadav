    int64 p37 ↦ out_buf ⊕ p · rt_sb⦅p37 ⸴ 10⦆ · p ← p ⊕ 1 ·  // \n
    
    // "qubit[1000] q;\n"
    int64 p38 ↦ out_buf ⊕ p · rt_sb⦅p38 ⸴ 113⦆ · p ← p ⊕ 1 · // q
    int64 p39 ↦ out_buf ⊕ p · rt_sb⦅p39 ⸴ 117⦆ · p ← p ⊕ 1 · // u
    int64 p40 ↦ out_buf ⊕ p · rt_sb⦅p40 ⸴ 98⦆ · p ← p ⊕ 1 ·  // b
