⟧

process mctp_merkle_parent⦅int64 left_ptr ⸴ int64 right_ptr ⸴ int64 out32_ptr⦆ → int64 ⟦
    int64 sixty_four ↦ 64 ·
    int64 thirty_two ↦ 32 ·
    int64 buf ↦ qadav_alloc⦅sixty_four⦆ ·
    mctp_memcpy⦅buf ⸴ left_ptr ⸴ thirty_two⦆ ·
    int64 buf_right ↦ buf ⊕ thirty_two ·
    mctp_memcpy⦅buf_right ⸴ right_ptr ⸴ thirty_two⦆ ·
    qadav_sha3_256⦅buf ⸴ sixty_four ⸴ out32_ptr⦆ ·
    qadav_free⦅buf⦆ ·
    yield 1 ·
⟧

process mctp_merkle_root⦅int64 leaf_hashes_ptr ⸴ int64 count ⸴ int64 root_out_ptr⦆ → int64 ⟦
    when count ≼ 0 ⟦
        yield 0 ·
    ⟧
    int64 thirty_two ↦ 32 ·
    when count ≡ 1 ⟦
        mctp_memcpy⦅root_out_ptr ⸴ leaf_hashes_ptr ⸴ thirty_two⦆ ·
        yield 1 ·
    ⟧
    int64 cur_count ↦ count ·
    int64 cur_level ↦ leaf_hashes_ptr ·
    int64 one ↦ 1 ·
    int64 two ↦ 2 ·
    cycle cur_count ≻ one ⟦
        int64 num ↦ cur_count ⊕ one ·
        int64 next_count ↦ num ⊘ two ·
        int64 next_bytes ↦ next_count ⊗ thirty_two ·
        int64 next_level ↦ qadav_alloc⦅next_bytes⦆ ·
        int64 i ↦ 0 ·
        cycle i ≺ next_count ⟦
            int64 left_idx ↦ i ⊗ two ·
            int64 right_cand ↦ left_idx ⊕ one ·
            int64 right_idx ↦ left_idx ·
            when right_cand ≺ cur_count ⟦
                right_idx ← right_cand ·
            ⟧
            int64 left_off ↦ left_idx ⊗ thirty_two ·
            int64 left_ptr ↦ cur_level ⊕ left_off ·
            int64 right_off ↦ right_idx ⊗ thirty_two ·
            int64 right_ptr ↦ cur_level ⊕ right_off ·
            int64 out_off ↦ i ⊗ thirty_two ·
            int64 out_pos ↦ next_level ⊕ out_off ·
            mctp_merkle_parent⦅left_ptr ⸴ right_ptr ⸴ out_pos⦆ ·
            i ← i ⊕ one ·
        ⟧
        when cur_level ≻ leaf_hashes_ptr ⟦
            qadav_free⦅cur_level⦆ ·
        ⟧
        cur_level ← next_level ·
        cur_count ← next_count ·
    ⟧
    mctp_memcpy⦅root_out_ptr ⸴ cur_level ⸴ thirty_two⦆ ·
    when cur_level ≻ leaf_hashes_ptr ⟦
        qadav_free⦅cur_level⦆ ·
    ⟧
    yield 1 ·
⟧

process mctp_wots_chain_steps⦅int64 byte_val⦆ → int64 ⟦
    int64 mask ↦ 255 ·
    int64 b ↦ byte_val ·
    when b ≺ 0 ⟦
        b ← 0 ·
    ⟧
    when b ≻ mask ⟦
        b ← mask ·
    ⟧
    int64 steps ↦ mask ⊖ b ·
    yield steps ·
⟧

process mctp_init⦅int64 max_epochs⦆ → int64 ⟦
    int64 cert_size ↦ 2280 ·
    int64 c ↦ qadav_alloc⦅cert_size⦆ ·
    when c ≡ 0 ⟦
        yield 0 ·
    ⟧
    mctp_zero⦅c ⸴ cert_size⦆ ·
    int64 cap ↦ max_epochs ·
    when cap ≼ 0 ⟦
        cap ← 10000 ·
    ⟧
    int64 leaf_size ↦ 112 ·
    int64 leaves_bytes ↦ cap ⊗ leaf_size ·
    int64 leaves ↦ qadav_alloc⦅leaves_bytes⦆ ·
    mctp_zero⦅leaves ⸴ leaves_bytes⦆ ·
    int64 leaves_field ↦ c ⊕ 8 ·
    mctp_store⦅leaves_field ⸴ leaves⦆ ·
    int64 cap_field ↦ c ⊕ 4 ·
    mctp_set_i32⦅cap_field ⸴ cap⦆ ·
    yield c ·
⟧

process mctp_record_epoch_native⦅int64 c ⸴ int64 ep ⸴ int64 w_ptr ⸴ int64 ws ⸴ int64 d_ptr ⸴ int64 ds ⸴ int64 ls⦆ → int64 ⟦
