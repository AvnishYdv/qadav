// internal/qadav_native/mctp.ydv
// Qadav Native Model Certification & Training Provenance (MCTP, Invention #8, M4.2)
// Provides 108-byte leaf hashing, Merkle tree reduction with odd duplication, and provenance recording loops.

declare void @qadav_sha3_256(i64, i64, i64)
declare i32 @qadav_sha3_ct_compare(i64, i64, i64)
declare void @qadav_lamport_keygen(i64)
