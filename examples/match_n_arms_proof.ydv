variant Color ⟦
    | Red(v ↦ int64) ·
    | Green(v ↦ int64) ·
    | Blue(v ↦ int64) ·
    | Yellow(v ↦ int64) ·
⟧

process name⦅Color c⦆ → int64 ⟦
    match c ⟦
        | Red(v) ⟹ yield 100 ·
        | Green(v) ⟹ yield 200 ·
        | Blue(v) ⟹ yield 300 ·
        | Yellow(v) ⟹ yield 400 ·
    ⟧
⟧

process main⦅⦆ → int64 ⟦
    Color c ↦ variant_init Color ⦅Blue ↦ 0⦆ ·
    int64 n ↦ name⦅c⦆ ·
    emit n ·
    yield 0 ·
⟧
