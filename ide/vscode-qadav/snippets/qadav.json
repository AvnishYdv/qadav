{
  "Process Definition": {
    "prefix": "proc",
    "body": [
      "process ${1:process_name}⦅${2:int64 param}⦆ → ${3:int64} ⟦",
      "    ${0:// process body}",
      "    yield ${4:0} ·",
      "⟧"
    ],
    "description": "Define a Qadav process"
  },
  "QNMF Binding": {
    "prefix": "qnmf-bind",
    "body": [
      "int64 ${1:bound} ↦ ${2:entity_a} ⊗ ${3:rel} ·",
      "${1:bound} ← ${1:bound} ⊗ ${4:entity_b} ·"
    ],
    "description": "QNMF bilateral relational knowledge binding"
  },
  "QNMF Query": {
    "prefix": "qnmf-query",
    "body": [
      "int64 ${1:query_key} ↦ ${2:entity_b} ⊗ ${3:rel} ·",
      "int64 ${4:retrieved} ↦ ${5:bound_state} ⊘ ${1:query_key} ·"
    ],
    "description": "QNMF bilateral query (zero reverse training)"
  },
  "ECRA Risk Abstention Gate": {
    "prefix": "ecra-gate",
    "body": [
      "when ${1:confidence} ≺ ${2:85} ⟦",
      "    yield 100 · // Calibrated risk abstention",
      "⟧"
    ],
    "description": "ECRA epistemic calibrated risk abstention check"
  },
  "Vishwanath Invariant Guard": {
    "prefix": "vishwanath-guard",
    "body": [
      "when ${1:consistency} ≺ 850 ⟦",
      "    yield 101 · // Contradiction rollback",
      "⟧",
      "when ${2:entropy} ≻ 900 ⟦",
      "    yield 102 · // Thermal damping clamp",
      "⟧"
    ],
    "description": "Vishwanath multi-constraint invariant guard"
  },
  "Cycle Loop": {
    "prefix": "cycle",
    "body": [
      "int64 ${1:i} ↦ 0 ·",
      "cycle ${1:i} ≺ ${2:count} ⟦",
      "    ${0:// loop body}",
      "    ${1:i} ← ${1:i} ⊕ 1 ·",
      "⟧"
    ],
    "description": "Bounded deterministic cycle loop"
  },
  "When Guard": {
    "prefix": "when",
    "body": [
      "when ${1:condition} ⟦",
      "    ${0:// branch body}",
      "⟧"
    ],
    "description": "Conditional when block"
  }
}
