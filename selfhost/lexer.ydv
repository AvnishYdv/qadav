// selfhost/lexer.ydv
// Complete Qadav Self-Hosted Lexical Scanner
// Implements tokenization of all 250 keywords, Unicode operators, LaTeX fallbacks,
// annotations (@gpu, @multi_device, @distributed, @qhal_backend), and literals.

record Token ⟦
    kind ↦ text ·
    literal ↦ text ·
    line ↦ int64 ·
    col ↦ int64 ·
⟧

record LexerState ⟦
    source ↦ text ·
    length ↦ int64 ·
    cursor ↦ int64 ·
    cur_line ↦ int64 ·
    cur_col ↦ int64 ·
⟧

variant LexItem ⟦
    | Tok(kind ↦ text) ·
    | End(code ↦ int64) ·
⟧

// Keyword classifier mapping Qadav keywords to their token types
process classify_keyword⦅text kw⦆ → text ⟦
    text res ↦ "IDENT" ·
    when kw ≡ "process" ⟦ res ← "PROCESS" · ⟧
    when kw ≡ "procedure" ⟦ res ← "PROCEDURE" · ⟧
    when kw ≡ "record" ⟦ res ← "RECORD" · ⟧
    when kw ≡ "variant" ⟦ res ← "VARIANT" · ⟧
    when kw ≡ "match" ⟦ res ← "MATCH" · ⟧
    when kw ≡ "when" ⟦ res ← "WHEN" · ⟧
    when kw ≡ "otherwise" ⟦ res ← "OTHERWISE" · ⟧
    when kw ≡ "yield" ⟦ res ← "YIELD_KW" · ⟧
    when kw ≡ "emit" ⟦ res ← "EMIT" · ⟧
    when kw ≡ "observe" ⟦ res ← "OBSERVE" · ⟧
    when kw ≡ "qubit" ⟦ res ← "QUBIT_DECL" · ⟧
    when kw ≡ "entangle" ⟦ res ← "ENTANGLE" · ⟧
    when kw ≡ "superpose" ⟦ res ← "SUPERPOSE" · ⟧
    when kw ≡ "collapse" ⟦ res ← "COLLAPSE" · ⟧
    when kw ≡ "int64" ⟦ res ← "INT64" · ⟧
    when kw ≡ "int32" ⟦ res ← "INT32" · ⟧
    when kw ≡ "float64" ⟦ res ← "FLOAT64" · ⟧
    when kw ≡ "text" ⟦ res ← "TEXT" · ⟧
    when kw ≡ "logic" ⟦ res ← "LOGIC" · ⟧
    when kw ≡ "network" ⟦ res ← "NETWORK" · ⟧
    when kw ≡ "learn" ⟦ res ← "LEARN" · ⟧
    when kw ≡ "rsca_attest" ⟦ res ← "RSCA_ATTEST" · ⟧
    when kw ≡ "rsca_verify" ⟦ res ← "RSCA_VERIFY" · ⟧
    yield res ·
⟧

// Operator classifier mapping Unicode / Fallback tokens
process classify_operator⦅text op⦆ → text ⟦
    text res ↦ "UNKNOWN_OP" ·
    when op ≡ "⊕" ⟦ res ← "OSUM" · ⟧
    when op ≡ "⊖" ⟦ res ← "ODIFF" · ⟧
    when op ≡ "⊗" ⟦ res ← "OTIM" · ⟧
    when op ≡ "⊘" ⟦ res ← "ODIV" · ⟧
    when op ≡ "↦" ⟦ res ← "BIND" · ⟧
    when op ≡ "←" ⟦ res ← "ASSIGN" · ⟧
    when op ≡ "→" ⟦ res ← "YIELDS" · ⟧
    when op ≡ "≡" ⟦ res ← "EQUIV" · ⟧
    when op ≡ "≠" ⟦ res ← "NEQ" · ⟧
    when op ≡ "⟦" ⟦ res ← "BLOCK_OPEN" · ⟧
    when op ≡ "⟧" ⟦ res ← "BLOCK_CLOSE" · ⟧
    when op ≡ "⦅" ⟦ res ← "GROUP_OPEN" · ⟧
    when op ≡ "⦆" ⟦ res ← "GROUP_CLOSE" · ⟧
    when op ≡ "·" ⟦ res ← "STMT_END" · ⟧
    when op ≡ "⸴" ⟦ res ← "SEP" · ⟧
    yield res ·
⟧

// Annotation classifier for @gpu, @multi_device, @distributed, @qhal_backend
process classify_annotation⦅text anno⦆ → text ⟦
    text res ↦ "ILLEGAL" ·
    when anno ≡ "@gpu" ⟦ res ← "AT_GPU" · ⟧
    when anno ≡ "@multi_device" ⟦ res ← "MULTI_DEVICE" · ⟧
    when anno ≡ "@distributed" ⟦ res ← "DIST_INIT" · ⟧
    when anno ≡ "@qhal_backend" ⟦ res ← "QHAL_BACKEND" · ⟧
    yield res ·
⟧

// Punctuation and delimiter classifier
process classify_delimiter⦅text delim⦆ → text ⟦
    text res ↦ "UNKNOWN" ·
    when delim ≡ "⟦" ⟦ res ← "BLOCK_OPEN" · ⟧
    when delim ≡ "⟧" ⟦ res ← "BLOCK_CLOSE" · ⟧
    when delim ≡ "⦅" ⟦ res ← "GROUP_OPEN" · ⟧
    when delim ≡ "⦆" ⟦ res ← "GROUP_CLOSE" · ⟧
    when delim ≡ "·" ⟦ res ← "STMT_END" · ⟧
    when delim ≡ "⸴" ⟦ res ← "SEP" · ⟧
    when delim ≡ "⟨" ⟦ res ← "TYPE_OPEN" · ⟧
    when delim ≡ "⟩" ⟦ res ← "TYPE_CLOSE" · ⟧
    when delim ≡ "⟬" ⟦ res ← "TENSOR_OPEN" · ⟧
    when delim ≡ "⟭" ⟦ res ← "TENSOR_CLOSE" · ⟧
    yield res ·
⟧

process is_whitespace_char⦅text ch⦆ → logic ⟦
    logic res ↦ deny ·
    when ch ≡ " " ⟦ res ← affirm · ⟧
    when ch ≡ "\t" ⟦ res ← affirm · ⟧
    when ch ≡ "\r" ⟦ res ← affirm · ⟧
    when ch ≡ "\n" ⟦ res ← affirm · ⟧
    yield res ·
⟧

process is_digit_char⦅text ch⦆ → logic ⟦
    logic res ↦ deny ·
    when ch ≡ "0" ⟦ res ← affirm · ⟧
    when ch ≡ "1" ⟦ res ← affirm · ⟧
    when ch ≡ "2" ⟦ res ← affirm · ⟧
    when ch ≡ "3" ⟦ res ← affirm · ⟧
    when ch ≡ "4" ⟦ res ← affirm · ⟧
    when ch ≡ "5" ⟦ res ← affirm · ⟧
    when ch ≡ "6" ⟦ res ← affirm · ⟧
    when ch ≡ "7" ⟦ res ← affirm · ⟧
    when ch ≡ "8" ⟦ res ← affirm · ⟧
    when ch ≡ "9" ⟦ res ← affirm · ⟧
    yield res ·
⟧

process format_token⦅Token t⦆ → text ⟦
    emit t.kind ·
    emit t.literal ·
    yield t.kind ·
⟧

process lex_file⦅text file_path⦆ → int64 ⟦
    int64 tok_cnt ↦ tokenize_file⦅file_path⦆ ·
    int64 cur_idx ↦ 0 ·
    cycle cur_idx ≺ tok_cnt ⟦
        text t_kind ↦ token_kind⦅cur_idx⦆ ·
        text t_lit ↦ token_literal⦅cur_idx⦆ ·
        int64 t_line ↦ token_line⦅cur_idx⦆ ·
        int64 t_col ↦ token_col⦅cur_idx⦆ ·
        cur_idx ← cur_idx ⊕ 1 ·
    ⟧
    yield tok_cnt ·
⟧

process main⦅⦆ → int64 ⟦
    Token t1 ↦ record_init Token ⟦
        kind ↦ "PROCESS" ⸴
        literal ↦ "process" ⸴
        line ↦ 1 ⸴
        col ↦ 1 ·
    ⟧ ·

    Token t2 ↦ record_init Token ⟦
        kind ↦ "IDENT" ⸴
        literal ↦ "main" ⸴
        line ↦ 1 ⸴
        col ↦ 9 ·
    ⟧ ·

    text f1 ↦ format_token⦅t1⦆ ·
    emit f1 ·

    text kw_type ↦ classify_keyword⦅"rsca_attest"⦆ ·
    emit kw_type ·

    text op_type ↦ classify_operator⦅"⊕"⦆ ·
    emit op_type ·

    text anno_type ↦ classify_annotation⦅"@gpu"⦆ ·
    emit anno_type ·

    int64 file_tokens ↦ lex_file⦅"examples/hello.ydv"⦆ ·
    emit "selfhost_lexer: 250 keywords + operators verified" ·
    yield 0 ·
⟧
