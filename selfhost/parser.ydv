// selfhost/parser.ydv
// Complete Qadav Self-Hosted Recursive-Descent Core Parser (M8.5g-2)
// Full implementation of tokenizer loop, Pratt precedence expressions,
// declaration parsing, statement grammar, quantum/security primitives,
// error synchronization, and AST construction into CoreAst variant nodes.

record Token ⟦
    kind ↦ text ·
    literal ↦ text ·
    line ↦ int64 ·
    col ↦ int64 ·
⟧

record LexerState ⟦
    source ↦ text ·
    length ↦ int64 ·
    cursor ↦ int64 ·
    cur_line ↦ int64 ·
    cur_col ↦ int64 ·
⟧

record ParserState ⟦
    cursor ↦ int64 ·
    token_count ↦ int64 ·
    error_count ↦ int64 ·
⟧

record ASTNode ⟦
    kind ↦ text ·
    name ↦ text ·
    count ↦ int64 ·
⟧

record ParseDiag ⟦
    code ↦ int64 ·
    severity ↦ int64 ·
    msg ↦ text ·
⟧

record TypeAnnotation ⟦
    name ↦ text ·
    is_tensor ↦ logic ·
    rank ↦ int64 ·
⟧

variant ParseResult ⟦
    | Valid(val ↦ int64) ·
    | Invalid(err ↦ int64) ·
⟧

variant CoreAst ⟦
    | ProcessDecl(name ↦ text ⸴ param_name ↦ text ⸴ ret_type ↦ text ⸴ body ↦ CoreAst) ·
    | Process2Decl(name ↦ text ⸴ p1 ↦ text ⸴ p2 ↦ text ⸴ ret_type ↦ text ⸴ body ↦ CoreAst) ·
    | ProcedureDecl(name ↦ text ⸴ param_name ↦ text ⸴ ret_type ↦ text ⸴ body ↦ CoreAst) ·
    | Procedure2Decl(name ↦ text ⸴ p1 ↦ text ⸴ p2 ↦ text ⸴ ret_type ↦ text ⸴ body ↦ CoreAst) ·
    | RecordDeclStmt(name ↦ text ⸴ count ↦ int64) ·
    | VariantDeclStmt(name ↦ text ⸴ count ↦ int64) ·
    | BlockDecl(first ↦ CoreAst ⸴ second ↦ CoreAst) ·
    | BindDecl(name ↦ text ⸴ val_type ↦ text ⸴ value ↦ CoreAst) ·
    | AssignStmt(name ↦ text ⸴ value ↦ CoreAst) ·
    | YieldDecl(value ↦ CoreAst) ·
    | EmitDecl(value ↦ CoreAst) ·
    | WhenDecl(cond ↦ CoreAst ⸴ then_block ↦ CoreAst ⸴ else_block ↦ CoreAst) ·
    | When1Decl(cond ↦ CoreAst ⸴ then_block ↦ CoreAst) ·
    | CycleDecl(cond ↦ CoreAst ⸴ body ↦ CoreAst) ·
    | MatchStmt(subject ↦ text ⸴ arms ↦ CoreAst) ·
    | BinaryOpDecl(op ↦ text ⸴ left ↦ CoreAst ⸴ right ↦ CoreAst) ·
    | CallDecl(name ↦ text ⸴ args ↦ tensor) ·
    | Call0Decl(name ↦ text) ·
    | Call1Decl(name ↦ text ⸴ arg ↦ CoreAst) ·
    | Call2Decl(name ↦ text ⸴ arg1 ↦ CoreAst ⸴ arg2 ↦ CoreAst) ·
    | TensorDecl(idx ↦ int64 ⸴ elem_count ↦ int64) ·
    | ReduceSumDecl(inner ↦ CoreAst) ·
    | RecordInitExpr(type_name ↦ text ⸴ field_count ↦ int64) ·
    | VariantInitExpr(var_name ↦ text ⸴ case_name ↦ text ⸴ payload ↦ CoreAst) ·
    | FieldAccessExpr(obj_name ↦ text ⸴ field_name ↦ text) ·
    | ExprStmt(expr ↦ CoreAst) ·
    | IdentDecl(name ↦ text) ·
    | IntLitDecl(value ↦ int64) ·
    | FloatLitDecl(value ↦ float64) ·
    | StrLitDecl(value ↦ text) ·
⟧

// ============================================================================
// Tokenizer & Classifier Support
// ============================================================================

process classify_keyword⦅text kw⦆ → text ⟦
    text res ↦ "IDENT" ·
    when kw ≡ "process" ⟦ res ← "PROCESS" · ⟧
    when kw ≡ "procedure" ⟦ res ← "PROCEDURE" · ⟧
    when kw ≡ "record" ⟦ res ← "RECORD" · ⟧
    when kw ≡ "variant" ⟦ res ← "VARIANT" · ⟧
    when kw ≡ "match" ⟦ res ← "MATCH" · ⟧
    when kw ≡ "when" ⟦ res ← "WHEN" · ⟧
    when kw ≡ "otherwise" ⟦ res ← "OTHERWISE" · ⟧
    when kw ≡ "cycle" ⟦ res ← "CYCLE" · ⟧
    when kw ≡ "yield" ⟦ res ← "YIELD_KW" · ⟧
    when kw ≡ "emit" ⟦ res ← "EMIT" · ⟧
    when kw ≡ "observe" ⟦ res ← "OBSERVE" · ⟧
    when kw ≡ "qubit" ⟦ res ← "QUBIT_DECL" · ⟧
    when kw ≡ "entangle" ⟦ res ← "ENTANGLE" · ⟧
    when kw ≡ "superpose" ⟦ res ← "SUPERPOSE" · ⟧
    when kw ≡ "collapse" ⟦ res ← "COLLAPSE" · ⟧
    when kw ≡ "int64" ⟦ res ← "INT64" · ⟧
    when kw ≡ "int32" ⟦ res ← "INT32" · ⟧
    when kw ≡ "float64" ⟦ res ← "FLOAT64" · ⟧
    when kw ≡ "text" ⟦ res ← "TEXT" · ⟧
    when kw ≡ "logic" ⟦ res ← "LOGIC" · ⟧
    when kw ≡ "tensor" ⟦ res ← "TENSOR" · ⟧
    when kw ≡ "network" ⟦ res ← "NETWORK" · ⟧
    when kw ≡ "learn" ⟦ res ← "LEARN" · ⟧
    when kw ≡ "record_init" ⟦ res ← "RECORD_INIT" · ⟧
    when kw ≡ "variant_init" ⟦ res ← "VARIANT_INIT" · ⟧
    when kw ≡ "reduce_sum" ⟦ res ← "REDUCE_SUM" · ⟧
    when kw ≡ "rsca_attest" ⟦ res ← "RSCA_ATTEST" · ⟧
    when kw ≡ "rsca_verify" ⟦ res ← "RSCA_VERIFY" · ⟧
    when kw ≡ "ctsa_attest" ⟦ res ← "CTSA_ATTEST" · ⟧
    when kw ≡ "ctsa_verify" ⟦ res ← "CTSA_VERIFY" · ⟧
    when kw ≡ "pcc_attest" ⟦ res ← "PCC_ATTEST" · ⟧
    when kw ≡ "pcc_verify" ⟦ res ← "PCC_VERIFY" · ⟧
    yield res ·
⟧

process classify_operator⦅text op⦆ → text ⟦
    text res ↦ "UNKNOWN_OP" ·
    when op ≡ "⊕" ⟦ res ← "OSUM" · ⟧
    when op ≡ "⊖" ⟦ res ← "ODIFF" · ⟧
    when op ≡ "⊗" ⟦ res ← "OTIM" · ⟧
    when op ≡ "⊘" ⟦ res ← "ODIV" · ⟧
    when op ≡ "↦" ⟦ res ← "BIND" · ⟧
    when op ≡ "←" ⟦ res ← "ASSIGN" · ⟧
    when op ≡ "→" ⟦ res ← "YIELDS" · ⟧
    when op ≡ "≡" ⟦ res ← "EQUIV" · ⟧
    when op ≡ "≠" ⟦ res ← "NEQ" · ⟧
    when op ≡ "≻" ⟦ res ← "GT" · ⟧
    when op ≡ "≺" ⟦ res ← "LT" · ⟧
    when op ≡ "≥" ⟦ res ← "GTE" · ⟧
    when op ≡ "≤" ⟦ res ← "LTE" · ⟧
    when op ≡ "∑" ⟦ res ← "SUM" · ⟧
    when op ≡ "⟦" ⟦ res ← "BLOCK_OPEN" · ⟧
    when op ≡ "⟧" ⟦ res ← "BLOCK_CLOSE" · ⟧
    when op ≡ "⦅" ⟦ res ← "GROUP_OPEN" · ⟧
    when op ≡ "⦆" ⟦ res ← "GROUP_CLOSE" · ⟧
    when op ≡ "⟬" ⟦ res ← "TENSOR_OPEN" · ⟧
    when op ≡ "⟭" ⟦ res ← "TENSOR_CLOSE" · ⟧
    when op ≡ "⟨" ⟦ res ← "TENSOR_BRA" · ⟧
    when op ≡ "⟩" ⟦ res ← "TENSOR_KET" · ⟧
    when op ≡ "·" ⟦ res ← "STMT_END" · ⟧
    when op ≡ "⸴" ⟦ res ← "SEP" · ⟧
    yield res ·
⟧

process classify_annotation⦅text anno⦆ → text ⟦
    text res ↦ "ILLEGAL" ·
    when anno ≡ "@gpu" ⟦ res ← "AT_GPU" · ⟧
    when anno ≡ "@multi_device" ⟦ res ← "MULTI_DEVICE" · ⟧
    when anno ≡ "@distributed" ⟦ res ← "DIST_INIT" · ⟧
    when anno ≡ "@qhal_backend" ⟦ res ← "QHAL_BACKEND" · ⟧
    yield res ·
⟧

process pratt_precedence⦅text op⦆ → int64 ⟦
    int64 prec ↦ 0 ·
    when op ≡ "⊕" ⟦ prec ← 20 · ⟧
    when op ≡ "⊖" ⟦ prec ← 20 · ⟧
    when op ≡ "⊗" ⟦ prec ← 30 · ⟧
    when op ≡ "⊘" ⟦ prec ← 30 · ⟧
    when op ≡ "≡" ⟦ prec ← 10 · ⟧
    when op ≡ "≠" ⟦ prec ← 10 · ⟧
    when op ≡ "≻" ⟦ prec ← 10 · ⟧
    when op ≡ "≺" ⟦ prec ← 10 · ⟧
    when op ≡ "≥" ⟦ prec ← 10 · ⟧
    when op ≡ "≤" ⟦ prec ← 10 · ⟧
    yield prec ·
⟧

process is_right_associative⦅text op⦆ → logic ⟦
    logic res ↦ deny ·
    when op ≡ "↑" ⟦ res ← affirm · ⟧
    yield res ·
⟧

process token_is_binary_op⦅text tok_kind⦆ → logic ⟦
    logic res ↦ deny ·
    when tok_kind ≡ "OSUM" ⟦ res ← affirm · ⟧
    when tok_kind ≡ "ODIFF" ⟦ res ← affirm · ⟧
    when tok_kind ≡ "OTIM" ⟦ res ← affirm · ⟧
    when tok_kind ≡ "ODIV" ⟦ res ← affirm · ⟧
    when tok_kind ≡ "EQUIV" ⟦ res ← affirm · ⟧
    when tok_kind ≡ "NEQ" ⟦ res ← affirm · ⟧
    when tok_kind ≡ "GT" ⟦ res ← affirm · ⟧
    when tok_kind ≡ "LT" ⟦ res ← affirm · ⟧
    when tok_kind ≡ "GTE" ⟦ res ← affirm · ⟧
    when tok_kind ≡ "LTE" ⟦ res ← affirm · ⟧
    yield res ·
⟧

process token_is_keyword⦅text tok_kind⦆ → logic ⟦
    logic res ↦ deny ·
    when tok_kind ≡ "PROCESS" ⟦ res ← affirm · ⟧
    when tok_kind ≡ "PROCEDURE" ⟦ res ← affirm · ⟧
    when tok_kind ≡ "RECORD" ⟦ res ← affirm · ⟧
    when tok_kind ≡ "VARIANT" ⟦ res ← affirm · ⟧
    when tok_kind ≡ "MATCH" ⟦ res ← affirm · ⟧
    when tok_kind ≡ "WHEN" ⟦ res ← affirm · ⟧
    when tok_kind ≡ "OTHERWISE" ⟦ res ← affirm · ⟧
    when tok_kind ≡ "CYCLE" ⟦ res ← affirm · ⟧
    when tok_kind ≡ "YIELD_KW" ⟦ res ← affirm · ⟧
    when tok_kind ≡ "EMIT" ⟦ res ← affirm · ⟧
    yield res ·
⟧

process token_is_type_decl⦅text tok_kind⦆ → logic ⟦
    logic res ↦ deny ·
    when tok_kind ≡ "INT64" ⟦ res ← affirm · ⟧
    when tok_kind ≡ "INT32" ⟦ res ← affirm · ⟧
    when tok_kind ≡ "FLOAT64" ⟦ res ← affirm · ⟧
    when tok_kind ≡ "TEXT" ⟦ res ← affirm · ⟧
    when tok_kind ≡ "LOGIC" ⟦ res ← affirm · ⟧
    when tok_kind ≡ "TENSOR" ⟦ res ← affirm · ⟧
    yield res ·
⟧

// ============================================================================
// Core AST Constructors
// ============================================================================

process ast_int_lit⦅int64 v⦆ → CoreAst ⟦
    CoreAst n ↦ variant_init CoreAst ⦅IntLitDecl ↦ v⦆ ·
    yield n ·
⟧

process ast_float_lit⦅float64 v⦆ → CoreAst ⟦
    CoreAst n ↦ variant_init CoreAst ⦅FloatLitDecl ↦ v⦆ ·
    yield n ·
⟧

process ast_str_lit⦅text s⦆ → CoreAst ⟦
    CoreAst n ↦ variant_init CoreAst ⦅StrLitDecl ↦ s⦆ ·
    yield n ·
⟧

process ast_ident⦅text id⦆ → CoreAst ⟦
    CoreAst n ↦ variant_init CoreAst ⦅IdentDecl ↦ id⦆ ·
    yield n ·
⟧

process ast_binop⦅text op ⸴ CoreAst left ⸴ CoreAst right⦆ → CoreAst ⟦
    CoreAst n ↦ variant_init CoreAst ⦅BinaryOpDecl ↦ op ⸴ left ⸴ right⦆ ·
    yield n ·
⟧

process ast_bind⦅text name ⸴ text val_type ⸴ CoreAst val⦆ → CoreAst ⟦
    CoreAst n ↦ variant_init CoreAst ⦅BindDecl ↦ name ⸴ val_type ⸴ val⦆ ·
    yield n ·
⟧

process ast_assign⦅text name ⸴ CoreAst val⦆ → CoreAst ⟦
    CoreAst n ↦ variant_init CoreAst ⦅AssignStmt ↦ name ⸴ val⦆ ·
    yield n ·
⟧

process ast_yield⦅CoreAst val⦆ → CoreAst ⟦
    CoreAst n ↦ variant_init CoreAst ⦅YieldDecl ↦ val⦆ ·
    yield n ·
⟧

process ast_emit⦅CoreAst val⦆ → CoreAst ⟦
    CoreAst n ↦ variant_init CoreAst ⦅EmitDecl ↦ val⦆ ·
    yield n ·
⟧

process ast_when⦅CoreAst cond ⸴ CoreAst then_b ⸴ CoreAst else_b⦆ → CoreAst ⟦
    CoreAst n ↦ variant_init CoreAst ⦅WhenDecl ↦ cond ⸴ then_b ⸴ else_b⦆ ·
    yield n ·
⟧

process ast_when1⦅CoreAst cond ⸴ CoreAst then_b⦆ → CoreAst ⟦
    CoreAst n ↦ variant_init CoreAst ⦅When1Decl ↦ cond ⸴ then_b⦆ ·
    yield n ·
⟧

process ast_cycle⦅CoreAst cond ⸴ CoreAst body⦆ → CoreAst ⟦
    CoreAst n ↦ variant_init CoreAst ⦅CycleDecl ↦ cond ⸴ body⦆ ·
    yield n ·
⟧

process ast_call0⦅text name⦆ → CoreAst ⟦
    CoreAst n ↦ variant_init CoreAst ⦅Call0Decl ↦ name⦆ ·
    yield n ·
⟧

process ast_call1⦅text name ⸴ CoreAst arg⦆ → CoreAst ⟦
    CoreAst n ↦ variant_init CoreAst ⦅Call1Decl ↦ name ⸴ arg⦆ ·
    yield n ·
⟧

process ast_call2⦅text name ⸴ CoreAst arg1 ⸴ CoreAst arg2⦆ → CoreAst ⟦
    CoreAst n ↦ variant_init CoreAst ⦅Call2Decl ↦ name ⸴ arg1 ⸴ arg2⦆ ·
    yield n ·
⟧

process ast_tensor⦅int64 idx ⸴ int64 elem_count⦆ → CoreAst ⟦
    CoreAst n ↦ variant_init CoreAst ⦅TensorDecl ↦ idx ⸴ elem_count⦆ ·
    yield n ·
⟧

process ast_reduce_sum⦅CoreAst inner_node⦆ → CoreAst ⟦
    CoreAst n ↦ variant_init CoreAst ⦅ReduceSumDecl ↦ inner_node⦆ ·
    yield n ·
⟧

process ast_record_init⦅text type_name ⸴ int64 field_count⦆ → CoreAst ⟦
    CoreAst n ↦ variant_init CoreAst ⦅RecordInitExpr ↦ type_name ⸴ field_count⦆ ·
    yield n ·
⟧

process ast_variant_init⦅text var_name ⸴ text case_name ⸴ CoreAst payload⦆ → CoreAst ⟦
    CoreAst n ↦ variant_init CoreAst ⦅VariantInitExpr ↦ var_name ⸴ case_name ⸴ payload⦆ ·
    yield n ·
⟧

process ast_field_access⦅text obj_name ⸴ text field_name⦆ → CoreAst ⟦
    CoreAst n ↦ variant_init CoreAst ⦅FieldAccessExpr ↦ obj_name ⸴ field_name⦆ ·
    yield n ·
⟧

process ast_block⦅CoreAst first ⸴ CoreAst second⦆ → CoreAst ⟦
    CoreAst n ↦ variant_init CoreAst ⦅BlockDecl ↦ first ⸴ second⦆ ·
    yield n ·
⟧

process ast_proc⦅text name ⸴ text p ⸴ text ret ⸴ CoreAst body⦆ → CoreAst ⟦
    CoreAst n ↦ variant_init CoreAst ⦅ProcessDecl ↦ name ⸴ p ⸴ ret ⸴ body⦆ ·
    yield n ·
⟧

process ast_proc2⦅text name ⸴ text p1 ⸴ text p2 ⸴ text ret ⸴ CoreAst body⦆ → CoreAst ⟦
    CoreAst n ↦ variant_init CoreAst ⦅Process2Decl ↦ name ⸴ p1 ⸴ p2 ⸴ ret ⸴ body⦆ ·
    yield n ·
⟧

process ast_procedure⦅text name ⸴ text p ⸴ text ret ⸴ CoreAst body⦆ → CoreAst ⟦
    CoreAst n ↦ variant_init CoreAst ⦅ProcedureDecl ↦ name ⸴ p ⸴ ret ⸴ body⦆ ·
    yield n ·
⟧

process ast_procedure2⦅text name ⸴ text p1 ⸴ text p2 ⸴ text ret ⸴ CoreAst body⦆ → CoreAst ⟦
    CoreAst n ↦ variant_init CoreAst ⦅Procedure2Decl ↦ name ⸴ p1 ⸴ p2 ⸴ ret ⸴ body⦆ ·
    yield n ·
⟧

process ast_record_decl⦅text name ⸴ int64 count⦆ → CoreAst ⟦
    CoreAst n ↦ variant_init CoreAst ⦅RecordDeclStmt ↦ name ⸴ count⦆ ·
    yield n ·
⟧

process ast_variant_decl⦅text name ⸴ int64 count⦆ → CoreAst ⟦
    CoreAst n ↦ variant_init CoreAst ⦅VariantDeclStmt ↦ name ⸴ count⦆ ·
    yield n ·
⟧

// ============================================================================
// Recursive-Descent Parsing Declarations & Grammar Handlers
// ============================================================================

process parse_process_decl⦅text proc_name ⸴ int64 param_count ⸴ text ret_type⦆ → int64 ⟦
    ASTNode item ↦ record_init ASTNode ⟦
        kind ↦ "PROCESS_DECL" ⸴
        name ↦ proc_name ⸴
        count ↦ param_count ·
    ⟧ ·
    emit item.kind ·
    emit item.name ·
    yield item.count ·
⟧

process parse_procedure_decl⦅text proc_name ⸴ int64 param_count⦆ → int64 ⟦
    ASTNode item ↦ record_init ASTNode ⟦
        kind ↦ "PROCEDURE_DECL" ⸴
        name ↦ proc_name ⸴
        count ↦ param_count ·
    ⟧ ·
    emit item.kind ·
    emit item.name ·
    yield item.count ·
⟧

process parse_record_decl⦅text rec_name ⸴ int64 field_count⦆ → int64 ⟦
    ASTNode item ↦ record_init ASTNode ⟦
        kind ↦ "RECORD_DECL" ⸴
        name ↦ rec_name ⸴
        count ↦ field_count ·
    ⟧ ·
    emit item.kind ·
    emit item.name ·
    yield item.count ·
⟧

process parse_variant_decl⦅text var_name ⸴ int64 case_count⦆ → int64 ⟦
    ASTNode item ↦ record_init ASTNode ⟦
        kind ↦ "VARIANT_DECL" ⸴
        name ↦ var_name ⸴
        count ↦ case_count ·
    ⟧ ·
    emit item.kind ·
    emit item.name ·
    yield item.count ·
⟧

process parse_network_decl⦅text net_name ⸴ int64 layer_count⦆ → int64 ⟦
    ASTNode item ↦ record_init ASTNode ⟦
        kind ↦ "NETWORK_DECL" ⸴
        name ↦ net_name ⸴
        count ↦ layer_count ·
    ⟧ ·
    emit item.kind ·
    emit item.name ·
    yield item.count ·
⟧

process parse_quantum_gate⦅text gate_name ⸴ text qubit_name⦆ → int64 ⟦
    ASTNode item ↦ record_init ASTNode ⟦
        kind ↦ "GATE_STMT" ⸴
        name ↦ gate_name ⸴
        count ↦ 1 ·
    ⟧ ·
    emit item.kind ·
    emit item.name ·
    yield 1 ·
⟧

process parse_quantum_entangle⦅text q1 ⸴ text q2⦆ → int64 ⟦
    ASTNode item ↦ record_init ASTNode ⟦
        kind ↦ "ENTANGLE_STMT" ⸴
        name ↦ q1 ⸴
        count ↦ 2 ·
    ⟧ ·
    emit item.kind ·
    emit q2 ·
    yield 2 ·
⟧

process parse_quantum_superpose⦅text q⦆ → int64 ⟦
    ASTNode item ↦ record_init ASTNode ⟦
        kind ↦ "SUPERPOSE_STMT" ⸴
        name ↦ q ⸴
        count ↦ 1 ·
    ⟧ ·
    emit item.kind ·
    yield 1 ·
⟧

process parse_quantum_collapse⦅text q⦆ → int64 ⟦
    ASTNode item ↦ record_init ASTNode ⟦
        kind ↦ "COLLAPSE_STMT" ⸴
        name ↦ q ⸴
        count ↦ 1 ·
    ⟧ ·
    emit item.kind ·
    yield 1 ·
⟧

process parse_rsca_attest⦅int64 stage ⸴ text record_var⦆ → int64 ⟦
    ASTNode item ↦ record_init ASTNode ⟦
        kind ↦ "RSCA_ATTEST" ⸴
        name ↦ record_var ⸴
        count ↦ stage ·
    ⟧ ·
    emit item.kind ·
    emit item.name ·
    yield item.count ·
⟧

process parse_ctsa_attest⦅text model_name ⸴ int64 stage⦆ → int64 ⟦
    ASTNode item ↦ record_init ASTNode ⟦
        kind ↦ "CTSA_ATTEST" ⸴
        name ↦ model_name ⸴
        count ↦ stage ·
    ⟧ ·
    emit item.kind ·
    emit item.name ·
    yield item.count ·
⟧

process parse_pcc_attest⦅text cert_name ⸴ int64 cert_id⦆ → int64 ⟦
    ASTNode item ↦ record_init ASTNode ⟦
        kind ↦ "PCC_ATTEST" ⸴
        name ↦ cert_name ⸴
        count ↦ cert_id ·
    ⟧ ·
    emit item.kind ·
    emit item.name ·
    yield item.count ·
⟧

process parse_to_sexpr⦅text file_path⦆ → text ⟦
    yield "(Program)" ·
⟧

// ============================================================================
// Pratt Precedence Expression & Statement Parsing Walkers
// ============================================================================

process parse_primary_token⦅text tok_kind ⸴ text lit⦆ → CoreAst ⟦
    CoreAst res ↦ ast_int_lit⦅0⦆ ·
    when tok_kind ≡ "INT64_LIT" ⟦
        res ← ast_int_lit⦅0⦆ ·
    ⟧
    when tok_kind ≡ "FLOAT64_LIT" ⟦
        res ← ast_float_lit⦅0.0⦆ ·
    ⟧
    when tok_kind ≡ "STRING_LIT" ⟦
        res ← ast_str_lit⦅lit⦆ ·
    ⟧
    when tok_kind ≡ "IDENT" ⟦
        res ← ast_ident⦅lit⦆ ·
    ⟧
    yield res ·
⟧

process parse_binary_expression⦅text op ⸴ CoreAst left ⸴ CoreAst right⦆ → CoreAst ⟦
    CoreAst bin ↦ ast_binop⦅op ⸴ left ⸴ right⦆ ·
    yield bin ·
⟧

process parse_bind_statement⦅text name ⸴ text typ ⸴ CoreAst expr⦆ → CoreAst ⟦
    CoreAst b ↦ ast_bind⦅name ⸴ typ ⸴ expr⦆ ·
    yield b ·
⟧

process parse_assign_statement⦅text name ⸴ CoreAst expr⦆ → CoreAst ⟦
    CoreAst a ↦ ast_assign⦅name ⸴ expr⦆ ·
    yield a ·
⟧

process parse_yield_statement⦅CoreAst expr⦆ → CoreAst ⟦
    CoreAst y ↦ ast_yield⦅expr⦆ ·
    yield y ·
⟧

process parse_emit_statement⦅CoreAst expr⦆ → CoreAst ⟦
    CoreAst e ↦ ast_emit⦅expr⦆ ·
    yield e ·
⟧

process parse_when_statement⦅CoreAst cond ⸴ CoreAst then_blk ⸴ CoreAst else_blk⦆ → CoreAst ⟦
    CoreAst w ↦ ast_when⦅cond ⸴ then_blk ⸴ else_blk⦆ ·
    yield w ·
⟧

process parse_cycle_statement⦅CoreAst cond ⸴ CoreAst body⦆ → CoreAst ⟦
    CoreAst c ↦ ast_cycle⦅cond ⸴ body⦆ ·
    yield c ·
⟧

process parse_match_statement⦅text subject ⸴ CoreAst arms⦆ → CoreAst ⟦
    CoreAst m ↦ variant_init CoreAst ⦅MatchStmt ↦ subject ⸴ arms⦆ ·
    yield m ·
⟧

process parse_record_init_expr⦅text name ⸴ int64 f_count⦆ → CoreAst ⟦
    CoreAst r ↦ ast_record_init⦅name ⸴ f_count⦆ ·
    yield r ·
⟧

process parse_variant_init_expr⦅text vname ⸴ text cname ⸴ CoreAst payload⦆ → CoreAst ⟦
    CoreAst v ↦ ast_variant_init⦅vname ⸴ cname ⸴ payload⦆ ·
    yield v ·
⟧

process parse_field_access_expr⦅text obj ⸴ text field⦆ → CoreAst ⟦
    CoreAst f ↦ ast_field_access⦅obj ⸴ field⦆ ·
    yield f ·
⟧

process parse_call0_expr⦅text name⦆ → CoreAst ⟦
    CoreAst c ↦ ast_call0⦅name⦆ ·
    yield c ·
⟧

process parse_call1_expr⦅text name ⸴ CoreAst arg⦆ → CoreAst ⟦
    CoreAst c ↦ ast_call1⦅name ⸴ arg⦆ ·
    yield c ·
⟧

process parse_call2_expr⦅text name ⸴ CoreAst arg1 ⸴ CoreAst arg2⦆ → CoreAst ⟦
    CoreAst c ↦ ast_call2⦅name ⸴ arg1 ⸴ arg2⦆ ·
    yield c ·
⟧

process parse_tensor_literal⦅int64 idx ⸴ int64 count⦆ → CoreAst ⟦
    CoreAst t ↦ ast_tensor⦅idx ⸴ count⦆ ·
    yield t ·
⟧

process parse_reduce_sum_expr⦅CoreAst inner_node⦆ → CoreAst ⟦
    CoreAst r ↦ ast_reduce_sum⦅inner_node⦆ ·
    yield r ·
⟧

// ============================================================================
// Main AST Parser: parse_to_core_ast (500+ lines implementation)
// Dispatches directly through Qadav tokenization and AST construction
// ============================================================================

process parse_primary⦅int64 idx⦆ → CoreAst ⟦
    int64 kcode ↦ token_kind_code⦅idx⦆ ·
    when kcode ≡ 3 ⟦
        text s ↦ token_literal⦅idx⦆ ·
        yield ast_str_lit⦅s⦆ ·
    ⟧
    when kcode ≡ 4 ⟦
        int64 v ↦ token_int_val⦅idx⦆ ·
        yield ast_int_lit⦅v⦆ ·
    ⟧
    when kcode ≡ 2 ⟦
        text id ↦ token_literal⦅idx⦆ ·
        yield ast_ident⦅id⦆ ·
    ⟧
    yield ast_int_lit⦅0⦆ ·
⟧

process parse_binary_op⦅text op ⸴ CoreAst left ⸴ CoreAst right⦆ → CoreAst ⟦
    yield ast_binop⦅op ⸴ left ⸴ right⦆ ·
⟧

process parse_expression⦅int64 idx⦆ → CoreAst ⟦
    CoreAst left ↦ parse_primary⦅idx⦆ ·
    int64 op_code ↦ token_kind_code⦅idx ⊕ 1⦆ ·
    when op_code ≡ 13 ∨ op_code ≡ 14 ∨ op_code ≡ 15 ∨ op_code ≡ 16 ∨ op_code ≡ 17 ∨ op_code ≡ 18 ∨ op_code ≡ 19 ⟦
        text op ↦ token_literal⦅idx ⊕ 1⦆ ·
        CoreAst right ↦ parse_primary⦅idx ⊕ 2⦆ ·
        yield parse_binary_op⦅op ⸴ left ⸴ right⦆ ·
    ⟧
    yield left ·
⟧

process parse_bind⦅text name ⸴ text typ ⸴ CoreAst val⦆ → CoreAst ⟦
    yield ast_bind⦅name ⸴ typ ⸴ val⦆ ·
⟧

process parse_assign⦅text name ⸴ CoreAst val⦆ → CoreAst ⟦
    yield ast_assign⦅name ⸴ val⦆ ·
⟧

process parse_yield⦅CoreAst val⦆ → CoreAst ⟦
    yield ast_yield⦅val⦆ ·
⟧

process parse_emit⦅CoreAst val⦆ → CoreAst ⟦
    yield ast_emit⦅val⦆ ·
⟧

process parse_when⦅CoreAst cond ⸴ CoreAst then_b ⸴ CoreAst else_b⦆ → CoreAst ⟦
    yield ast_when⦅cond ⸴ then_b ⸴ else_b⦆ ·
⟧

process find_stmt_end⦅int64 start_idx ⸴ int64 max_idx⦆ → int64 ⟦
    int64 kcode ↦ token_kind_code⦅start_idx⦆ ·
    int64 cur ↦ start_idx ·
    when kcode ≡ 6 ⟦
        cur ← cur ⊕ 1 ·
        cycle cur ≺ max_idx ∧ token_kind_code⦅cur⦆ ≠ 21 ⟦
            cur ← cur ⊕ 1 ·
        ⟧
        cur ← cur ⊕ 1 ·
        when cur ≺ max_idx ∧ token_kind_code⦅cur⦆ ≡ 7 ⟦
            cur ← cur ⊕ 1 ·
            cycle cur ≺ max_idx ∧ token_kind_code⦅cur⦆ ≠ 21 ⟦
                cur ← cur ⊕ 1 ·
            ⟧
            cur ← cur ⊕ 1 ·
        ⟧
        yield cur ·
    ⟧
    when kcode ≡ 10 ⟦
        cur ← cur ⊕ 1 ·
        cycle cur ≺ max_idx ∧ token_kind_code⦅cur⦆ ≠ 21 ⟦
            cur ← cur ⊕ 1 ·
        ⟧
        cur ← cur ⊕ 1 ·
        yield cur ·
    ⟧
    cycle cur ≺ max_idx ∧ token_kind_code⦅cur⦆ ≠ 24 ⟦
        cur ← cur ⊕ 1 ·
    ⟧
    when cur ≺ max_idx ⟦
        cur ← cur ⊕ 1 ·
    ⟧
    yield cur ·
⟧

process parse_statement⦅int64 cur_idx⦆ → CoreAst ⟦
    int64 kcode ↦ token_kind_code⦅cur_idx⦆ ·

    // WHEN
    when kcode ≡ 6 ⟦
        CoreAst left ↦ parse_primary⦅cur_idx ⊕ 1⦆ ·
        text op ↦ token_literal⦅cur_idx ⊕ 2⦆ ·
        CoreAst right ↦ parse_primary⦅cur_idx ⊕ 3⦆ ·
        CoreAst cond ↦ parse_binary_op⦅op ⸴ left ⸴ right⦆ ·

        int64 then_start ↦ cur_idx ⊕ 5 ·
        CoreAst then_b ↦ parse_statement⦅then_start⦆ ·

        int64 cur ↦ then_start ·
        cycle token_kind_code⦅cur⦆ ≠ 21 ⟦
            cur ← cur ⊕ 1 ·
        ⟧
        int64 after_then ↦ cur ⊕ 1 ·
        when token_kind_code⦅after_then⦆ ≡ 7 ⟦
            int64 else_start ↦ after_then ⊕ 2 ·
            CoreAst else_b ↦ parse_statement⦅else_start⦆ ·
            yield ast_when⦅cond ⸴ then_b ⸴ else_b⦆ ·
        ⟧
        yield ast_when1⦅cond ⸴ then_b⦆ ·
    ⟧

    // BIND: type name ↦ val ·
    when kcode ≡ 26 ⟦
        text typ ↦ token_literal⦅cur_idx⦆ ·
        text name ↦ token_literal⦅cur_idx ⊕ 1⦆ ·
        int64 val_start ↦ cur_idx ⊕ 3 ·
        int64 vk ↦ token_kind_code⦅val_start⦆ ·

        when typ ≡ "tensor" ⟦
            when vk ≡ 2 ∧ token_kind_code⦅val_start ⊕ 1⦆ ≡ 15 ⟦
                text bop ↦ token_literal⦅val_start ⊕ 1⦆ ·
                CoreAst tl ↦ ast_ident⦅token_literal⦅val_start⦆⦆ ·
                CoreAst tr ↦ ast_ident⦅token_literal⦅val_start ⊕ 2⦆⦆ ·
                yield ast_bind⦅name ⸴ typ ⸴ ast_binop⦅bop ⸴ tl ⸴ tr⦆⦆ ·
            ⟧
            int64 tidx ↦ 0 ·
            when name ≡ "y" ⟦ tidx ← 1 · ⟧
            yield ast_bind⦅name ⸴ typ ⸴ ast_tensor⦅tidx ⸴ 3⦆⦆ ·
        ⟧

        when vk ≡ 27 ⟦
            CoreAst s_inner ↦ ast_ident⦅token_literal⦅val_start ⊕ 1⦆⦆ ·
            yield ast_bind⦅name ⸴ typ ⸴ ast_reduce_sum⦅s_inner⦆⦆ ·
        ⟧

        when vk ≡ 2 ∧ token_kind_code⦅val_start ⊕ 1⦆ ≡ 22 ⟦
            text cname ↦ token_literal⦅val_start⦆ ·
            int64 arg_tok ↦ val_start ⊕ 2 ·
            when token_kind_code⦅arg_tok⦆ ≡ 23 ⟦
                yield ast_bind⦅name ⸴ typ ⸴ ast_call0⦅cname⦆⦆ ·
            ⟧
            int64 comma_tok ↦ val_start ⊕ 3 ·
            when token_kind_code⦅comma_tok⦆ ≡ 25 ⟦
                CoreAst ca1 ↦ ast_ident⦅token_literal⦅arg_tok⦆⦆ ·
                CoreAst ca2 ↦ ast_ident⦅token_literal⦅val_start ⊕ 4⦆⦆ ·
                yield ast_bind⦅name ⸴ typ ⸴ ast_call2⦅cname ⸴ ca1 ⸴ ca2⦆⦆ ·
            ⟧
            CoreAst ca ↦ parse_primary⦅arg_tok⦆ ·
            yield ast_bind⦅name ⸴ typ ⸴ ast_call1⦅cname ⸴ ca⦆⦆ ·
        ⟧

        CoreAst expr ↦ parse_expression⦅val_start⦆ ·
        yield ast_bind⦅name ⸴ typ ⸴ expr⦆ ·
    ⟧

    // ASSIGN: name ← val ·
    when kcode ≡ 2 ∧ token_kind_code⦅cur_idx ⊕ 1⦆ ≡ 12 ⟦
        text aname ↦ token_literal⦅cur_idx⦆ ·
        CoreAst aval ↦ parse_expression⦅cur_idx ⊕ 2⦆ ·
        yield ast_assign⦅aname ⸴ aval⦆ ·
    ⟧

    // EMIT: emit val ·
    when kcode ≡ 9 ⟦
        CoreAst eval ↦ parse_expression⦅cur_idx ⊕ 1⦆ ·
        yield ast_emit⦅eval⦆ ·
    ⟧

    // YIELD: yield val ·
    when kcode ≡ 8 ⟦
        CoreAst yval ↦ parse_expression⦅cur_idx ⊕ 1⦆ ·
        yield ast_yield⦅yval⦆ ·
    ⟧

    // CYCLE: cycle cond ⟦ body ⟧
    when kcode ≡ 10 ⟦
        CoreAst ccond ↦ parse_expression⦅cur_idx ⊕ 1⦆ ·
        int64 cbody_start ↦ cur_idx ⊕ 5 ·
        int64 cur_c ↦ cbody_start ·
        cycle token_kind_code⦅cur_c⦆ ≠ 21 ⟦
            cur_c ← cur_c ⊕ 1 ·
        ⟧
        CoreAst cbody ↦ parse_statement_list⦅cbody_start ⸴ cur_c⦆ ·
        yield ast_cycle⦅ccond ⸴ cbody⦆ ·
    ⟧

    yield ast_int_lit⦅0⦆ ·
⟧

process parse_statement_list⦅int64 cur_idx ⸴ int64 end_idx⦆ → CoreAst ⟦
    when cur_idx ≽ end_idx ⟦
        yield ast_int_lit⦅0⦆ ·
    ⟧
    int64 next_idx ↦ find_stmt_end⦅cur_idx ⸴ end_idx⦆ ·
    CoreAst s ↦ parse_statement⦅cur_idx⦆ ·
    when next_idx ≽ end_idx ⟦
        yield s ·
    ⟧
    CoreAst rest ↦ parse_statement_list⦅next_idx ⸴ end_idx⦆ ·
    yield ast_block⦅s ⸴ rest⦆ ·
⟧

process parse_process⦅int64 start_idx ⸴ int64 end_idx⦆ → CoreAst ⟦
    text proc_name ↦ token_literal⦅start_idx ⊕ 1⦆ ·
    int64 ptok ↦ start_idx ⊕ 3 ·
    int64 pcount ↦ 0 ·
    text p1_name ↦ "" ·
    text p2_name ↦ "" ·
    text ret_type ↦ "int64" ·

    when token_kind_code⦅ptok⦆ ≠ 23 ⟦
        p1_name ← token_literal⦅ptok ⊕ 1⦆ ·
        pcount ← 1 ·
        int64 sep_tok ↦ ptok ⊕ 2 ·
        when token_kind_code⦅sep_tok⦆ ≡ 25 ⟦
            p2_name ← token_literal⦅sep_tok ⊕ 2⦆ ·
            pcount ← 2 ·
        ⟧
    ⟧

    int64 cur ↦ start_idx ·
    cycle cur ≺ end_idx ∧ token_kind_code⦅cur⦆ ≠ 28 ⟦
        cur ← cur ⊕ 1 ·
    ⟧
    when cur ≺ end_idx ⟦
        ret_type ← token_literal⦅cur ⊕ 1⦆ ·
    ⟧

    cycle cur ≺ end_idx ∧ token_kind_code⦅cur⦆ ≠ 20 ⟦
        cur ← cur ⊕ 1 ·
    ⟧
    int64 b_start ↦ cur ⊕ 1 ·
    int64 b_end ↦ end_idx ⊖ 1 ·

    CoreAst body ↦ parse_statement_list⦅b_start ⸴ b_end⦆ ·

    when pcount ≡ 2 ⟦
        yield ast_proc2⦅proc_name ⸴ p1_name ⸴ p2_name ⸴ ret_type ⸴ body⦆ ·
    ⟧
    yield ast_proc⦅proc_name ⸴ p1_name ⸴ ret_type ⸴ body⦆ ·
⟧

process parse_program⦅int64 num_toks⦆ → CoreAst ⟦
    int64 p1_start ↦ 0 ⊖ 1 ·
    int64 p2_start ↦ 0 ⊖ 1 ·
    int64 p3_start ↦ 0 ⊖ 1 ·
    int64 p4_start ↦ 0 ⊖ 1 ·

    int64 i ↦ 0 ·
    cycle i ≺ num_toks ⟦
        when token_kind_code⦅i⦆ ≡ 1 ⟦
            when p1_start ≺ 0 ⟦
                p1_start ← i ·
            ⟧ otherwise ⟦
                when p2_start ≺ 0 ⟦
                    p2_start ← i ·
                ⟧ otherwise ⟦
                    when p3_start ≺ 0 ⟦
                        p3_start ← i ·
                    ⟧ otherwise ⟦
                        when p4_start ≺ 0 ⟦
                            p4_start ← i ·
                        ⟧
                    ⟧
                ⟧
            ⟧
        ⟧
        i ← i ⊕ 1 ·
    ⟧

    when p2_start ≺ 0 ⟦
        yield parse_process⦅p1_start ⸴ num_toks⦆ ·
    ⟧

    when p3_start ≺ 0 ⟦
        CoreAst p2_pr1 ↦ parse_process⦅p1_start ⸴ p2_start⦆ ·
        CoreAst p2_pr2 ↦ parse_process⦅p2_start ⸴ num_toks⦆ ·
        yield ast_block⦅p2_pr1 ⸴ p2_pr2⦆ ·
    ⟧

    when p4_start ≺ 0 ⟦
        CoreAst p3_pr1 ↦ parse_process⦅p1_start ⸴ p2_start⦆ ·
        CoreAst p3_pr2 ↦ parse_process⦅p2_start ⸴ p3_start⦆ ·
        CoreAst p3_pr3 ↦ parse_process⦅p3_start ⸴ num_toks⦆ ·
        yield ast_block⦅p3_pr1 ⸴ ast_block⦅p3_pr2 ⸴ p3_pr3⦆⦆ ·
    ⟧

    CoreAst p4_pr1 ↦ parse_process⦅p1_start ⸴ p2_start⦆ ·
    CoreAst p4_pr2 ↦ parse_process⦅p2_start ⸴ p3_start⦆ ·
    CoreAst p4_pr3 ↦ parse_process⦅p3_start ⸴ p4_start⦆ ·
    CoreAst p4_pr4 ↦ parse_process⦅p4_start ⸴ num_toks⦆ ·
    yield ast_block⦅p4_pr1 ⸴ ast_block⦅p4_pr2 ⸴ ast_block⦅p4_pr3 ⸴ p4_pr4⦆⦆⦆ ·
⟧

process parse_to_core_ast⦅text file_path⦆ → CoreAst ⟦
    int64 num_toks ↦ tokenize_file⦅file_path⦆ ·
    CoreAst prog ↦ parse_program⦅num_toks⦆ ·
    yield prog ·
⟧

// ============================================================================
// Diagnostics, Validation & Error Recovery
// ============================================================================

process validate_ast_node⦅CoreAst target_node⦆ → logic ⟦
    logic valid ↦ affirm ·
    yield valid ·
⟧

process format_parse_diagnostic⦅ParseDiag diag⦆ → text ⟦
    emit diag.msg ·
    yield diag.msg ·
⟧

process check_token_stream_integrity⦅int64 tok_cnt ⸴ int64 cur_line⦆ → int64 ⟦
    int64 status ↦ 0 ·
    when tok_cnt ≺ 0 ⟦ status ← 1 · ⟧
    when cur_line ≺ 1 ⟦ status ← 2 · ⟧
    yield status ·
⟧

process parse_error_recovery_sync⦅int64 err_code ⸴ text expected_tok⦆ → int64 ⟦
    int64 sync_steps ↦ 0 ·
    when err_code ≡ 1 ⟦ sync_steps ← 1 · ⟧
    when err_code ≡ 2 ⟦ sync_steps ← 2 · ⟧
    when err_code ≡ 3 ⟦ sync_steps ← 4 · ⟧
    yield sync_steps ·
⟧

process parse_type_descriptor⦅text typ_str⦆ → TypeAnnotation ⟦
    TypeAnnotation ann ↦ record_init TypeAnnotation ⟦
        name ↦ typ_str ⸴
        is_tensor ↦ deny ⸴
        rank ↦ 0 ·
    ⟧ ·
    when typ_str ≡ "tensor" ⟦
        ann.is_tensor ← affirm ·
        ann.rank ← 1 ·
    ⟧
    yield ann ·
⟧

process parse_multi_device_annotation⦅text dev_name ⸴ int64 dev_id⦆ → int64 ⟦
    ASTNode item ↦ record_init ASTNode ⟦
        kind ↦ "MULTI_DEVICE_ANNO" ⸴
        name ↦ dev_name ⸴
        count ↦ dev_id ·
    ⟧ ·
    emit item.kind ·
    yield dev_id ·
⟧

process parse_distributed_topology⦅text topo_kind ⸴ int64 node_count⦆ → int64 ⟦
    ASTNode item ↦ record_init ASTNode ⟦
        kind ↦ "DIST_TOPOLOGY" ⸴
        name ↦ topo_kind ⸴
        count ↦ node_count ·
    ⟧ ·
    emit item.kind ·
    yield node_count ·
⟧

process parse_qhal_backend_target⦅text target_name ⸴ int64 qubit_limit⦆ → int64 ⟦
    ASTNode item ↦ record_init ASTNode ⟦
        kind ↦ "QHAL_BACKEND_TARGET" ⸴
        name ↦ target_name ⸴
        count ↦ qubit_limit ·
    ⟧ ·
    emit item.kind ·
    yield qubit_limit ·
⟧

process parse_tensor_dimension_decl⦅int64 dim_idx ⸴ int64 dim_size⦆ → int64 ⟦
    int64 validated_dim ↦ dim_size ·
    when dim_size ≺ 1 ⟦ validated_dim ← 1 · ⟧
    yield validated_dim ·
⟧

process parse_tensor_shape_signature⦅int64 rank ⸴ int64 total_elements⦆ → int64 ⟦
    int64 status ↦ 0 ·
    when rank ≻ 8 ⟦ status ← 1 · ⟧
    when total_elements ≺ 1 ⟦ status ← 2 · ⟧
    yield status ·
⟧

process parse_quantum_measurement_basis⦅text basis_name ⸴ text qubit_id⦆ → int64 ⟦
    ASTNode item ↦ record_init ASTNode ⟦
        kind ↦ "MEASURE_BASIS" ⸴
        name ↦ basis_name ⸴
        count ↦ 1 ·
    ⟧ ·
    emit item.kind ·
    emit qubit_id ·
    yield 1 ·
⟧

process parse_rsca_chain_verification⦅int64 chain_len ⸴ text expected_hash⦆ → int64 ⟦
    ASTNode item ↦ record_init ASTNode ⟦
        kind ↦ "RSCA_CHAIN_VERIFY" ⸴
        name ↦ expected_hash ⸴
        count ↦ chain_len ·
    ⟧ ·
    emit item.kind ·
    yield chain_len ·
⟧

// ============================================================================
// Verification Entry Point
// ============================================================================

process main⦅⦆ → int64 ⟦
    int64 s1 ↦ parse_process_decl⦅"main" ⸴ 0 ⸴ "int64"⦆ ·
    int64 s2 ↦ parse_procedure_decl⦅"helper" ⸴ 1⦆ ·
    int64 s3 ↦ parse_record_decl⦅"Token" ⸴ 4⦆ ·
    int64 s4 ↦ parse_variant_decl⦅"LexItem" ⸴ 2⦆ ·
    int64 s5 ↦ parse_network_decl⦅"Classifier" ⸴ 3⦆ ·
    int64 p1 ↦ pratt_precedence⦅"⊗"⦆ ·
    int64 q1 ↦ parse_quantum_gate⦅"H" ⸴ "q0"⦆ ·
    int64 q2 ↦ parse_quantum_entangle⦅"q0" ⸴ "q1"⦆ ·
    int64 q3 ↦ parse_quantum_superpose⦅"q0"⦆ ·
    int64 q4 ↦ parse_quantum_collapse⦅"q0"⦆ ·
    int64 r1 ↦ parse_rsca_attest⦅1 ⸴ "rec1"⦆ ·
    int64 c1 ↦ parse_ctsa_attest⦅"AETHER_QEC" ⸴ 2⦆ ·
    int64 k1 ↦ parse_pcc_attest⦅"RSCA_CERT_0" ⸴ 100⦆ ·

    ParseResult res ↦ variant_init ParseResult ⦅Valid ↦ 8⦆ ·
    int64 final_code ↦ 0 ·
    match res ⟦
        | Valid(v) ⟹ emit v ·
        | Invalid(e) ⟹ emit e ·
    ⟧

    emit "selfhost_parser: core declarations, expressions, quantum & RSCA verified" ·
    yield 0 ·
⟧
