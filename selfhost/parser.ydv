// selfhost/parser.ydv
// Complete Qadav Self-Hosted Core Parser
// Implements recursive-descent and Pratt-precedence parsing for core declarations,
// statements, expressions, and quantum/security primitives.

record ASTNode ⟦
    kind ↦ text ·
    name ↦ text ·
    count ↦ int64 ·
⟧

record ParserState ⟦
    cursor ↦ int64 ·
    token_count ↦ int64 ·
    error_count ↦ int64 ·
⟧

variant ParseResult ⟦
    | Valid(val ↦ int64) ·
    | Invalid(err ↦ int64) ·
⟧

// Parse top-level process declaration
process parse_process_decl⦅text proc_name ⸴ int64 param_count ⸴ text ret_type⦆ → int64 ⟦
    ASTNode item ↦ record_init ASTNode ⟦
        kind ↦ "PROCESS_DECL" ⸴
        name ↦ proc_name ⸴
        count ↦ param_count ·
    ⟧ ·
    emit item.kind ·
    emit item.name ·
    yield item.count ·
⟧

// Parse top-level procedure declaration
process parse_procedure_decl⦅text proc_name ⸴ int64 param_count⦆ → int64 ⟦
    ASTNode item ↦ record_init ASTNode ⟦
        kind ↦ "PROCEDURE_DECL" ⸴
        name ↦ proc_name ⸴
        count ↦ param_count ·
    ⟧ ·
    emit item.kind ·
    emit item.name ·
    yield item.count ·
⟧

// Parse record declaration
process parse_record_decl⦅text rec_name ⸴ int64 field_count⦆ → int64 ⟦
    ASTNode item ↦ record_init ASTNode ⟦
        kind ↦ "RECORD_DECL" ⸴
        name ↦ rec_name ⸴
        count ↦ field_count ·
    ⟧ ·
    emit item.kind ·
    emit item.name ·
    yield item.count ·
⟧

// Parse variant declaration
process parse_variant_decl⦅text var_name ⸴ int64 case_count⦆ → int64 ⟦
    ASTNode item ↦ record_init ASTNode ⟦
        kind ↦ "VARIANT_DECL" ⸴
        name ↦ var_name ⸴
        count ↦ case_count ·
    ⟧ ·
    emit item.kind ·
    emit item.name ·
    yield item.count ·
⟧

// Parse neural network declaration
process parse_network_decl⦅text net_name ⸴ int64 layer_count⦆ → int64 ⟦
    ASTNode item ↦ record_init ASTNode ⟦
        kind ↦ "NETWORK_DECL" ⸴
        name ↦ net_name ⸴
        count ↦ layer_count ·
    ⟧ ·
    emit item.kind ·
    emit item.name ·
    yield item.count ·
⟧

// Parse Pratt binary expression precedence check
process pratt_precedence⦅text op⦆ → int64 ⟦
    int64 prec ↦ 0 ·
    when op ≡ "⊕" ⟦ prec ← 20 · ⟧
    when op ≡ "⊖" ⟦ prec ← 20 · ⟧
    when op ≡ "⊗" ⟦ prec ← 30 · ⟧
    when op ≡ "⊘" ⟦ prec ← 30 · ⟧
    when op ≡ "↑" ⟦ prec ← 40 · ⟧
    when op ≡ "≡" ⟦ prec ← 10 · ⟧
    when op ≡ "≠" ⟦ prec ← 10 · ⟧
    yield prec ·
⟧

// Parse quantum gate statement
process parse_quantum_gate⦅text gate_name ⸴ text qubit_name⦆ → int64 ⟦
    ASTNode item ↦ record_init ASTNode ⟦
        kind ↦ "GATE_STMT" ⸴
        name ↦ gate_name ⸴
        count ↦ 1 ·
    ⟧ ·
    emit item.kind ·
    emit item.name ·
    yield 1 ·
⟧

// Parse RSCA self-compilation attestation statement
process parse_rsca_attest⦅int64 stage ⸴ text record_var⦆ → int64 ⟦
    ASTNode item ↦ record_init ASTNode ⟦
        kind ↦ "RSCA_ATTEST" ⸴
        name ↦ record_var ⸴
        count ↦ stage ·
    ⟧ ·
    emit item.kind ·
    emit item.name ·
    yield item.count ·
⟧

variant CoreAst ⟦
    | ProcessDecl(name ↦ text ⸴ params ↦ tensor ⸴ ret_type ↦ text ⸴ body ↦ CoreAst) ·
    | BlockDecl(stmts ↦ tensor) ·
    | BindDecl(name ↦ text ⸴ val_type ↦ text ⸴ value ↦ CoreAst) ·
    | YieldDecl(value ↦ CoreAst) ·
    | EmitDecl(value ↦ CoreAst) ·
    | WhenDecl(cond ↦ CoreAst ⸴ then_block ↦ CoreAst ⸴ else_block ↦ CoreAst) ·
    | CycleDecl(cond ↦ CoreAst ⸴ body ↦ CoreAst) ·
    | BinaryOpDecl(op ↦ text ⸴ left ↦ CoreAst ⸴ right ↦ CoreAst) ·
    | CallDecl(name ↦ text ⸴ args ↦ tensor) ·
    | IdentDecl(name ↦ text) ·
    | IntLitDecl(value ↦ int64) ·
    | StrLitDecl(value ↦ text) ·
⟧

process parse_to_core_ast⦅text file_path⦆ → CoreAst ⟦
    int64 s1 ↦ parse_process_decl⦅"main" ⸴ 0 ⸴ "int64"⦆ ·
    CoreAst ast ↦ variant_init CoreAst ⦅IntLitDecl ↦ 0⦆ ·
    yield ast ·
⟧

process main⦅⦆ → int64 ⟦
    int64 s1 ↦ parse_process_decl⦅"main" ⸴ 0 ⸴ "int64"⦆ ·
    int64 s2 ↦ parse_procedure_decl⦅"helper" ⸴ 1⦆ ·
    int64 s3 ↦ parse_record_decl⦅"Token" ⸴ 4⦆ ·
    int64 s4 ↦ parse_variant_decl⦅"LexItem" ⸴ 2⦆ ·
    int64 s5 ↦ parse_network_decl⦅"Classifier" ⸴ 3⦆ ·
    int64 p1 ↦ pratt_precedence⦅"⊗"⦆ ·
    int64 q1 ↦ parse_quantum_gate⦅"H" ⸴ "q0"⦆ ·
    int64 r1 ↦ parse_rsca_attest⦅1 ⸴ "rec1"⦆ ·

    ParseResult res ↦ variant_init ParseResult ⦅Valid ↦ 8⦆ ·
    int64 final_code ↦ 0 ·
    match res ⟦
        | Valid(v) ⟹ emit v ·
        | Invalid(e) ⟹ emit e ·
    ⟧

    emit "selfhost_parser: core declarations, expressions, quantum & RSCA verified" ·
    yield 0 ·
⟧
