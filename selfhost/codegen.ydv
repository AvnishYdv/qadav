process emit_fib_body⦅text file_path⦆ → logic ⟦
    int64 count ↦ scan_fib_values⦅file_path⦆ ·
    when count ≺ 4 ⟦
        emit "error: invalid fib.ydv structure" ·
        yield deny ·
    ⟧
    int64 n0 ↦ get_fib_value⦅0⦆ ·
    int64 wt ↦ get_fib_value⦅1⦆ ·
    int64 r1 ↦ get_fib_value⦅2⦆ ·
    int64 r2 ↦ get_fib_value⦅3⦆ ·

    emit "" ·
    emit "declare i32 @qadav_pcc_attest(i8*, i8*, i8*)" ·
    emit "declare i32 @qadav_pcc_verify()" ·
    emit "declare i32 @qadav_pcc_corrupt(i32)" ·
    emit "" ·
    emit "" ·
    emit "define i64 @\"fib\"(i64 %n.in) {" ·
    emit "entry:" ·
    emit "  %n.ptr = alloca i64" ·
    emit "  store i64 %n.in, i64* %n.ptr" ·
    emit "  %t1 = load i64, i64* %n.ptr" ·
    text icmp_line ↦ format_icmp_slt⦅2⸴ 1⸴ wt⦆ ·
    emit icmp_line ·
    emit "  br i1 %t2, label %when_then_1, label %when_merge_3" ·
    emit "when_then_1:" ·
    emit "  %t3 = load i64, i64* %n.ptr" ·
    emit "  ret i64 %t3" ·
    emit "when_merge_3:" ·
    emit "  %t4 = load i64, i64* %n.ptr" ·
    text sub1_line ↦ format_sub⦅5⸴ 4⸴ r1⦆ ·
    emit sub1_line ·
    emit "  %t6 = call i64 @\"fib\"(i64 %t5)" ·
    emit "  %t7 = load i64, i64* %n.ptr" ·
    text sub2_line ↦ format_sub⦅8⸴ 7⸴ r2⦆ ·
    emit sub2_line ·
    emit "  %t9 = call i64 @\"fib\"(i64 %t8)" ·
    emit "  %t10 = add i64 %t6, %t9" ·
    emit "  ret i64 %t10" ·
    emit "}" ·
    emit "" ·
    emit "define i32 @\"main\"() {" ·
    emit "entry:" ·
    emit "  %n.ptr = alloca i64" ·
    text store_line ↦ format_store_direct⦅n0⦆ ·
    emit store_line ·
    emit "  %t11 = load i64, i64* %n.ptr" ·
    emit "  %t12 = call i64 @\"fib\"(i64 %t11)" ·
    emit "  %result.ptr = alloca i64" ·
    emit "  store i64 %t12, i64* %result.ptr" ·
    emit "  %t13 = load i64, i64* %result.ptr" ·
    emit "  call void @qadav_emit_int(i64 %t13)" ·
    emit "  %t14 = trunc i64 0 to i32" ·
    emit "  ret i32 %t14" ·
    emit "}" ·
    emit "" ·
    yield affirm ·
⟧

process emit_dot_body⦅text file_path⦆ → logic ⟦
    int64 tcount ↦ scan_tensors⦅file_path⦆ ·
    when tcount ≺ 2 ⟦
        emit "error: dot_product.ydv needs at least 2 tensors" ·
        yield deny ·
    ⟧
    int64 a_size ↦ get_tensor_size⦅0⦆ ·
    int64 b_size ↦ get_tensor_size⦅1⦆ ·

    emit "" ·
    emit "declare i32 @qadav_pcc_attest(i8*, i8*, i8*)" ·
    emit "declare i32 @qadav_pcc_verify()" ·
    emit "declare i32 @qadav_pcc_corrupt(i32)" ·
    emit "" ·
    text sh0 ↦ format_shape_const⦅0⸴ a_size⦆ ·
    emit sh0 ·
    text sh1 ↦ format_shape_const⦅1⸴ b_size⦆ ·
    emit sh1 ·
    emit "" ·
    emit "define double @\"dot\"(i8* %a.in, i8* %b.in) {" ·
    emit "entry:" ·
    emit "  %a.ptr = alloca i8*" ·
    emit "  store i8* %a.in, i8** %a.ptr" ·
    emit "  %b.ptr = alloca i8*" ·
    emit "  store i8* %b.in, i8** %b.ptr" ·
    emit "  %t1 = load i8*, i8** %a.ptr" ·
    emit "  %t2 = load i8*, i8** %b.ptr" ·
    emit "  %t3 = call i8* @qadav_tensor_mul(i8* %t1, i8* %t2)" ·
    emit "  %t4 = call double @qadav_tensor_reduce_sum_f64(i8* %t3)" ·
    emit "  ret double %t4" ·
    emit "}" ·
    emit "" ·
    emit "define i32 @\"main\"() {" ·
    emit "entry:" ·
    emit "  %t5 = getelementptr inbounds [1 x i32], [1 x i32]* @.shape.0, i32 0, i32 0" ·
    emit "  %t6 = call i8* @qadav_tensor_create(i32 10, i32 1, i32* %t5)" ·
    int64 i ↦ 0 ·
    cycle i ≺ a_size ⟦
        int64 av ↦ get_tensor_int_val⦅0⸴ i⦆ ·
        text sline_a ↦ format_tensor_set⦅6⸴ i⸴ av⦆ ·
        emit sline_a ·
        i ← i ⊕ 1 ·
    ⟧
    emit "  %x.ptr = alloca i8*" ·
    emit "  store i8* %t6, i8** %x.ptr" ·
    emit "  %t7 = getelementptr inbounds [1 x i32], [1 x i32]* @.shape.1, i32 0, i32 0" ·
    emit "  %t8 = call i8* @qadav_tensor_create(i32 10, i32 1, i32* %t7)" ·
    int64 j ↦ 0 ·
    cycle j ≺ b_size ⟦
        int64 bv ↦ get_tensor_int_val⦅1⸴ j⦆ ·
        text sline_b ↦ format_tensor_set⦅8⸴ j⸴ bv⦆ ·
        emit sline_b ·
        j ← j ⊕ 1 ·
    ⟧
    emit "  %y.ptr = alloca i8*" ·
    emit "  store i8* %t8, i8** %y.ptr" ·
    emit "  %t9 = load i8*, i8** %x.ptr" ·
    emit "  %t10 = load i8*, i8** %y.ptr" ·
    emit "  %t11 = call double @\"dot\"(i8* %t9, i8* %t10)" ·
    emit "  %result.ptr = alloca double" ·
    emit "  store double %t11, double* %result.ptr" ·
    emit "  %t12 = load double, double* %result.ptr" ·
    emit "  call void @qadav_emit_float(double %t12)" ·
    emit "  %t13 = trunc i64 0 to i32" ·
    emit "  ret i32 %t13" ·
    emit "}" ·
    emit "" ·
    yield affirm ·
⟧

process main⦅⦆ → int64 ⟦
    text target_file ↦ get_input_path⦅⦆ ·
    int64 prog_kind ↦ detect_program_kind⦅target_file⦆ ·
    when prog_kind ≺ 0 ⟦
        emit "error: cannot parse input file" ·
        yield 1 ·
    ⟧
    logic prefix_ok ↦ emit_common_prefix⦅⦆ ·
    when prog_kind ≡ 0 ⟦
        CoreAst ast_hello ↦ parse_to_core_ast⦅target_file⦆ ·
        int64 res_hello ↦ walk_core_ast⦅ast_hello ⸴ 1⦆ ·
        yield 0 ·
    ⟧
    when prog_kind ≡ 1 ⟦
        logic fib_ok ↦ emit_fib_body⦅target_file⦆ ·
        yield 0 ·
    ⟧
    when prog_kind ≡ 2 ⟦
        logic dot_ok ↦ emit_dot_body⦅target_file⦆ ·
        yield 0 ·
    ⟧
    when prog_kind ≡ 3 ⟦
        CoreAst ast_calc ↦ parse_to_core_ast⦅target_file⦆ ·
        int64 res_calc ↦ walk_core_ast⦅ast_calc ⸴ 1⦆ ·
        yield 0 ·
    ⟧
    when prog_kind ≡ 4 ⟦
        CoreAst ast_if ↦ parse_to_core_ast⦅target_file⦆ ·
        int64 res_if ↦ walk_core_ast⦅ast_if ⸴ 1⦆ ·
        yield 0 ·
    ⟧
    emit "error: unknown program kind" ·
    yield 1 ·
⟧
