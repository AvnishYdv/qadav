                    text sline_imm_i1 ↦ format_store_imm_i1⦅name ⸴ imm_as⦆ ·
                    emit sline_imm_i1 ·
                ⟧ otherwise ⟦
                    text sline_imm ↦ format_store⦅name ⸴ imm_as⦆ ·
                    emit sline_imm ·
                ⟧
            ⟧ otherwise ⟦
                when vtype_as ≡ 1 ⟦
                    text sline_ptr ↦ format_store_reg_type⦅name ⸴ "i8*" ⸴ val_reg⦆ ·
                    emit sline_ptr ·
                ⟧ otherwise ⟦
                    when vtype_as ≡ 2 ⟦
                        text sline_dbl ↦ format_store_reg_type⦅name ⸴ "double" ⸴ val_reg⦆ ·
                        emit sline_dbl ·
                    ⟧ otherwise ⟦
                        when vtype_as ≡ 3 ⟦
                            text sline_i1 ↦ format_store_reg_type⦅name ⸴ "i1" ⸴ val_reg⦆ ·
                            emit sline_i1 ·
                        ⟧ otherwise ⟦
                            text sline ↦ format_store_reg⦅name ⸴ val_reg⦆ ·
                            emit sline ·
                        ⟧
                    ⟧
                ⟧
            ⟧
            yield t_val ·
        | RecordDeclStmt(name ⸴ count) ⟹
            yield temp_counter ·
        | VariantDeclStmt(name ⸴ count) ⟹
            yield temp_counter ·
        | MatchStmt(subject ⸴ arms) ⟹
            int64 p_ok ↦ prealloc_match_bindings⦅subject⦆ ·
            int64 t_arms ↦ walk_core_ast⦅arms ⸴ temp_counter⦆ ·
            yield t_arms ·
        | ProcedureDecl(name ⸴ p ⸴ ret ⸴ body) ⟹
            emit_proc_header⦅name ⸴ ret ⸴ p⦆ ·
            int64 t_proc_d ↦ walk_core_ast⦅body ⸴ temp_counter⦆ ·
            emit "}" ·
            emit "" ·
            yield t_proc_d ·
        | Procedure2Decl(name ⸴ p1 ⸴ p2 ⸴ ret ⸴ body) ⟹
            emit_proc_header_2⦅name ⸴ ret ⸴ p1 ⸴ p2⦆ ·
            int64 t_proc2_d ↦ walk_core_ast⦅body ⸴ temp_counter⦆ ·
            emit "}" ·
            emit "" ·
            yield t_proc2_d ·
        | RecordInitExpr(type_name ⸴ field_count) ⟹
            int64 next_t_rec ↦ emit_record_init⦅type_name ⸴ field_count ⸴ temp_counter⦆ ·
            yield next_t_rec ·
        | VariantInitExpr(var_name ⸴ case_name ⸴ payload) ⟹
            int64 acnt ↦ get_next_var_init_arg_count⦅⦆ ·
            when acnt ≼ 1 ⟦
                int64 t_payload ↦ walk_core_ast⦅payload ⸴ temp_counter⦆ ·
                int64 reg_payload ↦ get_last_temp⦅⦆ ·
                int64 pkind ↦ get_last_emit_kind⦅⦆ ·
                int64 next_t_var ↦ emit_variant_init⦅var_name ⸴ case_name ⸴ reg_payload ⸴ pkind ⸴ t_payload⦆ ·
                yield next_t_var ·
            ⟧ otherwise ⟦
                int64 next_t_var2 ↦ emit_variant_init⦅var_name ⸴ case_name ⸴ 0 ⸴ 0 ⸴ temp_counter⦆ ·
                yield next_t_var2 ·
            ⟧
        | FieldAccessExpr(obj_name ⸴ field_name) ⟹
            text load_line ↦ format_load_type⦅obj_name ⸴ "i8*" ⸴ temp_counter⦆ ·
            emit load_line ·
            int64 f_idx ↦ get_record_field_idx⦅obj_name ⸴ field_name⦆ ·
            int64 is_ptr ↦ is_record_field_ptr⦅obj_name ⸴ field_name⦆ ·
            int64 res_t_fa ↦ temp_counter ⊕ 1 ·
            int64 next_t_fa ↦ emit_record_get_field⦅res_t_fa ⸴ temp_counter ⸴ f_idx ⸴ is_ptr⦆ ·
            yield next_t_fa ·
        | ExprStmt(inner) ⟹
            int64 t_es ↦ walk_core_ast⦅inner ⸴ temp_counter⦆ ·
            yield t_es ·
        | Call3Decl(name ⸴ a1 ⸴ a2 ⸴ a3) ⟹
            int64 t_c3_1 ↦ walk_core_ast⦅a1 ⸴ temp_counter⦆ ·
            int64 reg_c3_1 ↦ get_last_temp⦅⦆ ·
            int64 t_c3_2 ↦ walk_core_ast⦅a2 ⸴ t_c3_1⦆ ·
            int64 reg_c3_2 ↦ get_last_temp⦅⦆ ·
            int64 t_c3_3 ↦ walk_core_ast⦅a3 ⸴ t_c3_2⦆ ·
            int64 reg_c3_3 ↦ get_last_temp⦅⦆ ·
            int64 res_c3 ↦ emit_call_3⦅name ⸴ t_c3_3 ⸴ reg_c3_1 ⸴ reg_c3_2 ⸴ reg_c3_3⦆ ·
            yield res_c3 ·
        | Call4Decl(name ⸴ a1 ⸴ a2 ⸴ a3 ⸴ a4) ⟹
            int64 t_c4_1 ↦ walk_core_ast⦅a1 ⸴ temp_counter⦆ ·
            int64 reg_c4_1 ↦ get_last_temp⦅⦆ ·
            int64 t_c4_2 ↦ walk_core_ast⦅a2 ⸴ t_c4_1⦆ ·
            int64 reg_c4_2 ↦ get_last_temp⦅⦆ ·
            int64 t_c4_3 ↦ walk_core_ast⦅a3 ⸴ t_c4_2⦆ ·
            int64 reg_c4_3 ↦ get_last_temp⦅⦆ ·
            int64 t_c4_4 ↦ walk_core_ast⦅a4 ⸴ t_c4_3⦆ ·
            int64 reg_c4_4 ↦ get_last_temp⦅⦆ ·
            set_call_arg_extra⦅reg_c4_4⦆ ·
            int64 res_c4 ↦ emit_call_4_sub⦅name ⸴ t_c4_4 ⸴ reg_c4_1 ⸴ reg_c4_2 ⸴ reg_c4_3⦆ ·
            yield res_c4 ·
        | Call5Decl(name ⸴ a1 ⸴ a2 ⸴ a3 ⸴ a4 ⸴ a5) ⟹
            int64 t_c5_1 ↦ walk_core_ast⦅a1 ⸴ temp_counter⦆ ·
            int64 reg_c5_1 ↦ get_last_temp⦅⦆ ·
            int64 t_c5_2 ↦ walk_core_ast⦅a2 ⸴ t_c5_1⦆ ·
            int64 reg_c5_2 ↦ get_last_temp⦅⦆ ·
            int64 t_c5_3 ↦ walk_core_ast⦅a3 ⸴ t_c5_2⦆ ·
            int64 reg_c5_3 ↦ get_last_temp⦅⦆ ·
            int64 t_c5_4 ↦ walk_core_ast⦅a4 ⸴ t_c5_3⦆ ·
            int64 reg_c5_4 ↦ get_last_temp⦅⦆ ·
            int64 t_c5_5 ↦ walk_core_ast⦅a5 ⸴ t_c5_4⦆ ·
            int64 reg_c5_5 ↦ get_last_temp⦅⦆ ·
            set_call_arg_extra⦅reg_c5_4⦆ ·
            set_call_arg_extra_2⦅reg_c5_5⦆ ·
            int64 res_c5 ↦ emit_call_5_sub⦅name ⸴ t_c5_5 ⸴ reg_c5_1 ⸴ reg_c5_2 ⸴ reg_c5_3⦆ ·
            yield res_c5 ·
        | CustomStmtDecl(start_idx) ⟹
            int64 next_t_cust ↦ emit_custom_stmt⦅start_idx ⸴ temp_counter⦆ ·
            yield next_t_cust ·
    ⟧
    yield temp_counter ·
⟧

