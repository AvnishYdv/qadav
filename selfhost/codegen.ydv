    emit "" ·
    emit "declare i8* @qadav_qemwv_create(i32, i32, i8*)" ·
    emit "declare i32 @qadav_qemwv_seal(i8*, i8**, i32)" ·
    emit "declare i8** @qadav_qemwv_unseal(i8*, i8*)" ·
    emit "declare void @qadav_qemwv_wipe(i8*)" ·
    emit "declare i8* @qadav_qemwv_read_share_unauthorized(i8*, i32)" ·
    emit "declare void @qadav_qemwv_free(i8*)" ·
    emit "" ·
    emit "declare i8* @qadav_mctp_init(i32)" ·
    emit "declare void @qadav_mctp_record_epoch(i8*, i32, i8*, i64, i8*, i64, double)" ·
    emit "declare void @qadav_mctp_record_epochs(i8*, i32, i8*, i64, i8*, i64, double)" ·
    emit "declare void @qadav_mctp_certify(i8*)" ·
    emit "declare i32 @qadav_mctp_verify(i8*, i8*, i64)" ·
    emit "declare void @qadav_mctp_free(i8*)" ·
    emit "" ·
    emit "declare i8* @qadav_qemp_create(i8*, i32)" ·
    emit "declare i32 @qadav_qemp_remember_text(i8*, i8*, i8*, i8*)" ·
    emit "declare i8* @qadav_qemp_recall_text(i8*, i8*)" ·
    emit "declare i32 @qadav_qemp_verify_all(i8*)" ·
    emit "declare i32 @qadav_qemp_audit(i8*)" ·
    emit "declare i32 @qadav_qemp_corrupt_share(i8*, i8*, i32)" ·
    emit "declare void @qadav_qemp_wipe_all(i8*)" ·
    emit "declare void @qadav_qemp_free(i8*)" ·
