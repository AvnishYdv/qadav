process emit_common_prefix⦅⦆ → logic ⟦
    logic c_0 ↦ emit_common_decls_0⦅⦆ ·
    logic c_1 ↦ emit_common_decls_1⦅⦆ ·
    logic c_2 ↦ emit_common_decls_2⦅⦆ ·
    logic c_3 ↦ emit_common_decls_3⦅⦆ ·
    logic c_4 ↦ emit_common_decls_4⦅⦆ ·
    logic c_5 ↦ emit_common_decls_5⦅⦆ ·
    yield affirm ·
⟧

process main⦅⦆ → int64 ⟦
    text target_file ↦ get_input_path⦅⦆ ·
    int64 prog_kind ↦ detect_program_kind⦅target_file⦆ ·
    when prog_kind ≺ 0 ⟦
        emit "error: cannot parse input file" ·
        yield 1 ·
    ⟧
    logic prefix_ok ↦ emit_common_prefix⦅⦆ ·
    when prog_kind ≡ 0 ⟦
        CoreAst ast_hello ↦ parse_to_core_ast⦅target_file⦆ ·
        int64 res_hello ↦ walk_core_ast⦅ast_hello ⸴ 1⦆ ·
        yield 0 ·
    ⟧
    when prog_kind ≡ 1 ⟦
        CoreAst ast_fib ↦ parse_to_core_ast⦅target_file⦆ ·
        int64 res_fib ↦ walk_core_ast⦅ast_fib ⸴ 1⦆ ·
        yield 0 ·
    ⟧
    when prog_kind ≡ 2 ⟦
        CoreAst ast_dot ↦ parse_to_core_ast⦅target_file⦆ ·
        int64 res_dot ↦ walk_core_ast⦅ast_dot ⸴ 1⦆ ·
        yield 0 ·
    ⟧
    when prog_kind ≡ 3 ⟦
        CoreAst ast_calc ↦ parse_to_core_ast⦅target_file⦆ ·
        int64 res_calc ↦ walk_core_ast⦅ast_calc ⸴ 1⦆ ·
        yield 0 ·
    ⟧
    when prog_kind ≡ 4 ⟦
        CoreAst ast_if ↦ parse_to_core_ast⦅target_file⦆ ·
        int64 res_if ↦ walk_core_ast⦅ast_if ⸴ 1⦆ ·
        yield 0 ·
    ⟧
    emit "error: unknown program kind" ·
    yield 1 ·
⟧
