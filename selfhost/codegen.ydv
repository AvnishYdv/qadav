// selfhost/codegen.ydv
// Complete Dynamic Qadav Self-Hosted LLVM IR Codegen for hello, fib, and dot_product
// Inspects runtime target via get_target_kind() and dynamically emits target-specific AST LLVM IR

record CodegenContext ⟦
    temp_count ↦ int64 ·
    label_count ↦ int64 ·
    str_count ↦ int64 ·
    is_terminated ↦ logic ·
⟧

variant CoreAst ⟦
    | ProcessDecl(name ↦ text ⸴ param_name ↦ text ⸴ ret_type ↦ text ⸴ body ↦ CoreAst) ·
    | Process2Decl(name ↦ text ⸴ p1 ↦ text ⸴ p2 ↦ text ⸴ ret_type ↦ text ⸴ body ↦ CoreAst) ·
    | BlockDecl(first ↦ CoreAst ⸴ second ↦ CoreAst) ·
    | BindDecl(name ↦ text ⸴ val_type ↦ text ⸴ value ↦ CoreAst) ·
    | YieldDecl(value ↦ CoreAst) ·
    | EmitDecl(value ↦ CoreAst) ·
    | WhenDecl(cond ↦ CoreAst ⸴ then_block ↦ CoreAst ⸴ else_block ↦ CoreAst) ·
    | When1Decl(cond ↦ CoreAst ⸴ then_block ↦ CoreAst) ·
    | CycleDecl(cond ↦ CoreAst ⸴ body ↦ CoreAst) ·
    | BinaryOpDecl(op ↦ text ⸴ left ↦ CoreAst ⸴ right ↦ CoreAst) ·
    | CallDecl(name ↦ text ⸴ args ↦ tensor) ·
    | Call0Decl(name ↦ text) ·
    | Call1Decl(name ↦ text ⸴ arg ↦ CoreAst) ·
    | Call2Decl(name ↦ text ⸴ arg1 ↦ CoreAst ⸴ arg2 ↦ CoreAst) ·
    | TensorDecl(idx ↦ int64 ⸴ elem_count ↦ int64) ·
    | ReduceSumDecl(inner ↦ CoreAst) ·
    | ExprStmt(expr ↦ CoreAst) ·
    | IdentDecl(name ↦ text) ·
    | IntLitDecl(value ↦ int64) ·
    | FloatLitDecl(value ↦ float64) ·
    | StrLitDecl(value ↦ text) ·
    | ProcedureDecl(name ↦ text ⸴ param_name ↦ text ⸴ ret_type ↦ text ⸴ body ↦ CoreAst) ·
    | Procedure2Decl(name ↦ text ⸴ p1 ↦ text ⸴ p2 ↦ text ⸴ ret_type ↦ text ⸴ body ↦ CoreAst) ·
    | RecordDeclStmt(name ↦ text ⸴ count ↦ int64) ·
    | VariantDeclStmt(name ↦ text ⸴ count ↦ int64) ·
    | RecordInitExpr(type_name ↦ text ⸴ field_count ↦ int64) ·
    | VariantInitExpr(var_name ↦ text ⸴ case_name ↦ text ⸴ payload ↦ CoreAst) ·
    | FieldAccessExpr(obj_name ↦ text ⸴ field_name ↦ text) ·
    | AssignStmt(name ↦ text ⸴ value ↦ CoreAst) ·
    | MatchStmt(subject ↦ text ⸴ arms ↦ CoreAst) ·
    | Call3Decl(name ↦ text ⸴ a1 ↦ CoreAst ⸴ a2 ↦ CoreAst ⸴ a3 ↦ CoreAst) ·
    | Call4Decl(name ↦ text ⸴ a1 ↦ CoreAst ⸴ a2 ↦ CoreAst ⸴ a3 ↦ CoreAst ⸴ a4 ↦ CoreAst) ·
    | Call5Decl(name ↦ text ⸴ a1 ↦ CoreAst ⸴ a2 ↦ CoreAst ⸴ a3 ↦ CoreAst ⸴ a4 ↦ CoreAst ⸴ a5 ↦ CoreAst) ·
    | CustomStmtDecl(start_idx ↦ int64) ·
⟧

process ast_custom_stmt⦅int64 idx⦆ → CoreAst ⟦
    CoreAst n ↦ variant_init CoreAst ⦅CustomStmtDecl ↦ idx⦆ ·
    yield n ·
⟧

process ast_int_lit⦅int64 v⦆ → CoreAst ⟦
    CoreAst n ↦ variant_init CoreAst ⦅IntLitDecl ↦ v⦆ ·
    yield n ·
⟧

process ast_float_lit⦅float64 v⦆ → CoreAst ⟦
    CoreAst n ↦ variant_init CoreAst ⦅FloatLitDecl ↦ v⦆ ·
    yield n ·
⟧

process ast_str_lit⦅text s⦆ → CoreAst ⟦
    CoreAst n ↦ variant_init CoreAst ⦅StrLitDecl ↦ s⦆ ·
    yield n ·
⟧

process ast_ident⦅text id⦆ → CoreAst ⟦
    CoreAst n ↦ variant_init CoreAst ⦅IdentDecl ↦ id⦆ ·
    yield n ·
⟧

process ast_binop⦅text op ⸴ CoreAst left ⸴ CoreAst right⦆ → CoreAst ⟦
    CoreAst n ↦ variant_init CoreAst ⦅BinaryOpDecl ↦ op ⸴ left ⸴ right⦆ ·
    yield n ·
⟧

process ast_bind⦅text name ⸴ text val_type ⸴ CoreAst val⦆ → CoreAst ⟦
    CoreAst n ↦ variant_init CoreAst ⦅BindDecl ↦ name ⸴ val_type ⸴ val⦆ ·
    yield n ·
⟧

process ast_assign⦅text name ⸴ CoreAst val⦆ → CoreAst ⟦
    CoreAst n ↦ variant_init CoreAst ⦅AssignStmt ↦ name ⸴ val⦆ ·
    yield n ·
⟧

process ast_yield⦅CoreAst val⦆ → CoreAst ⟦
    CoreAst n ↦ variant_init CoreAst ⦅YieldDecl ↦ val⦆ ·
    yield n ·
⟧

process ast_emit⦅CoreAst val⦆ → CoreAst ⟦
    CoreAst n ↦ variant_init CoreAst ⦅EmitDecl ↦ val⦆ ·
    yield n ·
⟧

process ast_when⦅CoreAst cond ⸴ CoreAst then_b ⸴ CoreAst else_b⦆ → CoreAst ⟦
    CoreAst n ↦ variant_init CoreAst ⦅WhenDecl ↦ cond ⸴ then_b ⸴ else_b⦆ ·
    yield n ·
⟧

process ast_match⦅text subject ⸴ CoreAst arms⦆ → CoreAst ⟦
    CoreAst n ↦ variant_init CoreAst ⦅MatchStmt ↦ subject ⸴ arms⦆ ·
    yield n ·
⟧

process ast_when1⦅CoreAst cond ⸴ CoreAst then_b⦆ → CoreAst ⟦
    CoreAst n ↦ variant_init CoreAst ⦅When1Decl ↦ cond ⸴ then_b⦆ ·
    yield n ·
⟧

process ast_cycle⦅CoreAst cond ⸴ CoreAst body⦆ → CoreAst ⟦
    CoreAst n ↦ variant_init CoreAst ⦅CycleDecl ↦ cond ⸴ body⦆ ·
    yield n ·
⟧

process ast_call0⦅text name⦆ → CoreAst ⟦
    CoreAst n ↦ variant_init CoreAst ⦅Call0Decl ↦ name⦆ ·
    yield n ·
⟧

process ast_call1⦅text name ⸴ CoreAst arg⦆ → CoreAst ⟦
    CoreAst n ↦ variant_init CoreAst ⦅Call1Decl ↦ name ⸴ arg⦆ ·
    yield n ·
⟧

process ast_call2⦅text name ⸴ CoreAst arg1 ⸴ CoreAst arg2⦆ → CoreAst ⟦
    CoreAst n ↦ variant_init CoreAst ⦅Call2Decl ↦ name ⸴ arg1 ⸴ arg2⦆ ·
    yield n ·
⟧

process ast_call3⦅text name ⸴ CoreAst a1 ⸴ CoreAst a2 ⸴ CoreAst a3⦆ → CoreAst ⟦
    CoreAst n ↦ variant_init CoreAst ⦅Call3Decl ↦ name ⸴ a1 ⸴ a2 ⸴ a3⦆ ·
    yield n ·
⟧

process ast_call4⦅text name ⸴ CoreAst a1 ⸴ CoreAst a2 ⸴ CoreAst a3 ⸴ CoreAst a4⦆ → CoreAst ⟦
    CoreAst n ↦ variant_init CoreAst ⦅Call4Decl ↦ name ⸴ a1 ⸴ a2 ⸴ a3 ⸴ a4⦆ ·
    yield n ·
⟧

process ast_call5⦅text name ⸴ CoreAst a1 ⸴ CoreAst a2 ⸴ CoreAst a3 ⸴ CoreAst a4 ⸴ CoreAst a5⦆ → CoreAst ⟦
    CoreAst n ↦ variant_init CoreAst ⦅Call5Decl ↦ name ⸴ a1 ⸴ a2 ⸴ a3 ⸴ a4 ⸴ a5⦆ ·
    yield n ·
⟧

process ast_tensor⦅int64 idx ⸴ int64 elem_count⦆ → CoreAst ⟦
    CoreAst n ↦ variant_init CoreAst ⦅TensorDecl ↦ idx ⸴ elem_count⦆ ·
    yield n ·
⟧

process ast_reduce_sum⦅CoreAst inner_node⦆ → CoreAst ⟦
    CoreAst n ↦ variant_init CoreAst ⦅ReduceSumDecl ↦ inner_node⦆ ·
    yield n ·
⟧

process ast_record_init⦅text type_name ⸴ int64 field_count⦆ → CoreAst ⟦
    CoreAst n ↦ variant_init CoreAst ⦅RecordInitExpr ↦ type_name ⸴ field_count⦆ ·
    yield n ·
⟧

process ast_variant_init⦅text var_name ⸴ text case_name ⸴ CoreAst payload⦆ → CoreAst ⟦
    CoreAst n ↦ variant_init CoreAst ⦅VariantInitExpr ↦ var_name ⸴ case_name ⸴ payload⦆ ·
    yield n ·
⟧

process ast_field_access⦅text obj_name ⸴ text field_name⦆ → CoreAst ⟦
    CoreAst n ↦ variant_init CoreAst ⦅FieldAccessExpr ↦ obj_name ⸴ field_name⦆ ·
    yield n ·
⟧

process ast_block⦅CoreAst first ⸴ CoreAst second⦆ → CoreAst ⟦
    CoreAst n ↦ variant_init CoreAst ⦅BlockDecl ↦ first ⸴ second⦆ ·
    yield n ·
⟧

process ast_proc⦅text name ⸴ text p ⸴ text ret ⸴ CoreAst body⦆ → CoreAst ⟦
    CoreAst n ↦ variant_init CoreAst ⦅ProcessDecl ↦ name ⸴ p ⸴ ret ⸴ body⦆ ·
    yield n ·
⟧

process ast_proc2⦅text name ⸴ text p1 ⸴ text p2 ⸴ text ret ⸴ CoreAst body⦆ → CoreAst ⟦
    CoreAst n ↦ variant_init CoreAst ⦅Process2Decl ↦ name ⸴ p1 ⸴ p2 ⸴ ret ⸴ body⦆ ·
    yield n ·
⟧

process ast_procedure⦅text name ⸴ text p ⸴ text ret ⸴ CoreAst body⦆ → CoreAst ⟦
    CoreAst n ↦ variant_init CoreAst ⦅ProcedureDecl ↦ name ⸴ p ⸴ ret ⸴ body⦆ ·
    yield n ·
⟧

process ast_procedure2⦅text name ⸴ text p1 ⸴ text p2 ⸴ text ret ⸴ CoreAst body⦆ → CoreAst ⟦
    CoreAst n ↦ variant_init CoreAst ⦅Procedure2Decl ↦ name ⸴ p1 ⸴ p2 ⸴ ret ⸴ body⦆ ·
    yield n ·
⟧

process ast_record_decl⦅text name ⸴ int64 count⦆ → CoreAst ⟦
    CoreAst n ↦ variant_init CoreAst ⦅RecordDeclStmt ↦ name ⸴ count⦆ ·
    yield n ·
⟧

process ast_variant_decl⦅text name ⸴ int64 count⦆ → CoreAst ⟦
    CoreAst n ↦ variant_init CoreAst ⦅VariantDeclStmt ↦ name ⸴ count⦆ ·
    yield n ·
⟧

// ============================================================================

process parse_primary⦅int64 idx⦆ → CoreAst ⟦
    int64 kcode ↦ token_kind_code⦅idx⦆ ·
    when kcode ≡ 3 ⟦
        text s ↦ token_literal⦅idx⦆ ·
        yield ast_str_lit⦅s⦆ ·
    ⟧
    when kcode ≡ 4 ⟦
        int64 v ↦ token_int_val⦅idx⦆ ·
        yield ast_int_lit⦅v⦆ ·
    ⟧
    when kcode ≡ 2 ⟦
        text id ↦ token_literal⦅idx⦆ ·
        yield ast_ident⦅id⦆ ·
    ⟧
    yield ast_int_lit⦅0⦆ ·
⟧

process parse_binary_op⦅text op ⸴ CoreAst left ⸴ CoreAst right⦆ → CoreAst ⟦
    yield ast_binop⦅op ⸴ left ⸴ right⦆ ·
⟧

process get_tok_precedence⦅int64 kcode ⸴ text op⦆ → int64 ⟦
    int64 p ↦ 10 ·
    when kcode ≡ 13 ∨ kcode ≡ 14 ∨ kcode ≡ 16 ∨ kcode ≡ 17 ∨ kcode ≡ 18 ∨ kcode ≡ 19 ⟦
        p ← 5 ·
    ⟧ otherwise ⟦
        when kcode ≡ 15 ⟦
            int64 is_m ↦ is_mul_op⦅op⦆ ·
            when is_m ≡ 1 ⟦
                p ← 20 ·
            ⟧ otherwise ⟦
                p ← 10 ·
            ⟧
        ⟧
    ⟧
    yield p ·
⟧

process parse_expression⦅int64 idx⦆ → CoreAst ⟦
    int64 kcode ↦ token_kind_code⦅idx⦆ ·
    when kcode ≡ 27 ∨ token_literal⦅idx⦆ ≡ "∑" ⟦
        int64 r_arg ↦ idx ⊕ 1 ·
        when token_kind_code⦅r_arg⦆ ≡ 22 ⟦
            r_arg ← idx ⊕ 2 ·
        ⟧
        CoreAst r_inner ↦ parse_expression⦅r_arg⦆ ·
        yield ast_reduce_sum⦅r_inner⦆ ·
    ⟧

    when kcode ≡ 22 ⟦
        int64 close_p_expr ↦ idx ⊕ 1 ·
        int64 depth_expr ↦ 1 ·
        cycle depth_expr ≻ 0 ⟦
            int64 kc_pe ↦ token_kind_code⦅close_p_expr⦆ ·
            when kc_pe ≡ 22 ⟦
                depth_expr ← depth_expr ⊕ 1 ·
            ⟧ otherwise ⟦
                when kc_pe ≡ 23 ⟦
                    depth_expr ← depth_expr ⊖ 1 ·
                ⟧
            ⟧
            when depth_expr ≻ 0 ⟦
                close_p_expr ← close_p_expr ⊕ 1 ·
            ⟧
        ⟧
        CoreAst inner_expr ↦ parse_expression⦅idx ⊕ 1⦆ ·
        int64 after_close ↦ close_p_expr ⊕ 1 ·
        int64 ac_code ↦ token_kind_code⦅after_close⦆ ·
        when ac_code ≡ 38 ∨ ac_code ≡ 39 ∨ ac_code ≡ 13 ∨ ac_code ≡ 14 ∨ ac_code ≡ 15 ∨ ac_code ≡ 16 ∨ ac_code ≡ 17 ∨ ac_code ≡ 18 ∨ ac_code ≡ 19 ⟦
            text ac_op ↦ token_literal⦅after_close⦆ ·
            CoreAst ac_right ↦ parse_expression⦅after_close ⊕ 1⦆ ·
            yield parse_binary_op⦅ac_op ⸴ inner_expr ⸴ ac_right⦆ ·
        ⟧
        yield inner_expr ·
    ⟧

    when kcode ≡ 2 ∧ token_kind_code⦅idx ⊕ 1⦆ ≡ 22 ⟦
        text cname ↦ token_literal⦅idx⦆ ·
        int64 close_p ↦ idx ⊕ 2 ·
        int64 p_depth_cp ↦ 1 ·
        cycle p_depth_cp ≻ 0 ⟦
            int64 kc_cp ↦ token_kind_code⦅close_p⦆ ·
            when kc_cp ≡ 22 ⟦
                p_depth_cp ← p_depth_cp ⊕ 1 ·
            ⟧ otherwise ⟦
                when kc_cp ≡ 23 ⟦
                    p_depth_cp ← p_depth_cp ⊖ 1 ·
                ⟧
            ⟧
            when p_depth_cp ≻ 0 ⟦
                close_p ← close_p ⊕ 1 ·
            ⟧
        ⟧
        CoreAst left_call ↦ ast_int_lit⦅0⦆ ·
        when close_p ≡ idx ⊕ 2 ⟦
            left_call ← ast_call0⦅cname⦆ ·
        ⟧ otherwise ⟦
            int64 n_commas ↦ 0 ·
            int64 sc ↦ idx ⊕ 2 ·
            int64 p_depth ↦ 0 ·
            cycle sc ≺ close_p ⟦
                int64 kc_sc ↦ token_kind_code⦅sc⦆ ·
                when kc_sc ≡ 22 ⟦
                    p_depth ← p_depth ⊕ 1 ·
                ⟧ otherwise ⟦
                    when kc_sc ≡ 23 ⟦
                        p_depth ← p_depth ⊖ 1 ·
                    ⟧ otherwise ⟦
                        when kc_sc ≡ 25 ∧ p_depth ≡ 0 ⟦
                            n_commas ← n_commas ⊕ 1 ·
                        ⟧
                    ⟧
                ⟧
                sc ← sc ⊕ 1 ·
            ⟧
            when n_commas ≡ 0 ⟦
                CoreAst a_expr ↦ parse_expression⦅idx ⊕ 2⦆ ·
                left_call ← ast_call1⦅cname ⸴ a_expr⦆ ·
            ⟧ otherwise ⟦
                when n_commas ≡ 1 ⟦
                    CoreAst a1_2 ↦ parse_primary⦅idx ⊕ 2⦆ ·
                    CoreAst a2_2 ↦ parse_expression⦅idx ⊕ 4⦆ ·
                    left_call ← ast_call2⦅cname ⸴ a1_2 ⸴ a2_2⦆ ·
                ⟧ otherwise ⟦
                    when n_commas ≡ 2 ⟦
                        CoreAst a1_3 ↦ parse_primary⦅idx ⊕ 2⦆ ·
                        CoreAst a2_3 ↦ parse_primary⦅idx ⊕ 4⦆ ·
                        CoreAst a3_3 ↦ parse_expression⦅idx ⊕ 6⦆ ·
                        CoreAst c3 ↦ variant_init CoreAst ⦅Call3Decl ↦ cname ⸴ a1_3 ⸴ a2_3 ⸴ a3_3⦆ ·
                        left_call ← c3 ·
                    ⟧ otherwise ⟦
                        when n_commas ≡ 3 ⟦
                            CoreAst a1_4 ↦ parse_primary⦅idx ⊕ 2⦆ ·
                            CoreAst a2_4 ↦ parse_primary⦅idx ⊕ 4⦆ ·
                            CoreAst a3_4 ↦ parse_primary⦅idx ⊕ 6⦆ ·
                            CoreAst a4_4 ↦ parse_expression⦅idx ⊕ 8⦆ ·
                            CoreAst c4 ↦ variant_init CoreAst ⦅Call4Decl ↦ cname ⸴ a1_4 ⸴ a2_4 ⸴ a3_4 ⸴ a4_4⦆ ·
                            left_call ← c4 ·
                        ⟧ otherwise ⟦
                            CoreAst a1_5 ↦ parse_primary⦅idx ⊕ 2⦆ ·
                            CoreAst a2_5 ↦ parse_primary⦅idx ⊕ 4⦆ ·
                            CoreAst a3_5 ↦ parse_primary⦅idx ⊕ 6⦆ ·
                            CoreAst a4_5 ↦ parse_primary⦅idx ⊕ 8⦆ ·
                            CoreAst a5_5 ↦ parse_expression⦅idx ⊕ 10⦆ ·
                            CoreAst c5 ↦ variant_init CoreAst ⦅Call5Decl ↦ cname ⸴ a1_5 ⸴ a2_5 ⸴ a3_5 ⸴ a4_5 ⸴ a5_5⦆ ·
                            left_call ← c5 ·
                        ⟧
                    ⟧
                ⟧
            ⟧
        ⟧
        int64 next_tok ↦ close_p ⊕ 1 ·
        int64 next_code ↦ token_kind_code⦅next_tok⦆ ·
        when next_code ≡ 13 ∨ next_code ≡ 14 ∨ next_code ≡ 15 ∨ next_code ≡ 16 ∨ next_code ≡ 17 ∨ next_code ≡ 18 ∨ next_code ≡ 19 ⟦
            text c_op ↦ token_literal⦅next_tok⦆ ·
            CoreAst c_right ↦ ast_int_lit⦅0⦆ ·
            int64 is_r_call ↦ 0 ·
            when token_kind_code⦅next_tok ⊕ 2⦆ ≡ 22 ⟦
                is_r_call ← 1 ·
            ⟧
            when is_r_call ≡ 1 ⟦
                c_right ← parse_expression⦅next_tok ⊕ 1⦆ ·
                yield parse_binary_op⦅c_op ⸴ left_call ⸴ c_right⦆ ·
            ⟧ otherwise ⟦
                c_right ← parse_primary⦅next_tok ⊕ 1⦆ ·
                CoreAst cmp_res ↦ parse_binary_op⦅c_op ⸴ left_call ⸴ c_right⦆ ·
                int64 log_tok ↦ next_tok ⊕ 2 ·
                int64 log_code ↦ token_kind_code⦅log_tok⦆ ·
                when log_code ≡ 38 ∨ log_code ≡ 39 ⟦
                    text log_op ↦ token_literal⦅log_tok⦆ ·
                    CoreAst log_right ↦ parse_expression⦅log_tok ⊕ 1⦆ ·
                    yield parse_binary_op⦅log_op ⸴ cmp_res ⸴ log_right⦆ ·
                ⟧
                yield cmp_res ·
            ⟧
        ⟧
        yield left_call ·
    ⟧

    when kcode ≡ 36 ⟦
        text rname ↦ token_literal⦅idx ⊕ 1⦆ ·
        yield ast_record_init⦅rname ⸴ 4⦆ ·
    ⟧
    when kcode ≡ 37 ⟦
        text vname ↦ token_literal⦅idx ⊕ 1⦆ ·
        text cname_vi ↦ token_literal⦅idx ⊕ 3⦆ ·
        CoreAst pld ↦ parse_primary⦅idx ⊕ 5⦆ ·
        yield ast_variant_init⦅vname ⸴ cname_vi ⸴ pld⦆ ·
    ⟧
    when kcode ≡ 2 ∧ token_kind_code⦅idx ⊕ 1⦆ ≡ 30 ⟦
        text oname ↦ token_literal⦅idx⦆ ·
        text fname ↦ token_literal⦅idx ⊕ 2⦆ ·
        yield ast_field_access⦅oname ⸴ fname⦆ ·
    ⟧
    CoreAst left ↦ parse_primary⦅idx⦆ ·
    int64 op_code ↦ token_kind_code⦅idx ⊕ 1⦆ ·
    when op_code ≡ 13 ∨ op_code ≡ 14 ∨ op_code ≡ 15 ∨ op_code ≡ 16 ∨ op_code ≡ 17 ∨ op_code ≡ 18 ∨ op_code ≡ 19 ⟦
        text op ↦ token_literal⦅idx ⊕ 1⦆ ·
        int64 p1 ↦ get_tok_precedence⦅op_code ⸴ op⦆ ·
        int64 op2_code ↦ token_kind_code⦅idx ⊕ 3⦆ ·
        int64 is_op2 ↦ 0 ·
        when op2_code ≡ 13 ∨ op2_code ≡ 14 ∨ op2_code ≡ 15 ∨ op2_code ≡ 16 ∨ op2_code ≡ 17 ∨ op2_code ≡ 18 ∨ op2_code ≡ 19 ⟦
            is_op2 ← 1 ·
        ⟧
        int64 cur_pos ↦ idx ⊕ 3 ·
        CoreAst r_first ↦ parse_primary⦅idx ⊕ 2⦆ ·
        when is_op2 ≡ 1 ⟦
            text op2 ↦ token_literal⦅idx ⊕ 3⦆ ·
            int64 p2 ↦ get_tok_precedence⦅op2_code ⸴ op2⦆ ·
            when p2 ≻ p1 ⟦
                CoreAst r_second ↦ parse_primary⦅idx ⊕ 4⦆ ·
                CoreAst right_bin ↦ parse_binary_op⦅op2 ⸴ r_first ⸴ r_second⦆ ·
                left ← parse_binary_op⦅op ⸴ left ⸴ right_bin⦆ ·
                cur_pos ← idx ⊕ 5 ·
            ⟧ otherwise ⟦
                CoreAst left_bin ↦ parse_binary_op⦅op ⸴ left ⸴ r_first⦆ ·
                CoreAst next_r ↦ parse_primary⦅idx ⊕ 4⦆ ·
                left ← parse_binary_op⦅op2 ⸴ left_bin ⸴ next_r⦆ ·
                cur_pos ← idx ⊕ 5 ·
            ⟧
        ⟧ otherwise ⟦
            left ← parse_binary_op⦅op ⸴ left ⸴ r_first⦆ ·
            cur_pos ← idx ⊕ 3 ·
        ⟧
        int64 is_log ↦ token_kind_code⦅cur_pos⦆ ·
        cycle is_log ≡ 38 ∨ is_log ≡ 39 ⟦
            text lop ↦ token_literal⦅cur_pos⦆ ·
            int64 is_call_r ↦ 0 ·
            when token_kind_code⦅cur_pos ⊕ 2⦆ ≡ 22 ⟦
                is_call_r ← 1 ·
            ⟧
            when is_call_r ≡ 1 ⟦
                text cname_c ↦ token_literal⦅cur_pos ⊕ 1⦆ ·
                int64 close_p_c ↦ cur_pos ⊕ 2 ·
                cycle token_kind_code⦅close_p_c⦆ ≠ 23 ⟦
                    close_p_c ← close_p_c ⊕ 1 ·
                ⟧
                CoreAst arg_c ↦ parse_expression⦅cur_pos ⊕ 3⦆ ·
                CoreAst r_left_c ↦ ast_call1⦅cname_c ⸴ arg_c⦆ ·
                text r_op_c ↦ token_literal⦅close_p_c ⊕ 1⦆ ·
                CoreAst r_right_c ↦ parse_primary⦅close_p_c ⊕ 2⦆ ·
                CoreAst r_cmp_c ↦ parse_binary_op⦅r_op_c ⸴ r_left_c ⸴ r_right_c⦆ ·
                left ← parse_binary_op⦅lop ⸴ left ⸴ r_cmp_c⦆ ·
                cur_pos ← close_p_c ⊕ 3 ·
            ⟧ otherwise ⟦
                CoreAst r_left_p ↦ parse_primary⦅cur_pos ⊕ 1⦆ ·
                text r_op_p ↦ token_literal⦅cur_pos ⊕ 2⦆ ·
                CoreAst r_right_p ↦ parse_primary⦅cur_pos ⊕ 3⦆ ·
                CoreAst r_cmp_p ↦ parse_binary_op⦅r_op_p ⸴ r_left_p ⸴ r_right_p⦆ ·
                left ← parse_binary_op⦅lop ⸴ left ⸴ r_cmp_p⦆ ·
                cur_pos ← cur_pos ⊕ 4 ·
            ⟧
            is_log ← token_kind_code⦅cur_pos⦆ ·
        ⟧
    ⟧
    yield left ·
⟧

process parse_bind⦅text name ⸴ text typ ⸴ CoreAst val⦆ → CoreAst ⟦
    yield ast_bind⦅name ⸴ typ ⸴ val⦆ ·
⟧

process parse_assign⦅text name ⸴ CoreAst val⦆ → CoreAst ⟦
    yield ast_assign⦅name ⸴ val⦆ ·
⟧

process parse_yield⦅CoreAst val⦆ → CoreAst ⟦
    yield ast_yield⦅val⦆ ·
⟧

process parse_emit⦅CoreAst val⦆ → CoreAst ⟦
    yield ast_emit⦅val⦆ ·
⟧

process parse_when⦅CoreAst cond ⸴ CoreAst then_b ⸴ CoreAst else_b⦆ → CoreAst ⟦
    yield ast_when⦅cond ⸴ then_b ⸴ else_b⦆ ·
⟧

process find_stmt_end⦅int64 start_idx ⸴ int64 max_idx⦆ → int64 ⟦
    int64 kcode ↦ token_kind_code⦅start_idx⦆ ·
    int64 cur ↦ start_idx ·
    when kcode ≡ 6 ⟦
        cur ← cur ⊕ 1 ·
        cycle cur ≺ max_idx ∧ token_kind_code⦅cur⦆ ≠ 20 ⟦
            cur ← cur ⊕ 1 ·
        ⟧
        cur ← cur ⊕ 1 ·
        int64 depth_w ↦ 1 ·
        cycle cur ≺ max_idx ∧ depth_w ≻ 0 ⟦
            int64 kc_w ↦ token_kind_code⦅cur⦆ ·
            when kc_w ≡ 20 ⟦ depth_w ← depth_w ⊕ 1 · ⟧
            when kc_w ≡ 21 ⟦ depth_w ← depth_w ⊖ 1 · ⟧
            when depth_w ≻ 0 ⟦ cur ← cur ⊕ 1 · ⟧
        ⟧
        cur ← cur ⊕ 1 ·
        when cur ≺ max_idx ∧ token_kind_code⦅cur⦆ ≡ 7 ⟦
            cur ← cur ⊕ 1 ·
            cycle cur ≺ max_idx ∧ token_kind_code⦅cur⦆ ≠ 20 ⟦
                cur ← cur ⊕ 1 ·
            ⟧
            cur ← cur ⊕ 1 ·
            int64 depth_e ↦ 1 ·
            cycle cur ≺ max_idx ∧ depth_e ≻ 0 ⟦
                int64 kc_e ↦ token_kind_code⦅cur⦆ ·
                when kc_e ≡ 20 ⟦ depth_e ← depth_e ⊕ 1 · ⟧
                when kc_e ≡ 21 ⟦ depth_e ← depth_e ⊖ 1 · ⟧
                when depth_e ≻ 0 ⟦ cur ← cur ⊕ 1 · ⟧
            ⟧
            cur ← cur ⊕ 1 ·
        ⟧
        yield cur ·
    ⟧
    when kcode ≡ 10 ⟦
        cur ← cur ⊕ 1 ·
        cycle cur ≺ max_idx ∧ token_kind_code⦅cur⦆ ≠ 20 ⟦
            cur ← cur ⊕ 1 ·
        ⟧
        cur ← cur ⊕ 1 ·
        int64 depth_c ↦ 1 ·
        cycle cur ≺ max_idx ∧ depth_c ≻ 0 ⟦
            int64 kc_c ↦ token_kind_code⦅cur⦆ ·
            when kc_c ≡ 20 ⟦ depth_c ← depth_c ⊕ 1 · ⟧
            when kc_c ≡ 21 ⟦ depth_c ← depth_c ⊖ 1 · ⟧
            when depth_c ≻ 0 ⟦ cur ← cur ⊕ 1 · ⟧
        ⟧
        cur ← cur ⊕ 1 ·
        yield cur ·
    ⟧
    when kcode ≡ 33 ⟦
        cur ← cur ⊕ 1 ·
        cycle cur ≺ max_idx ∧ token_kind_code⦅cur⦆ ≠ 20 ⟦
            cur ← cur ⊕ 1 ·
        ⟧
        cur ← cur ⊕ 1 ·
        int64 depth_m ↦ 1 ·
        cycle cur ≺ max_idx ∧ depth_m ≻ 0 ⟦
            int64 kc_m ↦ token_kind_code⦅cur⦆ ·
            when kc_m ≡ 20 ⟦ depth_m ← depth_m ⊕ 1 · ⟧
            when kc_m ≡ 21 ⟦ depth_m ← depth_m ⊖ 1 · ⟧
            when depth_m ≻ 0 ⟦ cur ← cur ⊕ 1 · ⟧
        ⟧
        cur ← cur ⊕ 1 ·
        yield cur ·
    ⟧
    int64 depth ↦ 0 ·
    cycle cur ≺ max_idx ⟦
        int64 c_code ↦ token_kind_code⦅cur⦆ ·
        when c_code ≡ 20 ⟦
            depth ← depth ⊕ 1 ·
        ⟧
        when c_code ≡ 21 ⟦
            depth ← depth ⊖ 1 ·
            when depth ≡ 0 ⟦
                cur ← cur ⊕ 1 ·
                yield cur ·
            ⟧
        ⟧
        when c_code ≡ 24 ∧ depth ≡ 0 ⟦
            cur ← cur ⊕ 1 ·
            yield cur ·
        ⟧
        cur ← cur ⊕ 1 ·
    ⟧
    yield cur ·
⟧

process parse_match⦅int64 cur_idx⦆ → CoreAst ⟦
    text msubj ↦ token_literal⦅cur_idx ⊕ 1⦆ ·
    int64 cur_pos ↦ cur_idx ⊕ 2 ·
    cycle token_kind_code⦅cur_pos⦆ ≠ 20 ⟦
        cur_pos ← cur_pos ⊕ 1 ·
    ⟧
    cur_pos ← cur_pos ⊕ 1 ·
    CoreAst chain ↦ ast_int_lit⦅0⦆ ·
    int64 first_arm ↦ 1 ·
    int64 total_toks ↦ token_count⦅⦆ ·

    cycle token_kind_code⦅cur_pos⦆ ≠ 21 ∧ cur_pos ≺ total_toks ⟦
        when token_kind_code⦅cur_pos⦆ ≡ 34 ⟦
            cur_pos ← cur_pos ⊕ 1 ·
        ⟧
        text cname ↦ token_literal⦅cur_pos⦆ ·
        int64 case_tag ↦ get_variant_case_tag⦅"" ⸴ cname⦆ ·
        cur_pos ← cur_pos ⊕ 1 ·

        int64 has_bindings ↦ 0 ·
        CoreAst b_chain ↦ ast_int_lit⦅0⦆ ·
        int64 first_b ↦ 1 ·
        when token_kind_code⦅cur_pos⦆ ≡ 22 ⟦
            cur_pos ← cur_pos ⊕ 1 ·
            int64 b_idx ↦ 0 ·
            cycle token_kind_code⦅cur_pos⦆ ≠ 23 ∧ cur_pos ≺ total_toks ⟦
                when token_kind_code⦅cur_pos⦆ ≡ 25 ⟦
                    cur_pos ← cur_pos ⊕ 1 ·
                ⟧ otherwise ⟦
                    text bname ↦ token_literal⦅cur_pos⦆ ·
                    cur_pos ← cur_pos ⊕ 1 ·
                    int64 is_ptr ↦ is_variant_field_ptr⦅cname ⸴ b_idx⦆ ·
                    CoreAst b_idx_ast ↦ ast_int_lit⦅b_idx⦆ ·
                    CoreAst subj_ast ↦ ast_ident⦅msubj⦆ ·
                    CoreAst b_val ↦ ast_int_lit⦅0⦆ ·
                    text b_type ↦ "int64" ·
                    when is_ptr ≡ 1 ⟦
                        b_type ← "text" ·
                        b_val ← ast_call2⦅"qadav_variant_get_field_ptr_wrap" ⸴ subj_ast ⸴ b_idx_ast⦆ ·
                    ⟧ otherwise ⟦
                        b_type ← "int64" ·
                        b_val ← ast_call2⦅"qadav_variant_get_field_i64_wrap" ⸴ subj_ast ⸴ b_idx_ast⦆ ·
                    ⟧
                    CoreAst one_bind ↦ ast_bind⦅bname ⸴ b_type ⸴ b_val⦆ ·
                    when first_b ≡ 1 ⟦
                        b_chain ← one_bind ·
                        first_b ← 0 ·
                    ⟧ otherwise ⟦
                        b_chain ← ast_block⦅b_chain ⸴ one_bind⦆ ·
                    ⟧
                    has_bindings ← 1 ·
                    b_idx ← b_idx ⊕ 1 ·
                ⟧
            ⟧
            when token_kind_code⦅cur_pos⦆ ≡ 23 ⟦
                cur_pos ← cur_pos ⊕ 1 ·
            ⟧
        ⟧

        when token_kind_code⦅cur_pos⦆ ≡ 35 ⟦
            cur_pos ← cur_pos ⊕ 1 ·
        ⟧

        int64 body_start ↦ cur_pos ·
        int64 arm_depth ↦ 1 ·
        cycle cur_pos ≺ total_toks ∧ arm_depth ≻ 0 ⟦
            int64 kc_b ↦ token_kind_code⦅cur_pos⦆ ·
            when kc_b ≡ 20 ⟦
                arm_depth ← arm_depth ⊕ 1 ·
            ⟧
            when kc_b ≡ 21 ⟦
                arm_depth ← arm_depth ⊖ 1 ·
            ⟧
            when kc_b ≡ 34 ∧ arm_depth ≡ 1 ⟦
                arm_depth ← 0 ·
            ⟧
            when arm_depth ≻ 0 ⟦
                cur_pos ← cur_pos ⊕ 1 ·
            ⟧
        ⟧
        int64 body_end ↦ cur_pos ·
        CoreAst arm_body ↦ parse_statement_list⦅body_start ⸴ body_end⦆ ·

        CoreAst arm_block ↦ arm_body ·
        when has_bindings ≡ 1 ⟦
            arm_block ← ast_block⦅b_chain ⸴ arm_body⦆ ·
        ⟧

        CoreAst s_ident ↦ ast_ident⦅msubj⦆ ·
        CoreAst tag_call ↦ ast_call1⦅"qadav_variant_get_tag" ⸴ s_ident⦆ ·
        CoreAst tag_lit ↦ ast_int_lit⦅case_tag⦆ ·
        CoreAst cond ↦ ast_binop⦅"≡" ⸴ tag_call ⸴ tag_lit⦆ ·

        CoreAst when_arm ↦ ast_when1⦅cond ⸴ arm_block⦆ ·
        when first_arm ≡ 1 ⟦
            chain ← when_arm ·
            first_arm ← 0 ·
        ⟧ otherwise ⟦
            chain ← ast_block⦅chain ⸴ when_arm⦆ ·
        ⟧
    ⟧
    when token_kind_code⦅cur_pos⦆ ≡ 21 ⟦
        cur_pos ← cur_pos ⊕ 1 ·
    ⟧
    yield ast_match⦅msubj ⸴ chain⦆ ·
⟧

process parse_statement⦅int64 cur_idx⦆ → CoreAst ⟦
    int64 is_cust ↦ is_custom_statement⦅cur_idx⦆ ·
    when is_cust ≡ 1 ⟦
        yield ast_custom_stmt⦅cur_idx⦆ ·
    ⟧
    int64 kcode ↦ token_kind_code⦅cur_idx⦆ ·

    // WHEN
    when kcode ≡ 6 ⟦
        CoreAst cond ↦ parse_expression⦅cur_idx ⊕ 1⦆ ·
        int64 scan_w ↦ cur_idx ⊕ 1 ·
        cycle token_kind_code⦅scan_w⦆ ≠ 20 ⟦
            scan_w ← scan_w ⊕ 1 ·
        ⟧
        int64 then_start ↦ scan_w ⊕ 1 ·
        int64 cur ↦ then_start ·
        int64 depth ↦ 1 ·
        cycle depth ≻ 0 ⟦
            int64 kc ↦ token_kind_code⦅cur⦆ ·
            when kc ≡ 20 ⟦ depth ← depth ⊕ 1 · ⟧
            when kc ≡ 21 ⟦ depth ← depth ⊖ 1 · ⟧
            when depth ≻ 0 ⟦ cur ← cur ⊕ 1 · ⟧
        ⟧
        int64 then_end ↦ cur ·
        CoreAst then_b ↦ parse_statement_list⦅then_start ⸴ then_end⦆ ·

        int64 after_then ↦ cur ⊕ 1 ·
        when token_kind_code⦅after_then⦆ ≡ 7 ⟦
            int64 else_scan ↦ after_then ⊕ 1 ·
            cycle token_kind_code⦅else_scan⦆ ≠ 20 ⟦
                else_scan ← else_scan ⊕ 1 ·
            ⟧
            int64 else_start ↦ else_scan ⊕ 1 ·
            int64 cur_e ↦ else_start ·
            int64 depth_e ↦ 1 ·
            cycle depth_e ≻ 0 ⟦
                int64 kc_e ↦ token_kind_code⦅cur_e⦆ ·
                when kc_e ≡ 20 ⟦ depth_e ← depth_e ⊕ 1 · ⟧
                when kc_e ≡ 21 ⟦ depth_e ← depth_e ⊖ 1 · ⟧
                when depth_e ≻ 0 ⟦ cur_e ← cur_e ⊕ 1 · ⟧
            ⟧
            int64 else_end ↦ cur_e ·
            CoreAst else_b ↦ parse_statement_list⦅else_start ⸴ else_end⦆ ·
            yield ast_when⦅cond ⸴ then_b ⸴ else_b⦆ ·
        ⟧
        yield ast_when1⦅cond ⸴ then_b⦆ ·
    ⟧

    // BIND: type name ↦ val ·
    when kcode ≡ 26 ∨ token_kind_code⦅cur_idx ⊕ 2⦆ ≡ 11 ⟦
        text typ ↦ token_literal⦅cur_idx⦆ ·
        int64 is_tens ↦ is_tensor_type⦅typ⦆ ·
        when is_tens ≡ 1 ⟦
            int64 scan_b ↦ cur_idx ·
            cycle token_kind_code⦅scan_b⦆ ≠ 11 ⟦
                scan_b ← scan_b ⊕ 1 ·
            ⟧
            text t_name ↦ token_literal⦅scan_b ⊖ 1⦆ ·
            register_var_type⦅t_name ⸴ "tensor"⦆ ·
            int64 t_idx ↦ 0 ·
            int64 is_y ↦ is_var_y⦅t_name⦆ ·
            when is_y ≡ 1 ⟦
                t_idx ← 1 ·
            ⟧
            yield ast_bind⦅t_name ⸴ "tensor" ⸴ ast_tensor⦅t_idx ⸴ 3⦆⦆ ·
        ⟧

        text name ↦ token_literal⦅cur_idx ⊕ 1⦆ ·
        register_var_type⦅name ⸴ typ⦆ ·
        int64 val_start ↦ cur_idx ⊕ 3 ·
        CoreAst expr ↦ parse_expression⦅val_start⦆ ·
        yield ast_bind⦅name ⸴ typ ⸴ expr⦆ ·
    ⟧

    // ASSIGN: name ← val ·
    when kcode ≡ 2 ∧ token_kind_code⦅cur_idx ⊕ 1⦆ ≡ 12 ⟦
        text aname ↦ token_literal⦅cur_idx⦆ ·
        CoreAst aval ↦ parse_expression⦅cur_idx ⊕ 2⦆ ·
        yield ast_assign⦅aname ⸴ aval⦆ ·
    ⟧

    // EMIT: emit val ·
    when kcode ≡ 9 ⟦
        CoreAst eval ↦ parse_expression⦅cur_idx ⊕ 1⦆ ·
        yield ast_emit⦅eval⦆ ·
    ⟧

    // YIELD: yield val ·
    when kcode ≡ 8 ⟦
        CoreAst yval ↦ parse_expression⦅cur_idx ⊕ 1⦆ ·
        yield ast_yield⦅yval⦆ ·
    ⟧

    // MATCH: match subject ⟦ arms ⟧
    when kcode ≡ 33 ⟦
        CoreAst m ↦ parse_match⦅cur_idx⦆ ·
        yield m ·
    ⟧

    // CYCLE: cycle cond ⟦ body ⟧
    when kcode ≡ 10 ⟦
        CoreAst ccond ↦ parse_expression⦅cur_idx ⊕ 1⦆ ·
        int64 scan_c ↦ cur_idx ⊕ 1 ·
        cycle token_kind_code⦅scan_c⦆ ≠ 20 ⟦
            scan_c ← scan_c ⊕ 1 ·
        ⟧
        int64 cbody_start ↦ scan_c ⊕ 1 ·
        int64 cur_c ↦ cbody_start ·
        int64 depth_c ↦ 1 ·
        cycle depth_c ≻ 0 ⟦
            int64 kc_c ↦ token_kind_code⦅cur_c⦆ ·
            when kc_c ≡ 20 ⟦ depth_c ← depth_c ⊕ 1 · ⟧
            when kc_c ≡ 21 ⟦ depth_c ← depth_c ⊖ 1 · ⟧
            when depth_c ≻ 0 ⟦ cur_c ← cur_c ⊕ 1 · ⟧
        ⟧
        int64 cbody_end ↦ cur_c ·
        CoreAst cbody ↦ parse_statement_list⦅cbody_start ⸴ cbody_end⦆ ·
        yield ast_cycle⦅ccond ⸴ cbody⦆ ·
    ⟧

    when kcode ≡ 2 ∧ token_kind_code⦅cur_idx ⊕ 1⦆ ≡ 22 ⟦
        CoreAst e ↦ parse_expression⦅cur_idx⦆ ·
        CoreAst stmt ↦ variant_init CoreAst ⦅ExprStmt ↦ e⦆ ·
        yield stmt ·
    ⟧

    yield ast_int_lit⦅0⦆ ·
⟧

process parse_statement_list⦅int64 cur_idx ⸴ int64 end_idx⦆ → CoreAst ⟦
    when cur_idx ≽ end_idx ⟦
        yield ast_int_lit⦅0⦆ ·
    ⟧
    int64 next_idx ↦ find_stmt_end⦅cur_idx ⸴ end_idx⦆ ·
    CoreAst s ↦ parse_statement⦅cur_idx⦆ ·
    when next_idx ≽ end_idx ⟦
        yield s ·
    ⟧
    CoreAst rest ↦ parse_statement_list⦅next_idx ⸴ end_idx⦆ ·
    yield ast_block⦅s ⸴ rest⦆ ·
⟧

process parse_process⦅int64 start_idx ⸴ int64 end_idx⦆ → CoreAst ⟦
    text proc_name ↦ token_literal⦅start_idx ⊕ 1⦆ ·

    // Find GROUP_OPEN (22) and GROUP_CLOSE (23)
    int64 g_open ↦ start_idx ·
    cycle g_open ≺ end_idx ∧ token_kind_code⦅g_open⦆ ≠ 22 ⟦
        g_open ← g_open ⊕ 1 ·
    ⟧
    int64 g_close ↦ g_open ·
    cycle g_close ≺ end_idx ∧ token_kind_code⦅g_close⦆ ≠ 23 ⟦
        g_close ← g_close ⊕ 1 ·
    ⟧

    int64 pcount ↦ 0 ·
    text p1_name ↦ "" ·
    text p2_name ↦ "" ·

    when g_close ≻ g_open ⊕ 1 ⟦
        int64 sep_idx ↦ 0 ⊖ 1 ·
        int64 scan_p ↦ g_open ⊕ 1 ·
        cycle scan_p ≺ g_close ⟦
            when token_kind_code⦅scan_p⦆ ≡ 25 ⟦
                sep_idx ← scan_p ·
            ⟧
            scan_p ← scan_p ⊕ 1 ·
        ⟧
        when sep_idx ≻ 0 ⟦
            pcount ← 2 ·
            p1_name ← token_literal⦅sep_idx ⊖ 1⦆ ·
            p2_name ← token_literal⦅g_close ⊖ 1⦆ ·
        ⟧ otherwise ⟦
            pcount ← 1 ·
            p1_name ← token_literal⦅g_close ⊖ 1⦆ ·
        ⟧
    ⟧

    int64 cur ↦ g_close ·
    cycle cur ≺ end_idx ∧ token_kind_code⦅cur⦆ ≠ 28 ⟦
        cur ← cur ⊕ 1 ·
    ⟧
    text ret_type ↦ "int64" ·
    when cur ≺ end_idx ⟦
        ret_type ← token_literal⦅cur ⊕ 1⦆ ·
    ⟧

    cycle cur ≺ end_idx ∧ token_kind_code⦅cur⦆ ≠ 20 ⟦
        cur ← cur ⊕ 1 ·
    ⟧
    int64 b_start ↦ cur ⊕ 1 ·
    int64 b_end ↦ end_idx ⊖ 1 ·

    CoreAst body ↦ parse_statement_list⦅b_start ⸴ b_end⦆ ·

    when pcount ≡ 2 ⟦
        yield ast_proc2⦅proc_name ⸴ p1_name ⸴ p2_name ⸴ ret_type ⸴ body⦆ ·
    ⟧
    yield ast_proc⦅proc_name ⸴ p1_name ⸴ ret_type ⸴ body⦆ ·
⟧

process parse_process_list⦅int64 cur_idx ⸴ int64 num_toks⦆ → CoreAst ⟦
    int64 p_start ↦ cur_idx ·
    cycle p_start ≺ num_toks ∧ token_kind_code⦅p_start⦆ ≠ 1 ⟦
        p_start ← p_start ⊕ 1 ·
    ⟧
    when p_start ≽ num_toks ⟦
        yield ast_int_lit⦅0⦆ ·
    ⟧
    int64 p_next ↦ p_start ⊕ 1 ·
    cycle p_next ≺ num_toks ∧ token_kind_code⦅p_next⦆ ≠ 1 ⟦
        p_next ← p_next ⊕ 1 ·
    ⟧
    CoreAst proc ↦ parse_process⦅p_start ⸴ p_next⦆ ·
    when p_next ≽ num_toks ⟦
        yield proc ·
    ⟧
    CoreAst rest ↦ parse_process_list⦅p_next ⸴ num_toks⦆ ·
    yield ast_block⦅proc ⸴ rest⦆ ·
⟧

process parse_program⦅int64 num_toks⦆ → CoreAst ⟦
    yield parse_process_list⦅0 ⸴ num_toks⦆ ·
⟧

process parse_to_core_ast⦅text file_path⦆ → CoreAst ⟦
    int64 num_toks ↦ tokenize_file⦅file_path⦆ ·
    CoreAst prog ↦ parse_program⦅num_toks⦆ ·
    yield prog ·
⟧

// ============================================================================

process walk_core_ast⦅CoreAst target_node ⸴ int64 temp_counter⦆ → int64 ⟦
    match target_node ⟦
        | ProcessDecl(name ⸴ param_name ⸴ ret_type ⸴ body) ⟹
            when temp_counter ≡ 1 ⟦
                emit "" ·
                emit "declare i32 @qadav_pcc_attest(i8*, i8*, i8*)" ·
                emit "declare i32 @qadav_pcc_verify()" ·
                emit "declare i32 @qadav_pcc_corrupt(i32)" ·
                emit_dynamic_io_decls⦅⦆ ·
                reset_label_counter⦅⦆ ·
                int64 scount ↦ str_table_count⦅⦆ ·
                int64 si ↦ 0 ·
                cycle si ≺ scount ⟦
                    text sdef ↦ str_table_def⦅si⦆ ·
                    emit sdef ·
                    si ← si ⊕ 1 ·
                ⟧
                int64 t_cnt ↦ get_tensor_count⦅⦆ ·
                int64 ti ↦ 0 ·
                cycle ti ≺ t_cnt ⟦
                    int64 tsz ↦ get_tensor_size⦅ti⦆ ·
                    text sh_line ↦ format_shape_const⦅ti ⸴ tsz⦆ ·
                    emit sh_line ·
                    ti ← ti ⊕ 1 ·
                ⟧
                emit "" ·
            ⟧
            int64 is_m_proc ↦ is_main_proc⦅name⦆ ·
            when is_m_proc ≡ 1 ⟦
                set_proc_is_main⦅1⦆ ·
                set_proc_is_dot⦅0⦆ ·
                emit "define i32 @\"main\"() {" ·
                emit "entry:" ·
            ⟧ otherwise ⟦
                set_proc_is_main⦅0⦆ ·
                int64 is_d_proc ↦ is_dot_proc⦅name⦆ ·
                when is_d_proc ≡ 1 ⟦
                    set_proc_is_dot⦅1⦆ ·
                    text fdef_dot ↦ format_func_def_dot⦅name⦆ ·
                    emit fdef_dot ·
                    emit "entry:" ·
                    emit "  %a.ptr = alloca i8*" ·
                    emit "  store i8* %a.in, i8** %a.ptr" ·
                    emit "  %b.ptr = alloca i8*" ·
                    emit "  store i8* %b.in, i8** %b.ptr" ·
                ⟧ otherwise ⟦
                    set_proc_is_dot⦅0⦆ ·
                    emit_proc_header⦅name ⸴ ret_type ⸴ param_name⦆ ·
                ⟧
            ⟧
            int64 t_proc ↦ walk_core_ast⦅body ⸴ temp_counter⦆ ·
            int64 is_term_proc ↦ get_is_terminated⦅⦆ ·
            when is_term_proc ≡ 0 ⟦
                int64 is_m_term ↦ get_proc_is_main⦅⦆ ·
                when is_m_term ≡ 1 ⟦
                    emit "  ret i32 0" ·
                ⟧ otherwise ⟦
                    text def_ret ↦ format_ret_type⦅ret_type ⸴ 0⦆ ·
                    emit def_ret ·
                ⟧
            ⟧
            emit "}" ·
            emit "" ·
            yield t_proc ·
        | Process2Decl(name ⸴ p1 ⸴ p2 ⸴ ret_type ⸴ body) ⟹
            when temp_counter ≡ 1 ⟦
                emit "" ·
                emit "declare i32 @qadav_pcc_attest(i8*, i8*, i8*)" ·
                emit "declare i32 @qadav_pcc_verify()" ·
                emit "declare i32 @qadav_pcc_corrupt(i32)" ·
                emit_dynamic_io_decls⦅⦆ ·
                reset_label_counter⦅⦆ ·
                int64 scount2 ↦ str_table_count⦅⦆ ·
                int64 si2 ↦ 0 ·
                cycle si2 ≺ scount2 ⟦
                    text sdef2 ↦ str_table_def⦅si2⦆ ·
                    emit sdef2 ·
                    si2 ← si2 ⊕ 1 ·
                ⟧
                int64 t_cnt2 ↦ get_tensor_count⦅⦆ ·
                int64 ti2 ↦ 0 ·
                cycle ti2 ≺ t_cnt2 ⟦
                    int64 tsz2 ↦ get_tensor_size⦅ti2⦆ ·
