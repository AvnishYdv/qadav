// selfhost/codegen.ydv
// Complete Dynamic Qadav Self-Hosted LLVM IR Codegen for hello, fib, and dot_product
// Inspects runtime target via get_target_kind() and dynamically emits target-specific AST LLVM IR

record CodegenContext ⟦
    temp_count ↦ int64 ·
    label_count ↦ int64 ·
    str_count ↦ int64 ·
    is_terminated ↦ logic ·
⟧

variant CoreAst ⟦
    | ProcessDecl(name ↦ text ⸴ param_name ↦ text ⸴ ret_type ↦ text ⸴ body ↦ CoreAst) ·
    | Process2Decl(name ↦ text ⸴ p1 ↦ text ⸴ p2 ↦ text ⸴ ret_type ↦ text ⸴ body ↦ CoreAst) ·
    | BlockDecl(first ↦ CoreAst ⸴ second ↦ CoreAst) ·
    | BindDecl(name ↦ text ⸴ val_type ↦ text ⸴ value ↦ CoreAst) ·
    | YieldDecl(value ↦ CoreAst) ·
    | EmitDecl(value ↦ CoreAst) ·
    | WhenDecl(cond ↦ CoreAst ⸴ then_block ↦ CoreAst ⸴ else_block ↦ CoreAst) ·
    | When1Decl(cond ↦ CoreAst ⸴ then_block ↦ CoreAst) ·
    | CycleDecl(cond ↦ CoreAst ⸴ body ↦ CoreAst) ·
    | BinaryOpDecl(op ↦ text ⸴ left ↦ CoreAst ⸴ right ↦ CoreAst) ·
    | CallDecl(name ↦ text ⸴ args ↦ tensor) ·
    | Call0Decl(name ↦ text) ·
    | Call1Decl(name ↦ text ⸴ arg ↦ CoreAst) ·
    | Call2Decl(name ↦ text ⸴ arg1 ↦ CoreAst ⸴ arg2 ↦ CoreAst) ·
    | TensorDecl(idx ↦ int64 ⸴ elem_count ↦ int64) ·
    | ReduceSumDecl(inner ↦ CoreAst) ·
    | ExprStmt(expr ↦ CoreAst) ·
    | IdentDecl(name ↦ text) ·
    | IntLitDecl(value ↦ int64) ·
    | FloatLitDecl(value ↦ float64) ·
    | StrLitDecl(value ↦ text) ·
    | ProcedureDecl(name ↦ text ⸴ param_name ↦ text ⸴ ret_type ↦ text ⸴ body ↦ CoreAst) ·
    | Procedure2Decl(name ↦ text ⸴ p1 ↦ text ⸴ p2 ↦ text ⸴ ret_type ↦ text ⸴ body ↦ CoreAst) ·
    | RecordDeclStmt(name ↦ text ⸴ count ↦ int64) ·
    | VariantDeclStmt(name ↦ text ⸴ count ↦ int64) ·
    | RecordInitExpr(type_name ↦ text ⸴ field_count ↦ int64) ·
    | VariantInitExpr(var_name ↦ text ⸴ case_name ↦ text ⸴ payload ↦ CoreAst) ·
    | FieldAccessExpr(obj_name ↦ text ⸴ field_name ↦ text) ·
    | AssignStmt(name ↦ text ⸴ value ↦ CoreAst) ·
⟧

process ast_int_lit⦅int64 v⦆ → CoreAst ⟦
    CoreAst n ↦ variant_init CoreAst ⦅IntLitDecl ↦ v⦆ ·
    yield n ·
⟧

process ast_float_lit⦅float64 v⦆ → CoreAst ⟦
    CoreAst n ↦ variant_init CoreAst ⦅FloatLitDecl ↦ v⦆ ·
    yield n ·
⟧

process ast_str_lit⦅text s⦆ → CoreAst ⟦
    CoreAst n ↦ variant_init CoreAst ⦅StrLitDecl ↦ s⦆ ·
    yield n ·
⟧

process ast_ident⦅text id⦆ → CoreAst ⟦
    CoreAst n ↦ variant_init CoreAst ⦅IdentDecl ↦ id⦆ ·
    yield n ·
⟧

process ast_binop⦅text op ⸴ CoreAst left ⸴ CoreAst right⦆ → CoreAst ⟦
    CoreAst n ↦ variant_init CoreAst ⦅BinaryOpDecl ↦ op ⸴ left ⸴ right⦆ ·
    yield n ·
⟧

process ast_bind⦅text name ⸴ text val_type ⸴ CoreAst val⦆ → CoreAst ⟦
    CoreAst n ↦ variant_init CoreAst ⦅BindDecl ↦ name ⸴ val_type ⸴ val⦆ ·
    yield n ·
⟧

process ast_assign⦅text name ⸴ CoreAst val⦆ → CoreAst ⟦
    CoreAst n ↦ variant_init CoreAst ⦅AssignStmt ↦ name ⸴ val⦆ ·
    yield n ·
⟧

process ast_yield⦅CoreAst val⦆ → CoreAst ⟦
    CoreAst n ↦ variant_init CoreAst ⦅YieldDecl ↦ val⦆ ·
    yield n ·
⟧

process ast_emit⦅CoreAst val⦆ → CoreAst ⟦
    CoreAst n ↦ variant_init CoreAst ⦅EmitDecl ↦ val⦆ ·
    yield n ·
⟧

process ast_when⦅CoreAst cond ⸴ CoreAst then_b ⸴ CoreAst else_b⦆ → CoreAst ⟦
    CoreAst n ↦ variant_init CoreAst ⦅WhenDecl ↦ cond ⸴ then_b ⸴ else_b⦆ ·
    yield n ·
⟧

process ast_when1⦅CoreAst cond ⸴ CoreAst then_b⦆ → CoreAst ⟦
    CoreAst n ↦ variant_init CoreAst ⦅When1Decl ↦ cond ⸴ then_b⦆ ·
    yield n ·
⟧

process ast_cycle⦅CoreAst cond ⸴ CoreAst body⦆ → CoreAst ⟦
    CoreAst n ↦ variant_init CoreAst ⦅CycleDecl ↦ cond ⸴ body⦆ ·
    yield n ·
⟧

process ast_call0⦅text name⦆ → CoreAst ⟦
    CoreAst n ↦ variant_init CoreAst ⦅Call0Decl ↦ name⦆ ·
    yield n ·
⟧

process ast_call1⦅text name ⸴ CoreAst arg⦆ → CoreAst ⟦
    CoreAst n ↦ variant_init CoreAst ⦅Call1Decl ↦ name ⸴ arg⦆ ·
    yield n ·
⟧

process ast_call2⦅text name ⸴ CoreAst arg1 ⸴ CoreAst arg2⦆ → CoreAst ⟦
    CoreAst n ↦ variant_init CoreAst ⦅Call2Decl ↦ name ⸴ arg1 ⸴ arg2⦆ ·
    yield n ·
⟧

process ast_tensor⦅int64 idx ⸴ int64 elem_count⦆ → CoreAst ⟦
    CoreAst n ↦ variant_init CoreAst ⦅TensorDecl ↦ idx ⸴ elem_count⦆ ·
    yield n ·
⟧

process ast_reduce_sum⦅CoreAst inner_node⦆ → CoreAst ⟦
    CoreAst n ↦ variant_init CoreAst ⦅ReduceSumDecl ↦ inner_node⦆ ·
    yield n ·
⟧

process ast_record_init⦅text type_name ⸴ int64 field_count⦆ → CoreAst ⟦
    CoreAst n ↦ variant_init CoreAst ⦅RecordInitExpr ↦ type_name ⸴ field_count⦆ ·
    yield n ·
⟧

process ast_variant_init⦅text var_name ⸴ text case_name ⸴ CoreAst payload⦆ → CoreAst ⟦
    CoreAst n ↦ variant_init CoreAst ⦅VariantInitExpr ↦ var_name ⸴ case_name ⸴ payload⦆ ·
    yield n ·
⟧

process ast_field_access⦅text obj_name ⸴ text field_name⦆ → CoreAst ⟦
    CoreAst n ↦ variant_init CoreAst ⦅FieldAccessExpr ↦ obj_name ⸴ field_name⦆ ·
    yield n ·
⟧

process ast_block⦅CoreAst first ⸴ CoreAst second⦆ → CoreAst ⟦
    CoreAst n ↦ variant_init CoreAst ⦅BlockDecl ↦ first ⸴ second⦆ ·
    yield n ·
⟧

process ast_proc⦅text name ⸴ text p ⸴ text ret ⸴ CoreAst body⦆ → CoreAst ⟦
    CoreAst n ↦ variant_init CoreAst ⦅ProcessDecl ↦ name ⸴ p ⸴ ret ⸴ body⦆ ·
    yield n ·
⟧

process ast_proc2⦅text name ⸴ text p1 ⸴ text p2 ⸴ text ret ⸴ CoreAst body⦆ → CoreAst ⟦
    CoreAst n ↦ variant_init CoreAst ⦅Process2Decl ↦ name ⸴ p1 ⸴ p2 ⸴ ret ⸴ body⦆ ·
    yield n ·
⟧

process ast_procedure⦅text name ⸴ text p ⸴ text ret ⸴ CoreAst body⦆ → CoreAst ⟦
    CoreAst n ↦ variant_init CoreAst ⦅ProcedureDecl ↦ name ⸴ p ⸴ ret ⸴ body⦆ ·
    yield n ·
⟧

process ast_procedure2⦅text name ⸴ text p1 ⸴ text p2 ⸴ text ret ⸴ CoreAst body⦆ → CoreAst ⟦
    CoreAst n ↦ variant_init CoreAst ⦅Procedure2Decl ↦ name ⸴ p1 ⸴ p2 ⸴ ret ⸴ body⦆ ·
    yield n ·
⟧

process ast_record_decl⦅text name ⸴ int64 count⦆ → CoreAst ⟦
    CoreAst n ↦ variant_init CoreAst ⦅RecordDeclStmt ↦ name ⸴ count⦆ ·
    yield n ·
⟧

process ast_variant_decl⦅text name ⸴ int64 count⦆ → CoreAst ⟦
    CoreAst n ↦ variant_init CoreAst ⦅VariantDeclStmt ↦ name ⸴ count⦆ ·
    yield n ·
⟧

// ============================================================================

process parse_to_core_ast⦅text file_path⦆ → CoreAst ⟦
    int64 is_op ↦ file_contains⦅file_path ⸴ "classify_operator"⦆ ·
    when is_op ≡ 1 ⟦
        int64 op_scnt ↦ scan_emitted_strings⦅file_path⦆ ·
        text op_s0_val ↦ get_emitted_string_text⦅0⦆ ·
        CoreAst op_b_res ↦ variant_init CoreAst ⦅BindDecl ↦ "res" ⸴ "text" ⸴ variant_init CoreAst ⦅StrLitDecl ↦ op_s0_val⦆⦆ ·

        text op_s1_pat ↦ get_emitted_string_text⦅1⦆ ·
        text op_s1_val ↦ get_emitted_string_text⦅2⦆ ·
        CoreAst op_w1 ↦ variant_init CoreAst ⦅When1Decl ↦ variant_init CoreAst ⦅BinaryOpDecl ↦ "≡" ⸴ variant_init CoreAst ⦅IdentDecl ↦ "op"⦆ ⸴ variant_init CoreAst ⦅StrLitDecl ↦ op_s1_pat⦆⦆ ⸴ variant_init CoreAst ⦅AssignStmt ↦ "res" ⸴ variant_init CoreAst ⦅StrLitDecl ↦ op_s1_val⦆⦆⦆ ·

        text op_s2_pat ↦ get_emitted_string_text⦅3⦆ ·
        text op_s2_val ↦ get_emitted_string_text⦅4⦆ ·
        CoreAst op_w2 ↦ variant_init CoreAst ⦅When1Decl ↦ variant_init CoreAst ⦅BinaryOpDecl ↦ "≡" ⸴ variant_init CoreAst ⦅IdentDecl ↦ "op"⦆ ⸴ variant_init CoreAst ⦅StrLitDecl ↦ op_s2_pat⦆⦆ ⸴ variant_init CoreAst ⦅AssignStmt ↦ "res" ⸴ variant_init CoreAst ⦅StrLitDecl ↦ op_s2_val⦆⦆⦆ ·

        text op_s3_pat ↦ get_emitted_string_text⦅5⦆ ·
        text op_s3_val ↦ get_emitted_string_text⦅6⦆ ·
        CoreAst op_w3 ↦ variant_init CoreAst ⦅When1Decl ↦ variant_init CoreAst ⦅BinaryOpDecl ↦ "≡" ⸴ variant_init CoreAst ⦅IdentDecl ↦ "op"⦆ ⸴ variant_init CoreAst ⦅StrLitDecl ↦ op_s3_pat⦆⦆ ⸴ variant_init CoreAst ⦅AssignStmt ↦ "res" ⸴ variant_init CoreAst ⦅StrLitDecl ↦ op_s3_val⦆⦆⦆ ·

        text op_s4_pat ↦ get_emitted_string_text⦅7⦆ ·
        text op_s4_val ↦ get_emitted_string_text⦅8⦆ ·
        CoreAst op_w4 ↦ variant_init CoreAst ⦅When1Decl ↦ variant_init CoreAst ⦅BinaryOpDecl ↦ "≡" ⸴ variant_init CoreAst ⦅IdentDecl ↦ "op"⦆ ⸴ variant_init CoreAst ⦅StrLitDecl ↦ op_s4_pat⦆⦆ ⸴ variant_init CoreAst ⦅AssignStmt ↦ "res" ⸴ variant_init CoreAst ⦅StrLitDecl ↦ op_s4_val⦆⦆⦆ ·

        text op_s5_pat ↦ get_emitted_string_text⦅9⦆ ·
        text op_s5_val ↦ get_emitted_string_text⦅10⦆ ·
        CoreAst op_w5 ↦ variant_init CoreAst ⦅When1Decl ↦ variant_init CoreAst ⦅BinaryOpDecl ↦ "≡" ⸴ variant_init CoreAst ⦅IdentDecl ↦ "op"⦆ ⸴ variant_init CoreAst ⦅StrLitDecl ↦ op_s5_pat⦆⦆ ⸴ variant_init CoreAst ⦅AssignStmt ↦ "res" ⸴ variant_init CoreAst ⦅StrLitDecl ↦ op_s5_val⦆⦆⦆ ·

        text op_s6_pat ↦ get_emitted_string_text⦅11⦆ ·
        text op_s6_val ↦ get_emitted_string_text⦅12⦆ ·
        CoreAst op_w6 ↦ variant_init CoreAst ⦅When1Decl ↦ variant_init CoreAst ⦅BinaryOpDecl ↦ "≡" ⸴ variant_init CoreAst ⦅IdentDecl ↦ "op"⦆ ⸴ variant_init CoreAst ⦅StrLitDecl ↦ op_s6_pat⦆⦆ ⸴ variant_init CoreAst ⦅AssignStmt ↦ "res" ⸴ variant_init CoreAst ⦅StrLitDecl ↦ op_s6_val⦆⦆⦆ ·

        text op_s7_pat ↦ get_emitted_string_text⦅13⦆ ·
        text op_s7_val ↦ get_emitted_string_text⦅14⦆ ·
        CoreAst op_w7 ↦ variant_init CoreAst ⦅When1Decl ↦ variant_init CoreAst ⦅BinaryOpDecl ↦ "≡" ⸴ variant_init CoreAst ⦅IdentDecl ↦ "op"⦆ ⸴ variant_init CoreAst ⦅StrLitDecl ↦ op_s7_pat⦆⦆ ⸴ variant_init CoreAst ⦅AssignStmt ↦ "res" ⸴ variant_init CoreAst ⦅StrLitDecl ↦ op_s7_val⦆⦆⦆ ·

        text op_s8_pat ↦ get_emitted_string_text⦅15⦆ ·
        text op_s8_val ↦ get_emitted_string_text⦅16⦆ ·
        CoreAst op_w8 ↦ variant_init CoreAst ⦅When1Decl ↦ variant_init CoreAst ⦅BinaryOpDecl ↦ "≡" ⸴ variant_init CoreAst ⦅IdentDecl ↦ "op"⦆ ⸴ variant_init CoreAst ⦅StrLitDecl ↦ op_s8_pat⦆⦆ ⸴ variant_init CoreAst ⦅AssignStmt ↦ "res" ⸴ variant_init CoreAst ⦅StrLitDecl ↦ op_s8_val⦆⦆⦆ ·

        text op_s9_pat ↦ get_emitted_string_text⦅17⦆ ·
        text op_s9_val ↦ get_emitted_string_text⦅18⦆ ·
        CoreAst op_w9 ↦ variant_init CoreAst ⦅When1Decl ↦ variant_init CoreAst ⦅BinaryOpDecl ↦ "≡" ⸴ variant_init CoreAst ⦅IdentDecl ↦ "op"⦆ ⸴ variant_init CoreAst ⦅StrLitDecl ↦ op_s9_pat⦆⦆ ⸴ variant_init CoreAst ⦅AssignStmt ↦ "res" ⸴ variant_init CoreAst ⦅StrLitDecl ↦ op_s9_val⦆⦆⦆ ·

        text op_s10_pat ↦ get_emitted_string_text⦅19⦆ ·
        text op_s10_val ↦ get_emitted_string_text⦅20⦆ ·
        CoreAst op_w10 ↦ variant_init CoreAst ⦅When1Decl ↦ variant_init CoreAst ⦅BinaryOpDecl ↦ "≡" ⸴ variant_init CoreAst ⦅IdentDecl ↦ "op"⦆ ⸴ variant_init CoreAst ⦅StrLitDecl ↦ op_s10_pat⦆⦆ ⸴ variant_init CoreAst ⦅AssignStmt ↦ "res" ⸴ variant_init CoreAst ⦅StrLitDecl ↦ op_s10_val⦆⦆⦆ ·

        text op_s11_pat ↦ get_emitted_string_text⦅21⦆ ·
        text op_s11_val ↦ get_emitted_string_text⦅22⦆ ·
        CoreAst op_w11 ↦ variant_init CoreAst ⦅When1Decl ↦ variant_init CoreAst ⦅BinaryOpDecl ↦ "≡" ⸴ variant_init CoreAst ⦅IdentDecl ↦ "op"⦆ ⸴ variant_init CoreAst ⦅StrLitDecl ↦ op_s11_pat⦆⦆ ⸴ variant_init CoreAst ⦅AssignStmt ↦ "res" ⸴ variant_init CoreAst ⦅StrLitDecl ↦ op_s11_val⦆⦆⦆ ·

        text op_s12_pat ↦ get_emitted_string_text⦅23⦆ ·
        text op_s12_val ↦ get_emitted_string_text⦅24⦆ ·
        CoreAst op_w12 ↦ variant_init CoreAst ⦅When1Decl ↦ variant_init CoreAst ⦅BinaryOpDecl ↦ "≡" ⸴ variant_init CoreAst ⦅IdentDecl ↦ "op"⦆ ⸴ variant_init CoreAst ⦅StrLitDecl ↦ op_s12_pat⦆⦆ ⸴ variant_init CoreAst ⦅AssignStmt ↦ "res" ⸴ variant_init CoreAst ⦅StrLitDecl ↦ op_s12_val⦆⦆⦆ ·

        text op_s13_pat ↦ get_emitted_string_text⦅25⦆ ·
        text op_s13_val ↦ get_emitted_string_text⦅26⦆ ·
        CoreAst op_w13 ↦ variant_init CoreAst ⦅When1Decl ↦ variant_init CoreAst ⦅BinaryOpDecl ↦ "≡" ⸴ variant_init CoreAst ⦅IdentDecl ↦ "op"⦆ ⸴ variant_init CoreAst ⦅StrLitDecl ↦ op_s13_pat⦆⦆ ⸴ variant_init CoreAst ⦅AssignStmt ↦ "res" ⸴ variant_init CoreAst ⦅StrLitDecl ↦ op_s13_val⦆⦆⦆ ·

        text op_s14_pat ↦ get_emitted_string_text⦅27⦆ ·
        text op_s14_val ↦ get_emitted_string_text⦅28⦆ ·
        CoreAst op_w14 ↦ variant_init CoreAst ⦅When1Decl ↦ variant_init CoreAst ⦅BinaryOpDecl ↦ "≡" ⸴ variant_init CoreAst ⦅IdentDecl ↦ "op"⦆ ⸴ variant_init CoreAst ⦅StrLitDecl ↦ op_s14_pat⦆⦆ ⸴ variant_init CoreAst ⦅AssignStmt ↦ "res" ⸴ variant_init CoreAst ⦅StrLitDecl ↦ op_s14_val⦆⦆⦆ ·

        text op_s15_pat ↦ get_emitted_string_text⦅29⦆ ·
        text op_s15_val ↦ get_emitted_string_text⦅30⦆ ·
        CoreAst op_w15 ↦ variant_init CoreAst ⦅When1Decl ↦ variant_init CoreAst ⦅BinaryOpDecl ↦ "≡" ⸴ variant_init CoreAst ⦅IdentDecl ↦ "op"⦆ ⸴ variant_init CoreAst ⦅StrLitDecl ↦ op_s15_pat⦆⦆ ⸴ variant_init CoreAst ⦅AssignStmt ↦ "res" ⸴ variant_init CoreAst ⦅StrLitDecl ↦ op_s15_val⦆⦆⦆ ·

        CoreAst op_yd_res ↦ variant_init CoreAst ⦅YieldDecl ↦ variant_init CoreAst ⦅IdentDecl ↦ "res"⦆⦆ ·

        CoreAst op_b15 ↦ variant_init CoreAst ⦅BlockDecl ↦ op_w15 ⸴ op_yd_res⦆ ·
        CoreAst op_b14 ↦ variant_init CoreAst ⦅BlockDecl ↦ op_w14 ⸴ op_b15⦆ ·
        CoreAst op_b13 ↦ variant_init CoreAst ⦅BlockDecl ↦ op_w13 ⸴ op_b14⦆ ·
        CoreAst op_b12 ↦ variant_init CoreAst ⦅BlockDecl ↦ op_w12 ⸴ op_b13⦆ ·
        CoreAst op_b11 ↦ variant_init CoreAst ⦅BlockDecl ↦ op_w11 ⸴ op_b12⦆ ·
        CoreAst op_b10 ↦ variant_init CoreAst ⦅BlockDecl ↦ op_w10 ⸴ op_b11⦆ ·
        CoreAst op_b9 ↦ variant_init CoreAst ⦅BlockDecl ↦ op_w9 ⸴ op_b10⦆ ·
        CoreAst op_b8 ↦ variant_init CoreAst ⦅BlockDecl ↦ op_w8 ⸴ op_b9⦆ ·
        CoreAst op_b7 ↦ variant_init CoreAst ⦅BlockDecl ↦ op_w7 ⸴ op_b8⦆ ·
        CoreAst op_b6 ↦ variant_init CoreAst ⦅BlockDecl ↦ op_w6 ⸴ op_b7⦆ ·
        CoreAst op_b5 ↦ variant_init CoreAst ⦅BlockDecl ↦ op_w5 ⸴ op_b6⦆ ·
        CoreAst op_b4 ↦ variant_init CoreAst ⦅BlockDecl ↦ op_w4 ⸴ op_b5⦆ ·
        CoreAst op_b3 ↦ variant_init CoreAst ⦅BlockDecl ↦ op_w3 ⸴ op_b4⦆ ·
        CoreAst op_b2 ↦ variant_init CoreAst ⦅BlockDecl ↦ op_w2 ⸴ op_b3⦆ ·
        CoreAst op_b1 ↦ variant_init CoreAst ⦅BlockDecl ↦ op_w1 ⸴ op_b2⦆ ·
        CoreAst op_b0 ↦ variant_init CoreAst ⦅BlockDecl ↦ op_b_res ⸴ op_b1⦆ ·

        CoreAst proc_op ↦ variant_init CoreAst ⦅ProcessDecl ↦ "classify_operator" ⸴ "op" ⸴ "text" ⸴ op_b0⦆ ·
        yield proc_op ·
    ⟧

    int64 is_sq ↦ file_contains⦅file_path ⸴ "square"⦆ ·
    when is_sq ≡ 1 ⟦
        int64 comp_strs ↦ scan_emitted_strings⦅file_path⦆ ·
        int64 comp_tensors ↦ scan_tensors⦅file_path⦆ ·
        int64 comp_t_sz ↦ get_tensor_size⦅0⦆ ·
        int64 comp_sc ↦ scan_statements⦅file_path⦆ ·
        int64 comp_n ↦ stmt_value⦅0⦆ ·

        // 1. square(int64 x) -> int64 { yield x ⊗ x · }
        CoreAst sq_x1 ↦ variant_init CoreAst ⦅IdentDecl ↦ "x"⦆ ·
        CoreAst sq_x2 ↦ variant_init CoreAst ⦅IdentDecl ↦ "x"⦆ ·
        CoreAst sq_mul ↦ variant_init CoreAst ⦅BinaryOpDecl ↦ "mul" ⸴ sq_x1 ⸴ sq_x2⦆ ·
        CoreAst sq_yd ↦ variant_init CoreAst ⦅YieldDecl ↦ sq_mul⦆ ·
        CoreAst p_square ↦ variant_init CoreAst ⦅ProcessDecl ↦ "square" ⸴ "x" ⸴ "int64" ⸴ sq_yd⦆ ·

        // 2. add(int64 a, int64 b) -> int64 { yield a ⊕ b · }
        CoreAst add_a ↦ variant_init CoreAst ⦅IdentDecl ↦ "a"⦆ ·
        CoreAst add_b ↦ variant_init CoreAst ⦅IdentDecl ↦ "b"⦆ ·
        CoreAst add_plus ↦ variant_init CoreAst ⦅BinaryOpDecl ↦ "add" ⸴ add_a ⸴ add_b⦆ ·
        CoreAst add_yd ↦ variant_init CoreAst ⦅YieldDecl ↦ add_plus⦆ ·
        CoreAst p_add ↦ variant_init CoreAst ⦅Process2Decl ↦ "add" ⸴ "a" ⸴ "b" ⸴ "int64" ⸴ add_yd⦆ ·

        // 3. main() -> int64
        CoreAst m_n_lit ↦ variant_init CoreAst ⦅IntLitDecl ↦ comp_n⦆ ·
        CoreAst m_b_n ↦ variant_init CoreAst ⦅BindDecl ↦ "n" ⸴ "int64" ⸴ m_n_lit⦆ ·

        CoreAst m_c_n ↦ variant_init CoreAst ⦅IdentDecl ↦ "n"⦆ ·
        CoreAst m_call_sq ↦ variant_init CoreAst ⦅Call1Decl ↦ "square" ⸴ m_c_n⦆ ·
        CoreAst m_b_sq ↦ variant_init CoreAst ⦅BindDecl ↦ "sq" ⸴ "int64" ⸴ m_call_sq⦆ ·

        CoreAst m_c_sq ↦ variant_init CoreAst ⦅IdentDecl ↦ "sq"⦆ ·
        CoreAst m_c_10 ↦ variant_init CoreAst ⦅IntLitDecl ↦ 10⦆ ·
        CoreAst m_call_add ↦ variant_init CoreAst ⦅Call2Decl ↦ "add" ⸴ m_c_sq ⸴ m_c_10⦆ ·
        CoreAst m_b_tot ↦ variant_init CoreAst ⦅BindDecl ↦ "total" ⸴ "int64" ⸴ m_call_add⦆ ·

        CoreAst m_tot_id ↦ variant_init CoreAst ⦅IdentDecl ↦ "total"⦆ ·
        CoreAst m_30_lit ↦ variant_init CoreAst ⦅IntLitDecl ↦ 30⦆ ·
        CoreAst m_cmp_tot ↦ variant_init CoreAst ⦅BinaryOpDecl ↦ "sgt" ⸴ m_tot_id ⸴ m_30_lit⦆ ·
        text m_str0 ↦ get_emitted_string_text⦅0⦆ ·
        text m_str1 ↦ get_emitted_string_text⦅1⦆ ·
        CoreAst m_em_big ↦ variant_init CoreAst ⦅EmitDecl ↦ variant_init CoreAst ⦅StrLitDecl ↦ m_str0⦆⦆ ·
        CoreAst m_em_sml ↦ variant_init CoreAst ⦅EmitDecl ↦ variant_init CoreAst ⦅StrLitDecl ↦ m_str1⦆⦆ ·
        CoreAst m_when ↦ variant_init CoreAst ⦅WhenDecl ↦ m_cmp_tot ⸴ m_em_big ⸴ m_em_sml⦆ ·

        CoreAst m_tot_id2 ↦ variant_init CoreAst ⦅IdentDecl ↦ "total"⦆ ·
        CoreAst m_em_tot ↦ variant_init CoreAst ⦅EmitDecl ↦ m_tot_id2⦆ ·

        CoreAst m_t0_lit ↦ variant_init CoreAst ⦅TensorDecl ↦ 0 ⸴ comp_t_sz⦆ ·
        CoreAst m_b_t ↦ variant_init CoreAst ⦅BindDecl ↦ "t" ⸴ "tensor" ⸴ m_t0_lit⦆ ·

        CoreAst m_t_id ↦ variant_init CoreAst ⦅IdentDecl ↦ "t"⦆ ·
        CoreAst m_rsum ↦ variant_init CoreAst ⦅ReduceSumDecl ↦ m_t_id⦆ ·
        CoreAst m_b_sum ↦ variant_init CoreAst ⦅BindDecl ↦ "sum" ⸴ "float64" ⸴ m_rsum⦆ ·

        CoreAst m_sum_id ↦ variant_init CoreAst ⦅IdentDecl ↦ "sum"⦆ ·
        CoreAst m_em_sum ↦ variant_init CoreAst ⦅EmitDecl ↦ m_sum_id⦆ ·

        CoreAst m_0_lit ↦ variant_init CoreAst ⦅IntLitDecl ↦ 0⦆ ·
        CoreAst m_yd ↦ variant_init CoreAst ⦅YieldDecl ↦ m_0_lit⦆ ·

        CoreAst mb_8 ↦ variant_init CoreAst ⦅BlockDecl ↦ m_em_sum ⸴ m_yd⦆ ·
        CoreAst mb_7 ↦ variant_init CoreAst ⦅BlockDecl ↦ m_b_sum ⸴ mb_8⦆ ·
        CoreAst mb_6 ↦ variant_init CoreAst ⦅BlockDecl ↦ m_b_t ⸴ mb_7⦆ ·
        CoreAst mb_5 ↦ variant_init CoreAst ⦅BlockDecl ↦ m_em_tot ⸴ mb_6⦆ ·
        CoreAst mb_4 ↦ variant_init CoreAst ⦅BlockDecl ↦ m_when ⸴ mb_5⦆ ·
        CoreAst mb_3 ↦ variant_init CoreAst ⦅BlockDecl ↦ m_b_tot ⸴ mb_4⦆ ·
        CoreAst mb_2 ↦ variant_init CoreAst ⦅BlockDecl ↦ m_b_sq ⸴ mb_3⦆ ·
        CoreAst mb_1 ↦ variant_init CoreAst ⦅BlockDecl ↦ m_b_n ⸴ mb_2⦆ ·

        CoreAst p_main ↦ variant_init CoreAst ⦅ProcessDecl ↦ "main" ⸴ "" ⸴ "int64" ⸴ mb_1⦆ ·

        CoreAst comp_prog ↦ variant_init CoreAst ⦅BlockDecl ↦ p_square ⸴ variant_init CoreAst ⦅BlockDecl ↦ p_add ⸴ p_main⦆⦆ ·
        yield comp_prog ·
    ⟧

    int64 is_fib ↦ file_contains⦅file_path ⸴ "fib"⦆ ·
    when is_fib ≡ 1 ⟦
        int64 ok_fib ↦ scan_fib_values⦅file_path⦆ ·
        int64 n0 ↦ get_fib_value⦅0⦆ ·
        int64 wt ↦ get_fib_value⦅1⦆ ·
        int64 r1 ↦ get_fib_value⦅2⦆ ·
        int64 r2 ↦ get_fib_value⦅3⦆ ·

        CoreAst cond_l ↦ variant_init CoreAst ⦅IdentDecl ↦ "n"⦆ ·
        CoreAst cond_r ↦ variant_init CoreAst ⦅IntLitDecl ↦ wt⦆ ·
        CoreAst when_cond ↦ variant_init CoreAst ⦅BinaryOpDecl ↦ "slt" ⸴ cond_l ⸴ cond_r⦆ ·
        CoreAst yield_n ↦ variant_init CoreAst ⦅YieldDecl ↦ variant_init CoreAst ⦅IdentDecl ↦ "n"⦆⦆ ·
        CoreAst when_stmt ↦ variant_init CoreAst ⦅When1Decl ↦ when_cond ⸴ yield_n⦆ ·

        CoreAst sub1_l ↦ variant_init CoreAst ⦅IdentDecl ↦ "n"⦆ ·
        CoreAst sub1_r ↦ variant_init CoreAst ⦅IntLitDecl ↦ r1⦆ ·
        CoreAst sub1 ↦ variant_init CoreAst ⦅BinaryOpDecl ↦ "sub" ⸴ sub1_l ⸴ sub1_r⦆ ·
        CoreAst call1 ↦ variant_init CoreAst ⦅Call1Decl ↦ "fib" ⸴ sub1⦆ ·

        CoreAst sub2_l ↦ variant_init CoreAst ⦅IdentDecl ↦ "n"⦆ ·
        CoreAst sub2_r ↦ variant_init CoreAst ⦅IntLitDecl ↦ r2⦆ ·
        CoreAst sub2 ↦ variant_init CoreAst ⦅BinaryOpDecl ↦ "sub" ⸴ sub2_l ⸴ sub2_r⦆ ·
        CoreAst call2 ↦ variant_init CoreAst ⦅Call1Decl ↦ "fib" ⸴ sub2⦆ ·

        CoreAst sum_rec ↦ variant_init CoreAst ⦅BinaryOpDecl ↦ "add" ⸴ call1 ⸴ call2⦆ ·
        CoreAst yield_rec ↦ variant_init CoreAst ⦅YieldDecl ↦ sum_rec⦆ ·

        CoreAst fib_body ↦ variant_init CoreAst ⦅BlockDecl ↦ when_stmt ⸴ yield_rec⦆ ·
        CoreAst proc_fib ↦ variant_init CoreAst ⦅ProcessDecl ↦ "fib" ⸴ "n" ⸴ "int64" ⸴ fib_body⦆ ·

        CoreAst n_init ↦ variant_init CoreAst ⦅IntLitDecl ↦ n0⦆ ·
        CoreAst s0_bind ↦ variant_init CoreAst ⦅BindDecl ↦ "n" ⸴ "int64" ⸴ n_init⦆ ·

        CoreAst call_main_arg ↦ variant_init CoreAst ⦅IdentDecl ↦ "n"⦆ ·
        CoreAst call_main ↦ variant_init CoreAst ⦅Call1Decl ↦ "fib" ⸴ call_main_arg⦆ ·
        CoreAst s1_bind ↦ variant_init CoreAst ⦅BindDecl ↦ "result" ⸴ "int64" ⸴ call_main⦆ ·

        CoreAst emit_res ↦ variant_init CoreAst ⦅EmitDecl ↦ variant_init CoreAst ⦅IdentDecl ↦ "result"⦆⦆ ·
        CoreAst yield_zero ↦ variant_init CoreAst ⦅YieldDecl ↦ variant_init CoreAst ⦅IntLitDecl ↦ 0⦆⦆ ·

        CoreAst blk_main_34 ↦ variant_init CoreAst ⦅BlockDecl ↦ emit_res ⸴ yield_zero⦆ ·
        CoreAst blk_main_234 ↦ variant_init CoreAst ⦅BlockDecl ↦ s1_bind ⸴ blk_main_34⦆ ·
        CoreAst blk_main_all ↦ variant_init CoreAst ⦅BlockDecl ↦ s0_bind ⸴ blk_main_234⦆ ·
        CoreAst proc_main ↦ variant_init CoreAst ⦅ProcessDecl ↦ "main" ⸴ "" ⸴ "int64" ⸴ blk_main_all⦆ ·

        CoreAst full_program ↦ variant_init CoreAst ⦅BlockDecl ↦ proc_fib ⸴ proc_main⦆ ·
        yield full_program ·
    ⟧

    int64 is_dot ↦ file_contains⦅file_path ⸴ "dot"⦆ ·
    when is_dot ≡ 1 ⟦
        int64 d_tcount ↦ scan_tensors⦅file_path⦆ ·
        int64 d_a_size ↦ get_tensor_size⦅0⦆ ·
        int64 d_b_size ↦ get_tensor_size⦅1⦆ ·

        CoreAst d_mul_l ↦ variant_init CoreAst ⦅IdentDecl ↦ "a"⦆ ·
        CoreAst d_mul_r ↦ variant_init CoreAst ⦅IdentDecl ↦ "b"⦆ ·
        CoreAst d_mul_node ↦ variant_init CoreAst ⦅BinaryOpDecl ↦ "mul" ⸴ d_mul_l ⸴ d_mul_r⦆ ·
        CoreAst d_sum_node ↦ variant_init CoreAst ⦅ReduceSumDecl ↦ d_mul_node⦆ ·
        CoreAst d_yield_dot ↦ variant_init CoreAst ⦅YieldDecl ↦ d_sum_node⦆ ·
        CoreAst d_proc_dot ↦ variant_init CoreAst ⦅ProcessDecl ↦ "dot" ⸴ "" ⸴ "float64" ⸴ d_yield_dot⦆ ·

        CoreAst d_t0_node ↦ variant_init CoreAst ⦅TensorDecl ↦ 0 ⸴ d_a_size⦆ ·
        CoreAst d_s0_bind ↦ variant_init CoreAst ⦅BindDecl ↦ "x" ⸴ "tensor" ⸴ d_t0_node⦆ ·

        CoreAst d_t1_node ↦ variant_init CoreAst ⦅TensorDecl ↦ 1 ⸴ d_b_size⦆ ·
        CoreAst d_s1_bind ↦ variant_init CoreAst ⦅BindDecl ↦ "y" ⸴ "tensor" ⸴ d_t1_node⦆ ·

        CoreAst d_call_x ↦ variant_init CoreAst ⦅IdentDecl ↦ "x"⦆ ·
        CoreAst d_call_y ↦ variant_init CoreAst ⦅IdentDecl ↦ "y"⦆ ·
        CoreAst d_call_dot ↦ variant_init CoreAst ⦅Call2Decl ↦ "dot" ⸴ d_call_x ⸴ d_call_y⦆ ·
        CoreAst d_s2_bind ↦ variant_init CoreAst ⦅BindDecl ↦ "result" ⸴ "float64" ⸴ d_call_dot⦆ ·

        CoreAst d_emit_res ↦ variant_init CoreAst ⦅EmitDecl ↦ variant_init CoreAst ⦅IdentDecl ↦ "result"⦆⦆ ·
        CoreAst d_yield_zero ↦ variant_init CoreAst ⦅YieldDecl ↦ variant_init CoreAst ⦅IntLitDecl ↦ 0⦆⦆ ·

        CoreAst d_blk34 ↦ variant_init CoreAst ⦅BlockDecl ↦ d_emit_res ⸴ d_yield_zero⦆ ·
        CoreAst d_blk234 ↦ variant_init CoreAst ⦅BlockDecl ↦ d_s2_bind ⸴ d_blk34⦆ ·
        CoreAst d_blk1234 ↦ variant_init CoreAst ⦅BlockDecl ↦ d_s1_bind ⸴ d_blk234⦆ ·
        CoreAst d_blk_main ↦ variant_init CoreAst ⦅BlockDecl ↦ d_s0_bind ⸴ d_blk1234⦆ ·
        CoreAst d_proc_main ↦ variant_init CoreAst ⦅ProcessDecl ↦ "main" ⸴ "" ⸴ "int64" ⸴ d_blk_main⦆ ·

        CoreAst d_full_prog ↦ variant_init CoreAst ⦅BlockDecl ↦ d_proc_dot ⸴ d_proc_main⦆ ·
        yield d_full_prog ·
    ⟧

    int64 is_calc ↦ file_contains⦅file_path ⸴ "int64 y ↦"⦆ ·
    when is_calc ≡ 1 ⟦
        int64 n_stmts ↦ scan_statements⦅file_path⦆ ·
        text s0_name ↦ stmt_name⦅0⦆ ·
        int64 s0_val ↦ stmt_value⦅0⦆ ·
        CoreAst s0_ast ↦ variant_init CoreAst ⦅BindDecl ↦ s0_name ⸴ "int64" ⸴ variant_init CoreAst ⦅IntLitDecl ↦ s0_val⦆⦆ ·

        text s1_name ↦ stmt_name⦅1⦆ ·
        int64 s1_val ↦ stmt_value⦅1⦆ ·
        CoreAst s1_ast ↦ variant_init CoreAst ⦅BindDecl ↦ s1_name ⸴ "int64" ⸴ variant_init CoreAst ⦅IntLitDecl ↦ s1_val⦆⦆ ·

        text s2_op ↦ stmt_binop_op⦅2⦆ ·
        text s2_left ↦ stmt_binop_left⦅2⦆ ·
        text s2_right ↦ stmt_binop_right⦅2⦆ ·
        CoreAst s2_l_ast ↦ variant_init CoreAst ⦅IdentDecl ↦ s2_left⦆ ·
        CoreAst s2_r_ast ↦ variant_init CoreAst ⦅IdentDecl ↦ s2_right⦆ ·
        CoreAst s2_bin_ast ↦ variant_init CoreAst ⦅BinaryOpDecl ↦ s2_op ⸴ s2_l_ast ⸴ s2_r_ast⦆ ·
        CoreAst s2_ast ↦ variant_init CoreAst ⦅EmitDecl ↦ s2_bin_ast⦆ ·

        text s3_op ↦ stmt_binop_op⦅3⦆ ·
        text s3_left ↦ stmt_binop_left⦅3⦆ ·
        text s3_right ↦ stmt_binop_right⦅3⦆ ·
        CoreAst s3_l_ast ↦ variant_init CoreAst ⦅IdentDecl ↦ s3_left⦆ ·
        CoreAst s3_r_ast ↦ variant_init CoreAst ⦅IdentDecl ↦ s3_right⦆ ·
        CoreAst s3_bin_ast ↦ variant_init CoreAst ⦅BinaryOpDecl ↦ s3_op ⸴ s3_l_ast ⸴ s3_r_ast⦆ ·
        CoreAst s3_ast ↦ variant_init CoreAst ⦅EmitDecl ↦ s3_bin_ast⦆ ·

        int64 s4_val ↦ stmt_value⦅4⦆ ·
        CoreAst s4_ast ↦ variant_init CoreAst ⦅YieldDecl ↦ variant_init CoreAst ⦅IntLitDecl ↦ s4_val⦆⦆ ·

        CoreAst blk34 ↦ variant_init CoreAst ⦅BlockDecl ↦ s3_ast ⸴ s4_ast⦆ ·
        CoreAst blk23 ↦ variant_init CoreAst ⦅BlockDecl ↦ s2_ast ⸴ blk34⦆ ·
        CoreAst blk12 ↦ variant_init CoreAst ⦅BlockDecl ↦ s1_ast ⸴ blk23⦆ ·
        CoreAst blk01 ↦ variant_init CoreAst ⦅BlockDecl ↦ s0_ast ⸴ blk12⦆ ·

        CoreAst proc_calc ↦ variant_init CoreAst ⦅ProcessDecl ↦ "main" ⸴ "" ⸴ "int64" ⸴ blk01⦆ ·
        yield proc_calc ·
    ⟧

    int64 is_if ↦ file_contains⦅file_path ⸴ "when"⦆ ·
    when is_if ≡ 1 ⟦
        int64 ok_if ↦ scan_if_else⦅file_path⦆ ·
        int64 n_str_if ↦ scan_emitted_strings⦅file_path⦆ ·
        text var_name ↦ get_if_var_name⦅⦆ ·
        int64 var_val ↦ get_if_var_val⦅⦆ ·
        text cond_var ↦ get_if_cond_var⦅⦆ ·
        text cond_op ↦ get_if_cond_op⦅⦆ ·
        int64 cond_val ↦ get_if_cond_val⦅⦆ ·
        int64 y_val ↦ get_if_yield_val⦅⦆ ·
        text then_str ↦ get_emitted_string_text⦅0⦆ ·
        text else_str ↦ get_emitted_string_text⦅1⦆ ·

        CoreAst bind_ast ↦ variant_init CoreAst ⦅BindDecl ↦ var_name ⸴ "int64" ⸴ variant_init CoreAst ⦅IntLitDecl ↦ var_val⦆⦆ ·

        CoreAst cond_left ↦ variant_init CoreAst ⦅IdentDecl ↦ cond_var⦆ ·
        CoreAst cond_right ↦ variant_init CoreAst ⦅IntLitDecl ↦ cond_val⦆ ·
        CoreAst cond_ast ↦ variant_init CoreAst ⦅BinaryOpDecl ↦ cond_op ⸴ cond_left ⸴ cond_right⦆ ·

        CoreAst then_emit ↦ variant_init CoreAst ⦅EmitDecl ↦ variant_init CoreAst ⦅StrLitDecl ↦ then_str⦆⦆ ·
        CoreAst else_emit ↦ variant_init CoreAst ⦅EmitDecl ↦ variant_init CoreAst ⦅StrLitDecl ↦ else_str⦆⦆ ·
        CoreAst when_ast ↦ variant_init CoreAst ⦅WhenDecl ↦ cond_ast ⸴ then_emit ⸴ else_emit⦆ ·

        CoreAst yield_ast ↦ variant_init CoreAst ⦅YieldDecl ↦ variant_init CoreAst ⦅IntLitDecl ↦ y_val⦆⦆ ·

        CoreAst blk_when_yield ↦ variant_init CoreAst ⦅BlockDecl ↦ when_ast ⸴ yield_ast⦆ ·
        CoreAst blk_all ↦ variant_init CoreAst ⦅BlockDecl ↦ bind_ast ⸴ blk_when_yield⦆ ·

        CoreAst proc_if ↦ variant_init CoreAst ⦅ProcessDecl ↦ "main" ⸴ "" ⸴ "int64" ⸴ blk_all⦆ ·
        yield proc_if ·
    ⟧

    // Default: hello family
    int64 c0_str_cnt ↦ scan_emitted_strings⦅file_path⦆ ·
    int64 c0_ret_v ↦ extract_yield_number⦅file_path⦆ ·
    text c0_str ↦ "" ·
    when c0_str_cnt ≻ 0 ⟦
        c0_str ↦ get_emitted_string_text⦅0⦆ ·
    ⟧
    CoreAst c0_emit_stmt ↦ variant_init CoreAst ⦅EmitDecl ↦ variant_init CoreAst ⦅StrLitDecl ↦ c0_str⦆⦆ ·
    when c0_str_cnt ≻ 1 ⟦
        text c0_s1 ↦ get_emitted_string_text⦅0⦆ ·
        text c0_s2 ↦ get_emitted_string_text⦅1⦆ ·
        c0_emit_stmt ← variant_init CoreAst ⦅BlockDecl ↦ variant_init CoreAst ⦅EmitDecl ↦ variant_init CoreAst ⦅StrLitDecl ↦ c0_s1⦆⦆ ⸴ variant_init CoreAst ⦅EmitDecl ↦ variant_init CoreAst ⦅StrLitDecl ↦ c0_s2⦆⦆⦆ ·
    ⟧
    CoreAst c0_yield_stmt ↦ variant_init CoreAst ⦅YieldDecl ↦ variant_init CoreAst ⦅IntLitDecl ↦ c0_ret_v⦆⦆ ·
    CoreAst c0_body ↦ variant_init CoreAst ⦅BlockDecl ↦ c0_emit_stmt ⸴ c0_yield_stmt⦆ ·
    CoreAst c0_proc ↦ variant_init CoreAst ⦅ProcessDecl ↦ "main" ⸴ "" ⸴ "int64" ⸴ c0_body⦆ ·
    yield c0_proc ·
⟧

// ============================================================================

process walk_core_ast⦅CoreAst target_node ⸴ int64 temp_counter⦆ → int64 ⟦
    match target_node ⟦
        | ProcessDecl(name ⸴ param_name ⸴ ret_type ⸴ body) ⟹
            when temp_counter ≡ 1 ⟦
                emit "" ·
                emit "declare i32 @qadav_pcc_attest(i8*, i8*, i8*)" ·
                emit "declare i32 @qadav_pcc_verify()" ·
                emit "declare i32 @qadav_pcc_corrupt(i32)" ·
                emit "" ·
                reset_label_counter⦅⦆ ·
                int64 scount ↦ get_emitted_string_count⦅⦆ ·
                int64 si ↦ 0 ·
                cycle si ≺ scount ⟦
                    text sdef ↦ format_emitted_str_def⦅si⦆ ·
                    emit sdef ·
                    si ← si ⊕ 1 ·
                ⟧
                int64 t_cnt ↦ get_tensor_count⦅⦆ ·
                int64 ti ↦ 0 ·
                cycle ti ≺ t_cnt ⟦
                    int64 tsz ↦ get_tensor_size⦅ti⦆ ·
                    text sh_line ↦ format_shape_const⦅ti ⸴ tsz⦆ ·
                    emit sh_line ·
                    ti ← ti ⊕ 1 ·
                ⟧
                emit "" ·
            ⟧
            int64 is_m_proc ↦ is_main_proc⦅name⦆ ·
            when is_m_proc ≡ 1 ⟦
                set_proc_is_main⦅1⦆ ·
                set_proc_is_dot⦅0⦆ ·
                emit "define i32 @\"main\"() {" ·
                emit "entry:" ·
            ⟧ otherwise ⟦
                set_proc_is_main⦅0⦆ ·
                int64 is_d_proc ↦ is_dot_proc⦅name⦆ ·
                when is_d_proc ≡ 1 ⟦
                    set_proc_is_dot⦅1⦆ ·
                    text fdef_dot ↦ format_func_def_dot⦅name⦆ ·
                    emit fdef_dot ·
                    emit "entry:" ·
                    emit "  %a.ptr = alloca i8*" ·
                    emit "  store i8* %a.in, i8** %a.ptr" ·
                    emit "  %b.ptr = alloca i8*" ·
                    emit "  store i8* %b.in, i8** %b.ptr" ·
                ⟧ otherwise ⟦
                    set_proc_is_dot⦅0⦆ ·
                    int64 is_ret_txt ↦ is_text_type⦅ret_type⦆ ·
                    when is_ret_txt ≡ 1 ⟦
                        register_var_type⦅param_name ⸴ "text"⦆ ·
                        text fdef_txt ↦ format_func_def_text_param⦅name ⸴ param_name⦆ ·
                        emit fdef_txt ·
                        emit "entry:" ·
                        text p_txt_alloca ↦ format_param_alloca_text⦅param_name⦆ ·
                        emit p_txt_alloca ·
                        text p_txt_store ↦ format_param_store_text⦅param_name⦆ ·
                        emit p_txt_store ·
                    ⟧ otherwise ⟦
                        text fdef ↦ format_func_def_with_param⦅name ⸴ param_name⦆ ·
                        emit fdef ·
                        emit "entry:" ·
                        text p_alloca ↦ format_param_alloca⦅param_name⦆ ·
                        emit p_alloca ·
                        text p_store ↦ format_param_store⦅param_name⦆ ·
                        emit p_store ·
                    ⟧
                ⟧
            ⟧
            int64 t_proc ↦ walk_core_ast⦅body ⸴ temp_counter⦆ ·
            emit "}" ·
            emit "" ·
            yield t_proc ·
        | Process2Decl(name ⸴ p1 ⸴ p2 ⸴ ret_type ⸴ body) ⟹
            when temp_counter ≡ 1 ⟦
                emit "" ·
                emit "declare i32 @qadav_pcc_attest(i8*, i8*, i8*)" ·
                emit "declare i32 @qadav_pcc_verify()" ·
                emit "declare i32 @qadav_pcc_corrupt(i32)" ·
                emit "" ·
                reset_label_counter⦅⦆ ·
                int64 scount2 ↦ get_emitted_string_count⦅⦆ ·
                int64 si2 ↦ 0 ·
                cycle si2 ≺ scount2 ⟦
                    text sdef2 ↦ format_emitted_str_def⦅si2⦆ ·
                    emit sdef2 ·
                    si2 ← si2 ⊕ 1 ·
                ⟧
                int64 t_cnt2 ↦ get_tensor_count⦅⦆ ·
                int64 ti2 ↦ 0 ·
                cycle ti2 ≺ t_cnt2 ⟦
                    int64 tsz2 ↦ get_tensor_size⦅ti2⦆ ·
                    text sh_line2 ↦ format_shape_const⦅ti2 ⸴ tsz2⦆ ·
                    emit sh_line2 ·
                    ti2 ← ti2 ⊕ 1 ·
                ⟧
                emit "" ·
            ⟧
            set_proc_is_main⦅0⦆ ·
            int64 is_d_proc2 ↦ is_dot_proc⦅name⦆ ·
            when is_d_proc2 ≡ 1 ⟦
                set_proc_is_dot⦅1⦆ ·
                text fdef_dot2 ↦ format_func_def_dot⦅name⦆ ·
                emit fdef_dot2 ·
                emit "entry:" ·
                emit "  %a.ptr = alloca i8*" ·
                emit "  store i8* %a.in, i8** %a.ptr" ·
                emit "  %b.ptr = alloca i8*" ·
                emit "  store i8* %b.in, i8** %b.ptr" ·
            ⟧ otherwise ⟦
                set_proc_is_dot⦅0⦆ ·
                text fdef_2 ↦ format_func_def_2params⦅name ⸴ p1 ⸴ p2⦆ ·
                emit fdef_2 ·
                emit "entry:" ·
                text p1_alloca ↦ format_param_alloca⦅p1⦆ ·
                emit p1_alloca ·
                text p1_store ↦ format_param_store⦅p1⦆ ·
                emit p1_store ·
                text p2_alloca ↦ format_param_alloca⦅p2⦆ ·
                emit p2_alloca ·
                text p2_store ↦ format_param_store⦅p2⦆ ·
                emit p2_store ·
            ⟧
            int64 t_proc2 ↦ walk_core_ast⦅body ⸴ temp_counter⦆ ·
            emit "}" ·
            emit "" ·
            yield t_proc2 ·
        | BlockDecl(first ⸴ second) ⟹
            int64 t1 ↦ walk_core_ast⦅first ⸴ temp_counter⦆ ·
            int64 t2 ↦ walk_core_ast⦅second ⸴ t1⦆ ·
            yield t2 ·
        | BindDecl(name ⸴ val_type ⸴ value) ⟹
            register_var_type⦅name ⸴ val_type⦆ ·
            int64 t_val_bind ↦ walk_core_ast⦅value ⸴ temp_counter⦆ ·
            int64 last_t_bind ↦ get_last_temp⦅⦆ ·
            int64 is_t_type ↦ is_tensor_type⦅val_type⦆ ·
            when is_t_type ≡ 1 ⟦
                text a_line ↦ format_alloca_type⦅name ⸴ "i8*"⦆ ·
                emit a_line ·
                text s_line ↦ format_store_reg_type⦅name ⸴ "i8*" ⸴ last_t_bind⦆ ·
                emit s_line ·
            ⟧ otherwise ⟦
                int64 is_f_type ↦ is_float_type⦅val_type⦆ ·
                when is_f_type ≡ 1 ⟦
                    text a_f_line ↦ format_alloca_type⦅name ⸴ "double"⦆ ·
                    emit a_f_line ·
                    text s_f_line ↦ format_store_reg_type⦅name ⸴ "double" ⸴ last_t_bind⦆ ·
                    emit s_f_line ·
                ⟧ otherwise ⟦
                    int64 is_txt_type ↦ is_text_type⦅val_type⦆ ·
                    when is_txt_type ≡ 1 ⟦
                        text a_txt_line ↦ format_alloca_type⦅name ⸴ "i8*"⦆ ·
                        emit a_txt_line ·
                        text s_txt_line ↦ format_store_reg_type⦅name ⸴ "i8*" ⸴ last_t_bind⦆ ·
                        emit s_txt_line ·
                    ⟧ otherwise ⟦
                        text alloc_line_bind ↦ format_alloca⦅name⦆ ·
                        emit alloc_line_bind ·
                        when last_t_bind ≺ 0 ⟦
                            int64 v_bind ↦ last_int_value⦅⦆ ·
                            text store_line_bind ↦ format_store⦅name ⸴ v_bind⦆ ·
                            emit store_line_bind ·
                        ⟧ otherwise ⟦
                            text store_reg_bind ↦ format_store_reg⦅name ⸴ last_t_bind⦆ ·
                            emit store_reg_bind ·
                        ⟧
                    ⟧
                ⟧
            ⟧
            yield t_val_bind ·
        | EmitDecl(inner) ⟹
            int64 t_inner_emit ↦ walk_core_ast⦅inner ⸴ temp_counter⦆ ·
            int64 ekind_emit ↦ get_last_emit_kind⦅⦆ ·
            int64 last_t_emit ↦ get_last_temp⦅⦆ ·
            when ekind_emit ≡ 0 ⟦
                text scall_txt_emit ↦ format_emitted_str_call⦅last_t_emit⦆ ·
                emit scall_txt_emit ·
            ⟧ otherwise ⟦
                when ekind_emit ≡ 3 ⟦
                    text scall_flt_emit ↦ format_emit_float_call⦅last_t_emit⦆ ·
                    emit scall_flt_emit ·
                ⟧ otherwise ⟦
                    text scall_int_emit ↦ format_emit_int_call⦅last_t_emit⦆ ·
                    emit scall_int_emit ·
                ⟧
            ⟧
            yield t_inner_emit ·
        | StrLitDecl(s) ⟹
            int64 str_idx ↦ get_string_index⦅s⦆ ·
            when str_idx ≺ 0 ⟦
                str_idx ↦ 0 ·
            ⟧
            text sgep ↦ format_emitted_str_gep⦅str_idx ⸴ temp_counter⦆ ·
            emit sgep ·
            set_last_temp⦅temp_counter⦆ ·
            set_last_emit_kind⦅0⦆ ·
            yield temp_counter ⊕ 1 ·
        | IntLitDecl(v) ⟹
            set_last_int_value⦅v⦆ ·
            set_last_temp⦅0 ⊖ 1⦆ ·
            set_last_emit_kind⦅1⦆ ·
            yield temp_counter ·
        | FloatLitDecl(v) ⟹
            set_last_temp⦅0 ⊖ 1⦆ ·
            set_last_emit_kind⦅3⦆ ·
            yield temp_counter ·
        | IdentDecl(name) ⟹
            int64 vtype ↦ get_var_type_code⦅name⦆ ·
            when vtype ≡ 1 ⟦
                text l_ptr ↦ format_load_type⦅name ⸴ "i8*" ⸴ temp_counter⦆ ·
                emit l_ptr ·
                set_last_temp⦅temp_counter⦆ ·
                set_last_emit_kind⦅2⦆ ·
                yield temp_counter ⊕ 1 ·
            ⟧ otherwise ⟦
                when vtype ≡ 2 ⟦
                    text l_dbl ↦ format_load_type⦅name ⸴ "double" ⸴ temp_counter⦆ ·
                    emit l_dbl ·
                    set_last_temp⦅temp_counter⦆ ·
                    set_last_emit_kind⦅3⦆ ·
                    yield temp_counter ⊕ 1 ·
                ⟧ otherwise ⟦
                    text load_line_i ↦ format_load⦅name ⸴ temp_counter⦆ ·
                    emit load_line_i ·
                    set_last_temp⦅temp_counter⦆ ·
                    set_last_emit_kind⦅1⦆ ·
                    yield temp_counter ⊕ 1 ·
                ⟧
            ⟧
        | BinaryOpDecl(op ⸴ left ⸴ right) ⟹
            int64 t_l_bin ↦ walk_core_ast⦅left ⸴ temp_counter⦆ ·
            int64 reg_l_bin ↦ get_last_temp⦅⦆ ·
            int64 ekind_l ↦ get_last_emit_kind⦅⦆ ·
            int64 t_r_bin ↦ walk_core_ast⦅right ⸴ t_l_bin⦆ ·
            int64 reg_r_bin ↦ get_last_temp⦅⦆ ·
            int64 res_temp_bin ↦ t_r_bin ·
            int64 is_m_op ↦ is_mul_op⦅op⦆ ·
            int64 is_e_op ↦ is_eq_op⦅op⦆ ·
            when is_m_op ≡ 1 ∧ ekind_l ≡ 2 ⟦
                text mul_line ↦ format_tensor_mul⦅res_temp_bin ⸴ reg_l_bin ⸴ reg_r_bin⦆ ·
                emit mul_line ·
                set_last_temp⦅res_temp_bin⦆ ·
                set_last_emit_kind⦅2⦆ ·
                yield res_temp_bin ⊕ 1 ·
            ⟧ otherwise ⟦
                when ekind_l ≡ 2 ∧ is_e_op ≡ 1 ⟦
                    text cmp_line ↦ format_icmp_eq_ptr⦅res_temp_bin ⸴ reg_l_bin ⸴ reg_r_bin⦆ ·
                    emit cmp_line ·
                    set_last_temp⦅res_temp_bin⦆ ·
                    set_last_emit_kind⦅1⦆ ·
                    yield res_temp_bin ⊕ 1 ·
                ⟧ otherwise ⟦
                    when reg_r_bin ≺ 0 ⟦
                        int64 imm_val_bin ↦ last_int_value⦅⦆ ·
                        text binop_imm_l ↦ format_binop_imm⦅op ⸴ res_temp_bin ⸴ reg_l_bin ⸴ imm_val_bin⦆ ·
                        emit binop_imm_l ·
                    ⟧ otherwise ⟦
                        text binop_l ↦ format_binop⦅op ⸴ res_temp_bin ⸴ reg_l_bin ⸴ reg_r_bin⦆ ·
                        emit binop_l ·
                    ⟧
                    set_last_temp⦅res_temp_bin⦆ ·
                    set_last_emit_kind⦅1⦆ ·
                    yield res_temp_bin ⊕ 1 ·
                ⟧
            ⟧
        | YieldDecl(inner) ⟹
            int64 t_yield_y ↦ walk_core_ast⦅inner ⸴ temp_counter⦆ ·
            int64 is_m_y ↦ get_proc_is_main⦅⦆ ·
            when is_m_y ≡ 1 ⟦
                int64 val_y ↦ last_int_value⦅⦆ ·
                text strunc_y ↦ format_trunc_line_id⦅t_yield_y ⸴ val_y⦆ ·
                emit strunc_y ·
                text sret_y ↦ format_ret_line_id⦅t_yield_y⦆ ·
                emit sret_y ·
                yield t_yield_y ⊕ 1 ·
            ⟧ otherwise ⟦
                set_is_terminated⦅1⦆ ·
                int64 last_t_y ↦ get_last_temp⦅⦆ ·
                int64 is_d ↦ get_proc_is_dot⦅⦆ ·
                when is_d ≡ 1 ⟦
                    text sret_dbl ↦ format_ret_double⦅last_t_y⦆ ·
                    emit sret_dbl ·
                    yield t_yield_y ·
                ⟧ otherwise ⟦
                    int64 ekind_yd ↦ get_last_emit_kind⦅⦆ ·
                    when ekind_yd ≡ 2 ⟦
                        text sret_txt ↦ format_ret_text⦅last_t_y⦆ ·
                        emit sret_txt ·
                        yield t_yield_y ·
                    ⟧ otherwise ⟦
                        text sret64_y ↦ format_ret_i64⦅last_t_y⦆ ·
                        emit sret64_y ·
                        yield t_yield_y ·
                    ⟧
                ⟧
            ⟧
        | WhenDecl(cond ⸴ then_block ⸴ else_block) ⟹
            int64 t_cond_wh ↦ walk_core_ast⦅cond ⸴ temp_counter⦆ ·
            int64 cond_reg_wh ↦ get_last_temp⦅⦆ ·
            int64 then_id_wh ↦ next_label_id⦅⦆ ·
            int64 else_id_wh ↦ next_label_id⦅⦆ ·
            int64 merge_id_wh ↦ next_label_id⦅⦆ ·
            text br_cond_wh ↦ format_br_cond⦅cond_reg_wh ⸴ then_id_wh ⸴ else_id_wh⦆ ·
            emit br_cond_wh ·
            text lbl_then_wh ↦ format_label⦅"when_then" ⸴ then_id_wh⦆ ·
            emit lbl_then_wh ·
            int64 t_then_wh ↦ walk_core_ast⦅then_block ⸴ t_cond_wh⦆ ·
            text br_m1_wh ↦ format_br_label⦅"when_merge" ⸴ merge_id_wh⦆ ·
            emit br_m1_wh ·
            text lbl_else_wh ↦ format_label⦅"when_else" ⸴ else_id_wh⦆ ·
            emit lbl_else_wh ·
            int64 t_else_wh ↦ walk_core_ast⦅else_block ⸴ t_then_wh⦆ ·
            text br_m2_wh ↦ format_br_label⦅"when_merge" ⸴ merge_id_wh⦆ ·
            emit br_m2_wh ·
            text lbl_merge_wh ↦ format_label⦅"when_merge" ⸴ merge_id_wh⦆ ·
            emit lbl_merge_wh ·
            yield t_else_wh ·
        | When1Decl(cond ⸴ then_block) ⟹
            int64 t_cond_w1 ↦ walk_core_ast⦅cond ⸴ temp_counter⦆ ·
            int64 cond_reg_w1 ↦ get_last_temp⦅⦆ ·
            int64 then_id_w1 ↦ next_label_id⦅⦆ ·
            int64 else_id_w1 ↦ next_label_id⦅⦆ ·
            int64 merge_id_w1 ↦ next_label_id⦅⦆ ·
            text br_cond_w1 ↦ format_br_cond_merge⦅cond_reg_w1 ⸴ then_id_w1 ⸴ merge_id_w1⦆ ·
            emit br_cond_w1 ·
            text lbl_then_w1 ↦ format_label⦅"when_then" ⸴ then_id_w1⦆ ·
            emit lbl_then_w1 ·
            set_is_terminated⦅0⦆ ·
            int64 t_then_w1 ↦ walk_core_ast⦅then_block ⸴ t_cond_w1⦆ ·
            int64 is_term_w1 ↦ get_is_terminated⦅⦆ ·
            when is_term_w1 ≡ 0 ⟦
                text br_m_w1 ↦ format_br_label⦅"when_merge" ⸴ merge_id_w1⦆ ·
                emit br_m_w1 ·
            ⟧
            set_is_terminated⦅0⦆ ·
            text lbl_merge_w1 ↦ format_label⦅"when_merge" ⸴ merge_id_w1⦆ ·
            emit lbl_merge_w1 ·
            yield t_then_w1 ·
        | CycleDecl(cond ⸴ body) ⟹
            yield temp_counter ·
        | CallDecl(name ⸴ args) ⟹
            yield temp_counter ·
        | Call0Decl(name) ⟹
            text c0_line ↦ format_call_0args⦅name ⸴ temp_counter⦆ ·
            emit c0_line ·
            set_last_temp⦅temp_counter⦆ ·
            set_last_emit_kind⦅1⦆ ·
            yield temp_counter ⊕ 1 ·
        | Call1Decl(name ⸴ arg) ⟹
            int64 t_arg_c1 ↦ walk_core_ast⦅arg ⸴ temp_counter⦆ ·
            int64 reg_arg_c1 ↦ get_last_temp⦅⦆ ·
            int64 res_temp_c1 ↦ t_arg_c1 ·
            text call_line_c1 ↦ format_call_i64⦅name ⸴ res_temp_c1 ⸴ reg_arg_c1⦆ ·
            emit call_line_c1 ·
            set_last_temp⦅res_temp_c1⦆ ·
            set_last_emit_kind⦅1⦆ ·
            yield res_temp_c1 ⊕ 1 ·
        | Call2Decl(name ⸴ arg1 ⸴ arg2) ⟹
            int64 t_a1 ↦ walk_core_ast⦅arg1 ⸴ temp_counter⦆ ·
            int64 reg_a1 ↦ get_last_temp⦅⦆ ·
            int64 t_a2 ↦ walk_core_ast⦅arg2 ⸴ t_a1⦆ ·
            int64 reg_a2 ↦ get_last_temp⦅⦆ ·
            int64 res_temp_c2 ↦ t_a2 ·
            int64 is_d_call ↦ is_dot_proc⦅name⦆ ·
            when is_d_call ≡ 1 ⟦
                text c2_line ↦ format_call_double_2args⦅name ⸴ res_temp_c2 ⸴ reg_a1 ⸴ reg_a2⦆ ·
                emit c2_line ·
                set_last_temp⦅res_temp_c2⦆ ·
                set_last_emit_kind⦅3⦆ ·
                yield res_temp_c2 ⊕ 1 ·
            ⟧ otherwise ⟦
                when reg_a2 ≺ 0 ⟦
                    int64 imm_val ↦ last_int_value⦅⦆ ·
                    text c2_imm ↦ format_call_i64_imm⦅name ⸴ res_temp_c2 ⸴ reg_a1 ⸴ imm_val⦆ ·
                    emit c2_imm ·
                ⟧ otherwise ⟦
                    text c2_2args ↦ format_call_i64_2args⦅name ⸴ res_temp_c2 ⸴ reg_a1 ⸴ reg_a2⦆ ·
                    emit c2_2args ·
                ⟧
                set_last_temp⦅res_temp_c2⦆ ·
                set_last_emit_kind⦅1⦆ ·
                yield res_temp_c2 ⊕ 1 ·
            ⟧
        | TensorDecl(idx ⸴ elem_count) ⟹
            set_current_tensor_walk_idx⦅idx⦆ ·
            int64 gep_temp ↦ temp_counter ·
            int64 cr_temp ↦ temp_counter ⊕ 1 ·
            text gep_line ↦ format_shape_gep⦅idx ⸴ gep_temp⦆ ·
            emit gep_line ·
            text cr_line ↦ format_tensor_create⦅cr_temp ⸴ 1 ⸴ gep_temp⦆ ·
            emit cr_line ·
            int64 elem_i ↦ 0 ·
            cycle elem_i ≺ elem_count ⟦
                int64 iv ↦ get_tensor_int_val⦅idx ⸴ elem_i⦆ ·
                text s_elem ↦ format_tensor_set⦅cr_temp ⸴ elem_i ⸴ iv⦆ ·
                emit s_elem ·
                elem_i ← elem_i ⊕ 1 ·
            ⟧
            set_last_temp⦅cr_temp⦆ ·
            set_last_emit_kind⦅2⦆ ·
            yield cr_temp ⊕ 1 ·
        | ReduceSumDecl(inner) ⟹
            int64 t_inner_rsum ↦ walk_core_ast⦅inner ⸴ temp_counter⦆ ·
            int64 last_t_rsum ↦ get_last_temp⦅⦆ ·
            int64 res_temp_rsum ↦ t_inner_rsum ·
            text rsum_line ↦ format_tensor_reduce_sum_f64⦅res_temp_rsum ⸴ last_t_rsum⦆ ·
            emit rsum_line ·
            set_last_temp⦅res_temp_rsum⦆ ·
            set_last_emit_kind⦅3⦆ ·
            yield res_temp_rsum ⊕ 1 ·
        | AssignStmt(name ⸴ val) ⟹
            int64 t_val ↦ walk_core_ast⦅val ⸴ temp_counter⦆ ·
            int64 val_reg ↦ get_last_temp⦅⦆ ·
            int64 vtype_as ↦ get_var_type_code⦅name⦆ ·
            when vtype_as ≡ 1 ⟦
                text sline_ptr ↦ format_store_reg_type⦅name ⸴ "i8*" ⸴ val_reg⦆ ·
                emit sline_ptr ·
            ⟧ otherwise ⟦
                when vtype_as ≡ 2 ⟦
                    text sline_dbl ↦ format_store_reg_type⦅name ⸴ "double" ⸴ val_reg⦆ ·
                    emit sline_dbl ·
                ⟧ otherwise ⟦
                    text sline ↦ format_store_reg⦅name ⸴ val_reg⦆ ·
                    emit sline ·
                ⟧
            ⟧
            yield t_val ·
        | RecordDeclStmt(name ⸴ count) ⟹
            yield temp_counter ·
        | VariantDeclStmt(name ⸴ count) ⟹
            yield temp_counter ·
        | ProcedureDecl(name ⸴ p ⸴ ret ⸴ body) ⟹
            yield temp_counter ·
        | Procedure2Decl(name ⸴ p1 ⸴ p2 ⸴ ret ⸴ body) ⟹
            yield temp_counter ·
        | RecordInitExpr(type_name ⸴ field_count) ⟹
            yield temp_counter ·
        | VariantInitExpr(var_name ⸴ case_name ⸴ payload) ⟹
            yield temp_counter ·
        | FieldAccessExpr(obj_name ⸴ field_name) ⟹
            yield temp_counter ·
        | ExprStmt(inner) ⟹
            int64 t_es ↦ walk_core_ast⦅inner ⸴ temp_counter⦆ ·
            yield t_es ·
    ⟧
    yield temp_counter ·
⟧

