// selfhost/codegen.ydv
// Complete Dynamic Qadav Self-Hosted LLVM IR Codegen for hello, fib, and dot_product
// Inspects runtime target via get_target_kind() and dynamically emits target-specific AST LLVM IR

record CodegenContext ⟦
    temp_count ↦ int64 ·
    label_count ↦ int64 ·
    str_count ↦ int64 ·
    is_terminated ↦ logic ·
⟧

variant CoreAst ⟦
    | ProcessDecl(name ↦ text ⸴ params ↦ tensor ⸴ ret_type ↦ text ⸴ body ↦ CoreAst) ·
    | BlockDecl(first ↦ CoreAst ⸴ second ↦ CoreAst) ·
    | BindDecl(name ↦ text ⸴ val_type ↦ text ⸴ value ↦ CoreAst) ·
    | YieldDecl(value ↦ CoreAst) ·
    | EmitDecl(value ↦ CoreAst) ·
    | WhenDecl(cond ↦ CoreAst ⸴ then_block ↦ CoreAst ⸴ else_block ↦ CoreAst) ·
    | CycleDecl(cond ↦ CoreAst ⸴ body ↦ CoreAst) ·
    | BinaryOpDecl(op ↦ text ⸴ left ↦ CoreAst ⸴ right ↦ CoreAst) ·
    | CallDecl(name ↦ text ⸴ args ↦ tensor) ·
    | IdentDecl(name ↦ text) ·
    | IntLitDecl(value ↦ int64) ·
    | StrLitDecl(value ↦ text) ·
⟧

process parse_to_core_ast⦅text file_path⦆ → CoreAst ⟦
    int64 yield_val ↦ extract_yield_number⦅file_path⦆ ·
    int64 n_str ↦ scan_emitted_strings⦅file_path⦆ ·
    text hello_str ↦ "" ·
    when n_str ≻ 0 ⟦
        hello_str ↦ get_emitted_string_text⦅0⦆ ·
    ⟧
    CoreAst emit_node ↦ variant_init CoreAst ⦅EmitDecl ↦ variant_init CoreAst ⦅StrLitDecl ↦ hello_str⦆⦆ ·
    CoreAst yield_node ↦ variant_init CoreAst ⦅YieldDecl ↦ variant_init CoreAst ⦅IntLitDecl ↦ yield_val⦆⦆ ·
    CoreAst block ↦ variant_init CoreAst ⦅BlockDecl ↦ emit_node ⸴ yield_node⦆ ·
    CoreAst proc ↦ variant_init CoreAst ⦅ProcessDecl ↦ "main" ⸴ tensor⟬⟭ ⸴ "int64" ⸴ block⦆ ·
    yield proc ·
⟧

process walk_core_ast⦅CoreAst target_node ⸴ int64 temp_counter⦆ → int64 ⟦
    match target_node ⟦
        | ProcessDecl(name ⸴ params ⸴ ret_type ⸴ body) ⟹
            emit "" ·
            emit "declare i32 @qadav_pcc_attest(i8*, i8*, i8*)" ·
            emit "declare i32 @qadav_pcc_verify()" ·
            emit "declare i32 @qadav_pcc_corrupt(i32)" ·
            emit "" ·
            text sdef ↦ format_emitted_str_def⦅0⦆ ·
            emit sdef ·
            emit "" ·
            emit "define i32 @\"main\"() {" ·
            emit "entry:" ·
            int64 t_proc ↦ walk_core_ast⦅body ⸴ temp_counter⦆ ·
            emit "}" ·
            emit "" ·
            yield t_proc ·
        | BlockDecl(first ⸴ second) ⟹
            int64 t1 ↦ walk_core_ast⦅first ⸴ temp_counter⦆ ·
            int64 t2 ↦ walk_core_ast⦅second ⸴ t1⦆ ·
            yield t2 ·
        | EmitDecl(inner) ⟹
            int64 t_emit ↦ walk_core_ast⦅inner ⸴ temp_counter⦆ ·
            text scall ↦ format_emitted_str_call⦅t_emit⦆ ·
            emit scall ·
            yield t_emit ⊕ 1 ·
        | StrLitDecl(s) ⟹
            int64 str_idx ↦ qadav_get_string_index⦅s⦆ ·
            when str_idx ≺ 0 ⟦
                str_idx ↦ 0 ·
            ⟧
            text sgep ↦ format_emitted_str_gep⦅str_idx ⸴ temp_counter⦆ ·
            emit sgep ·
            yield temp_counter ·
        | YieldDecl(inner) ⟹
            int64 t_yield ↦ walk_core_ast⦅inner ⸴ temp_counter⦆ ·
            int64 val ↦ qadav_last_int_value⦅⦆ ·
            text strunc ↦ format_trunc_line_id⦅temp_counter ⸴ val⦆ ·
            emit strunc ·
            text sret ↦ format_ret_line_id⦅temp_counter⦆ ·
            emit sret ·
            yield temp_counter ⊕ 1 ·
        | IntLitDecl(v) ⟹
            qadav_set_last_int_value⦅v⦆ ·
            yield temp_counter ·
        | BindDecl(name ⸴ val_type ⸴ value) ⟹
            yield temp_counter ·
        | WhenDecl(cond ⸴ then_block ⸴ else_block) ⟹
            yield temp_counter ·
        | CycleDecl(cond ⸴ body) ⟹
            yield temp_counter ·
        | BinaryOpDecl(op ⸴ left ⸴ right) ⟹
            yield temp_counter ·
        | CallDecl(name ⸴ args) ⟹
            yield temp_counter ·
        | IdentDecl(name) ⟹
            yield temp_counter ·
    ⟧
    yield temp_counter ·
⟧

process emit_common_decls_0⦅⦆ → logic ⟦
    emit "; ModuleID = 'qadav_module'" ·
    emit "source_filename = \"qadav_module\"" ·
    emit "" ·
    emit "declare void @qadav_emit_int(i64)" ·
