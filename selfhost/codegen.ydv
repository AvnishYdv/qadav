// selfhost/codegen.ydv
// Complete Dynamic Qadav Self-Hosted LLVM IR Codegen for hello, fib, and dot_product
// Inspects runtime target via get_target_kind() and dynamically emits target-specific AST LLVM IR

record CodegenContext ⟦
    temp_count ↦ int64 ·
    label_count ↦ int64 ·
    str_count ↦ int64 ·
    is_terminated ↦ logic ·
⟧

variant CoreAst ⟦
    | ProcessDecl(name ↦ text ⸴ params ↦ tensor ⸴ ret_type ↦ text ⸴ body ↦ CoreAst) ·
    | BlockDecl(first ↦ CoreAst ⸴ second ↦ CoreAst) ·
    | BindDecl(name ↦ text ⸴ val_type ↦ text ⸴ value ↦ CoreAst) ·
    | YieldDecl(value ↦ CoreAst) ·
    | EmitDecl(value ↦ CoreAst) ·
    | WhenDecl(cond ↦ CoreAst ⸴ then_block ↦ CoreAst ⸴ else_block ↦ CoreAst) ·
    | CycleDecl(cond ↦ CoreAst ⸴ body ↦ CoreAst) ·
    | BinaryOpDecl(op ↦ text ⸴ left ↦ CoreAst ⸴ right ↦ CoreAst) ·
    | CallDecl(name ↦ text ⸴ args ↦ tensor) ·
    | IdentDecl(name ↦ text) ·
    | IntLitDecl(value ↦ int64) ·
    | StrLitDecl(value ↦ text) ·
⟧

process parse_to_core_ast⦅text file_path⦆ → CoreAst ⟦
    int64 prog_kind ↦ detect_program_kind⦅file_path⦆ ·
    when prog_kind ≡ 0 ⟦
        int64 yield_val ↦ extract_yield_number⦅file_path⦆ ·
        int64 n_str ↦ scan_emitted_strings⦅file_path⦆ ·
        text hello_str ↦ "" ·
        when n_str ≻ 0 ⟦
            hello_str ↦ get_emitted_string_text⦅0⦆ ·
        ⟧
        CoreAst emit_node ↦ variant_init CoreAst ⦅EmitDecl ↦ variant_init CoreAst ⦅StrLitDecl ↦ hello_str⦆⦆ ·
        CoreAst yield_node ↦ variant_init CoreAst ⦅YieldDecl ↦ variant_init CoreAst ⦅IntLitDecl ↦ yield_val⦆⦆ ·
        CoreAst block ↦ variant_init CoreAst ⦅BlockDecl ↦ emit_node ⸴ yield_node⦆ ·
        CoreAst proc ↦ variant_init CoreAst ⦅ProcessDecl ↦ "main" ⸴ tensor⟬⟭ ⸴ "int64" ⸴ block⦆ ·
        yield proc ·
    ⟧

    when prog_kind ≡ 3 ⟦
        int64 n_stmts ↦ scan_statements⦅file_path⦆ ·
        text s0_name ↦ stmt_name⦅0⦆ ·
        int64 s0_val ↦ stmt_value⦅0⦆ ·
        CoreAst s0_ast ↦ variant_init CoreAst ⦅BindDecl ↦ s0_name ⸴ "int64" ⸴ variant_init CoreAst ⦅IntLitDecl ↦ s0_val⦆⦆ ·

        text s1_name ↦ stmt_name⦅1⦆ ·
        int64 s1_val ↦ stmt_value⦅1⦆ ·
        CoreAst s1_ast ↦ variant_init CoreAst ⦅BindDecl ↦ s1_name ⸴ "int64" ⸴ variant_init CoreAst ⦅IntLitDecl ↦ s1_val⦆⦆ ·

        text s2_op ↦ stmt_binop_op⦅2⦆ ·
        text s2_left ↦ stmt_binop_left⦅2⦆ ·
        text s2_right ↦ stmt_binop_right⦅2⦆ ·
        CoreAst s2_l_ast ↦ variant_init CoreAst ⦅IdentDecl ↦ s2_left⦆ ·
        CoreAst s2_r_ast ↦ variant_init CoreAst ⦅IdentDecl ↦ s2_right⦆ ·
        CoreAst s2_bin_ast ↦ variant_init CoreAst ⦅BinaryOpDecl ↦ s2_op ⸴ s2_l_ast ⸴ s2_r_ast⦆ ·
        CoreAst s2_ast ↦ variant_init CoreAst ⦅EmitDecl ↦ s2_bin_ast⦆ ·

        text s3_op ↦ stmt_binop_op⦅3⦆ ·
        text s3_left ↦ stmt_binop_left⦅3⦆ ·
        text s3_right ↦ stmt_binop_right⦅3⦆ ·
        CoreAst s3_l_ast ↦ variant_init CoreAst ⦅IdentDecl ↦ s3_left⦆ ·
        CoreAst s3_r_ast ↦ variant_init CoreAst ⦅IdentDecl ↦ s3_right⦆ ·
        CoreAst s3_bin_ast ↦ variant_init CoreAst ⦅BinaryOpDecl ↦ s3_op ⸴ s3_l_ast ⸴ s3_r_ast⦆ ·
        CoreAst s3_ast ↦ variant_init CoreAst ⦅EmitDecl ↦ s3_bin_ast⦆ ·

        int64 s4_val ↦ stmt_value⦅4⦆ ·
        CoreAst s4_ast ↦ variant_init CoreAst ⦅YieldDecl ↦ variant_init CoreAst ⦅IntLitDecl ↦ s4_val⦆⦆ ·

        CoreAst blk34 ↦ variant_init CoreAst ⦅BlockDecl ↦ s3_ast ⸴ s4_ast⦆ ·
        CoreAst blk23 ↦ variant_init CoreAst ⦅BlockDecl ↦ s2_ast ⸴ blk34⦆ ·
        CoreAst blk12 ↦ variant_init CoreAst ⦅BlockDecl ↦ s1_ast ⸴ blk23⦆ ·
        CoreAst blk01 ↦ variant_init CoreAst ⦅BlockDecl ↦ s0_ast ⸴ blk12⦆ ·

        CoreAst proc_calc ↦ variant_init CoreAst ⦅ProcessDecl ↦ "main" ⸴ tensor⟬⟭ ⸴ "int64" ⸴ blk01⦆ ·
        yield proc_calc ·
    ⟧

    when prog_kind ≡ 4 ⟦
        int64 ok_if ↦ scan_if_else⦅file_path⦆ ·
        int64 n_str_if ↦ scan_emitted_strings⦅file_path⦆ ·
        text var_name ↦ get_if_var_name⦅⦆ ·
        int64 var_val ↦ get_if_var_val⦅⦆ ·
        text cond_var ↦ get_if_cond_var⦅⦆ ·
        text cond_op ↦ get_if_cond_op⦅⦆ ·
        int64 cond_val ↦ get_if_cond_val⦅⦆ ·
        int64 y_val ↦ get_if_yield_val⦅⦆ ·
        text then_str ↦ get_emitted_string_text⦅0⦆ ·
        text else_str ↦ get_emitted_string_text⦅1⦆ ·

        CoreAst bind_ast ↦ variant_init CoreAst ⦅BindDecl ↦ var_name ⸴ "int64" ⸴ variant_init CoreAst ⦅IntLitDecl ↦ var_val⦆⦆ ·

        CoreAst cond_left ↦ variant_init CoreAst ⦅IdentDecl ↦ cond_var⦆ ·
        CoreAst cond_right ↦ variant_init CoreAst ⦅IntLitDecl ↦ cond_val⦆ ·
        CoreAst cond_ast ↦ variant_init CoreAst ⦅BinaryOpDecl ↦ cond_op ⸴ cond_left ⸴ cond_right⦆ ·

        CoreAst then_emit ↦ variant_init CoreAst ⦅EmitDecl ↦ variant_init CoreAst ⦅StrLitDecl ↦ then_str⦆⦆ ·
        CoreAst else_emit ↦ variant_init CoreAst ⦅EmitDecl ↦ variant_init CoreAst ⦅StrLitDecl ↦ else_str⦆⦆ ·
        CoreAst when_ast ↦ variant_init CoreAst ⦅WhenDecl ↦ cond_ast ⸴ then_emit ⸴ else_emit⦆ ·

        CoreAst yield_ast ↦ variant_init CoreAst ⦅YieldDecl ↦ variant_init CoreAst ⦅IntLitDecl ↦ y_val⦆⦆ ·

        CoreAst blk_when_yield ↦ variant_init CoreAst ⦅BlockDecl ↦ when_ast ⸴ yield_ast⦆ ·
        CoreAst blk_all ↦ variant_init CoreAst ⦅BlockDecl ↦ bind_ast ⸴ blk_when_yield⦆ ·

        CoreAst proc_if ↦ variant_init CoreAst ⦅ProcessDecl ↦ "main" ⸴ tensor⟬⟭ ⸴ "int64" ⸴ blk_all⦆ ·
        yield proc_if ·
    ⟧

    CoreAst dummy_yield ↦ variant_init CoreAst ⦅YieldDecl ↦ variant_init CoreAst ⦅IntLitDecl ↦ 0⦆⦆ ·
    CoreAst dummy_proc ↦ variant_init CoreAst ⦅ProcessDecl ↦ "main" ⸴ tensor⟬⟭ ⸴ "int64" ⸴ dummy_yield⦆ ·
    yield dummy_proc ·
⟧

process walk_core_ast⦅CoreAst target_node ⸴ int64 temp_counter⦆ → int64 ⟦
    match target_node ⟦
        | ProcessDecl(name ⸴ params ⸴ ret_type ⸴ body) ⟹
            emit "" ·
            emit "declare i32 @qadav_pcc_attest(i8*, i8*, i8*)" ·
            emit "declare i32 @qadav_pcc_verify()" ·
            emit "declare i32 @qadav_pcc_corrupt(i32)" ·
            emit "" ·
            reset_label_counter⦅⦆ ·
            int64 scount ↦ get_emitted_string_count⦅⦆ ·
            int64 si ↦ 0 ·
            cycle si ≺ scount ⟦
                text sdef ↦ format_emitted_str_def⦅si⦆ ·
                emit sdef ·
                si ← si ⊕ 1 ·
            ⟧
            emit "" ·
            emit "define i32 @\"main\"() {" ·
            emit "entry:" ·
            int64 t_proc ↦ walk_core_ast⦅body ⸴ temp_counter⦆ ·
            emit "}" ·
            emit "" ·
            yield t_proc ·
        | BlockDecl(first ⸴ second) ⟹
            int64 t1 ↦ walk_core_ast⦅first ⸴ temp_counter⦆ ·
            int64 t2 ↦ walk_core_ast⦅second ⸴ t1⦆ ·
            yield t2 ·
        | BindDecl(name ⸴ val_type ⸴ value) ⟹
            text alloc_line ↦ format_alloca⦅name⦆ ·
            emit alloc_line ·
            int64 t_val ↦ walk_core_ast⦅value ⸴ temp_counter⦆ ·
            int64 v ↦ last_int_value⦅⦆ ·
            text store_line ↦ format_store⦅name ⸴ v⦆ ·
            emit store_line ·
            yield temp_counter ·
        | EmitDecl(inner) ⟹
            int64 t_inner ↦ walk_core_ast⦅inner ⸴ temp_counter⦆ ·
            int64 ekind ↦ get_last_emit_kind⦅⦆ ·
            int64 last_t ↦ get_last_temp⦅⦆ ·
            when ekind ≡ 0 ⟦
                text scall_txt ↦ format_emitted_str_call⦅last_t⦆ ·
                emit scall_txt ·
            ⟧ otherwise ⟦
                text scall_int ↦ format_emit_int_call⦅last_t⦆ ·
                emit scall_int ·
            ⟧
            yield t_inner ·
        | StrLitDecl(s) ⟹
            int64 str_idx ↦ get_string_index⦅s⦆ ·
            when str_idx ≺ 0 ⟦
                str_idx ↦ 0 ·
            ⟧
            text sgep ↦ format_emitted_str_gep⦅str_idx ⸴ temp_counter⦆ ·
            emit sgep ·
            set_last_temp⦅temp_counter⦆ ·
            set_last_emit_kind⦅0⦆ ·
            yield temp_counter ⊕ 1 ·
        | IntLitDecl(v) ⟹
            set_last_int_value⦅v⦆ ·
            set_last_temp⦅0 ⊖ 1⦆ ·
            set_last_emit_kind⦅1⦆ ·
            yield temp_counter ·
        | IdentDecl(name) ⟹
            text load_line ↦ format_load⦅name ⸴ temp_counter⦆ ·
            emit load_line ·
            set_last_temp⦅temp_counter⦆ ·
            set_last_emit_kind⦅1⦆ ·
            yield temp_counter ⊕ 1 ·
        | BinaryOpDecl(op ⸴ left ⸴ right) ⟹
            int64 t_l ↦ walk_core_ast⦅left ⸴ temp_counter⦆ ·
            int64 reg_l ↦ get_last_temp⦅⦆ ·
            int64 t_r ↦ walk_core_ast⦅right ⸴ t_l⦆ ·
            int64 reg_r ↦ get_last_temp⦅⦆ ·
            int64 res_temp ↦ t_r ·
            when reg_r ≺ 0 ⟦
                int64 imm_val ↦ last_int_value⦅⦆ ·
                text icmp_line ↦ format_icmp_imm⦅op ⸴ res_temp ⸴ reg_l ⸴ imm_val⦆ ·
                emit icmp_line ·
            ⟧ otherwise ⟦
                text binop_line ↦ format_binop⦅op ⸴ res_temp ⸴ reg_l ⸴ reg_r⦆ ·
                emit binop_line ·
            ⟧
            set_last_temp⦅res_temp⦆ ·
            set_last_emit_kind⦅1⦆ ·
            yield res_temp ⊕ 1 ·
        | YieldDecl(inner) ⟹
            int64 t_yield ↦ walk_core_ast⦅inner ⸴ temp_counter⦆ ·
            int64 val ↦ last_int_value⦅⦆ ·
            text strunc ↦ format_trunc_line_id⦅temp_counter ⸴ val⦆ ·
            emit strunc ·
            text sret ↦ format_ret_line_id⦅temp_counter⦆ ·
            emit sret ·
            yield temp_counter ⊕ 1 ·
        | WhenDecl(cond ⸴ then_block ⸴ else_block) ⟹
            int64 t_cond ↦ walk_core_ast⦅cond ⸴ temp_counter⦆ ·
            int64 cond_reg ↦ get_last_temp⦅⦆ ·
            int64 then_id ↦ next_label_id⦅⦆ ·
            int64 else_id ↦ next_label_id⦅⦆ ·
            int64 merge_id ↦ next_label_id⦅⦆ ·
            text br_cond ↦ format_br_cond⦅cond_reg ⸴ then_id ⸴ else_id⦆ ·
            emit br_cond ·
            text lbl_then ↦ format_label⦅"when_then" ⸴ then_id⦆ ·
            emit lbl_then ·
            int64 t_then ↦ walk_core_ast⦅then_block ⸴ t_cond⦆ ·
            text br_m1 ↦ format_br_label⦅"when_merge" ⸴ merge_id⦆ ·
            emit br_m1 ·
            text lbl_else ↦ format_label⦅"when_else" ⸴ else_id⦆ ·
            emit lbl_else ·
            int64 t_else ↦ walk_core_ast⦅else_block ⸴ t_then⦆ ·
            text br_m2 ↦ format_br_label⦅"when_merge" ⸴ merge_id⦆ ·
            emit br_m2 ·
            text lbl_merge ↦ format_label⦅"when_merge" ⸴ merge_id⦆ ·
            emit lbl_merge ·
            yield t_else ·
        | CycleDecl(cond ⸴ body) ⟹
            yield temp_counter ·
        | CallDecl(name ⸴ args) ⟹
            yield temp_counter ·
    ⟧
    yield temp_counter ·
⟧

process emit_common_decls_0⦅⦆ → logic ⟦
    emit "; ModuleID = 'qadav_module'" ·
    emit "source_filename = \"qadav_module\"" ·
    emit "" ·
    emit "declare void @qadav_emit_int(i64)" ·
    emit "declare void @qadav_emit_float(double)" ·
    emit "declare void @qadav_emit_text(i8*)" ·
    emit "declare void @qadav_emit_logic(i32)" ·
    emit "declare void @qadav_emit_qubit(i8*)" ·
    emit "declare void @qadav_exit(i32)" ·
    emit "" ·
    emit "declare i8* @qadav_tensor_create(i32, i32, i32*)" ·
    emit "declare void @qadav_tensor_free(i8*)" ·
    emit "declare void @qadav_tensor_set_i64(i8*, i32, i64)" ·
    emit "declare i64 @qadav_tensor_get_i64(i8*, i32)" ·
    emit "declare void @qadav_tensor_set_f64(i8*, i32, double)" ·
    emit "declare double @qadav_tensor_get_f64(i8*, i32)" ·
    emit "declare i8* @qadav_tensor_add(i8*, i8*)" ·
    emit "declare i8* @qadav_tensor_sub(i8*, i8*)" ·
    emit "declare i8* @qadav_tensor_mul(i8*, i8*)" ·
    emit "declare i8* @qadav_tensor_div(i8*, i8*)" ·
    emit "declare i8* @qadav_tensor_add_scalar_f64(i8*, double)" ·
    emit "declare i8* @qadav_tensor_mul_scalar_f64(i8*, double)" ·
    emit "declare i8* @qadav_tensor_sub_scalar_f64(i8*, double)" ·
    emit "declare i8* @qadav_tensor_div_scalar_f64(i8*, double)" ·
    emit "declare i8* @qadav_tensor_add_scalar_i64(i8*, i64)" ·
    emit "declare i8* @qadav_tensor_mul_scalar_i64(i8*, i64)" ·
    emit "declare i8* @qadav_tensor_sub_scalar_i64(i8*, i64)" ·
    emit "declare i8* @qadav_tensor_div_scalar_i64(i8*, i64)" ·
    emit "declare i8* @qadav_tensor_matmul(i8*, i8*)" ·
    emit "declare i64 @qadav_tensor_reduce_sum_i64(i8*)" ·
    emit "declare double @qadav_tensor_reduce_sum_f64(i8*)" ·
    emit "declare i64 @qadav_tensor_reduce_prod_i64(i8*)" ·
    emit "declare double @qadav_tensor_reduce_prod_f64(i8*)" ·
    emit "declare i8* @qadav_tensor_transpose(i8*)" ·
    emit "declare void @qadav_tensor_print_i64(i8*)" ·
    emit "declare void @qadav_tensor_print_f64(i8*)" ·
    emit "" ·
    emit "declare i8* @qadav_network_create(i32, i32*, i32*, i32*)" ·
    emit "declare void @qadav_network_free(i8*)" ·
    emit "declare i8* @qadav_network_forward(i8*, i8*)" ·
    emit "declare void @qadav_network_backward(i8*, i8*, i8*)" ·
    emit "declare void @qadav_network_sgd_step(i8*, double)" ·
    emit "declare void @qadav_network_adam_step(i8*, double, i32)" ·
    emit "declare double @qadav_loss_mse(i8*, i8*)" ·
    emit "declare double @qadav_loss_cross_entropy(i8*, i8*)" ·
    emit "declare double @qadav_train_step(i8*, i8*, i8*, i32, i32, double, i32)" ·
    emit "declare void @qadav_train_epochs(i8*, i8*, i8*, i32, i32, double, i32)" ·
    emit "declare double @qadav_sqrt(double)" ·
    emit "declare double @qadav_exp(double)" ·
    emit "declare double @qadav_log(double)" ·
    yield affirm ·
⟧

process emit_common_decls_1⦅⦆ → logic ⟦
    emit "" ·
    emit "declare i8* @qadav_get_qstate()" ·
    emit "declare i8* @qadav_qstate_create(i32)" ·
    emit "declare void @qadav_qstate_free(i8*)" ·
    emit "declare i32 @qadav_qubit_alloc(i8*)" ·
    emit "declare void @qadav_gate_h(i8*, i32)" ·
    emit "declare void @qadav_gate_x(i8*, i32)" ·
    emit "declare void @qadav_gate_y(i8*, i32)" ·
    emit "declare void @qadav_gate_z(i8*, i32)" ·
    emit "declare void @qadav_gate_s(i8*, i32)" ·
    emit "declare void @qadav_gate_t(i8*, i32)" ·
    emit "declare void @qadav_gate_cnot(i8*, i32, i32)" ·
    emit "declare i32 @qadav_measure(i8*, i32)" ·
    emit "declare double @qadav_probability(i8*, i32)" ·
    emit "declare void @qadav_qstate_print(i8*)" ·
    emit "" ·
    emit "declare i32 @qadav_is_prime(i64)" ·
    emit "declare i32 @qadav_factorize(i64, i64*, i32)" ·
    emit "declare i64 @qadav_encode_concept(i64*, i32)" ·
    emit "declare void @qadav_print_concept(i64)" ·
    emit "" ·
    emit "declare i8* @qadav_dataset_load(i8*)" ·
    emit "declare void @qadav_dataset_free(i8*)" ·
    emit "declare i8* @qadav_dataset_get(i8*, i8*)" ·
    emit "declare void @qadav_dataset_normalize_minmax(i8*)" ·
    emit "declare void @qadav_dataset_normalize_zscore(i8*)" ·
    emit "declare void @qadav_dataset_shuffle(i8*)" ·
    emit "declare void @qadav_dataset_print(i8*)" ·
    emit "" ·
    emit "declare i32 @qadav_quasi_add(i64, i64)" ·
    emit "declare i32 @qadav_quasi_mul(i64, i64)" ·
    emit "declare i32 @qadav_quasi_neg(i64)" ·
    emit "declare i8* @qadav_quasi_grid_create(i32, i32)" ·
    emit "declare i64 @qadav_quasi_grid_get(i8*, i32, i32)" ·
    emit "declare void @qadav_quasi_grid_set(i8*, i32, i32, i64)" ·
    emit "declare double @qadav_quasi_energy_ising(i8*)" ·
    emit "declare double @qadav_quasi_energy_majority(i8*)" ·
    emit "declare void @qadav_quasi_minimize(i8*, i32)" ·
    emit "declare void @qadav_quasi_print(i64)" ·
    emit "declare void @qadav_quasi_grid_print(i8*)" ·
    emit "" ·
    emit "declare i8* @qadav_confidence_create(double, double, i8)" ·
    emit "declare void @qadav_confidence_free(i8*)" ·
    emit "declare void @qadav_confidence_print(i8*)" ·
    emit "declare i8* @qadav_confidence_add(i8*, i8*)" ·
    emit "declare i8* @qadav_confidence_mul(i8*, i8*)" ·
    emit "declare i8* @qadav_confidence_min(i8*, i8*)" ·
    emit "declare i32 @qadav_confidence_assert(i8*, double)" ·
    emit "" ·
    emit "declare i8* @qadav_memory_create(i64)" ·
    yield affirm ·
⟧

process emit_common_decls_2⦅⦆ → logic ⟦
    emit "declare void @qadav_memory_free(i8*)" ·
    emit "declare void @qadav_memory_remember(i8*, i8*, i64)" ·
    emit "declare i64 @qadav_memory_recall(i8*, i8*)" ·
    emit "declare void @qadav_memory_print(i8*)" ·
    emit "declare i8* @qadav_graph_create()" ·
    emit "declare void @qadav_graph_free(i8*)" ·
    emit "declare void @qadav_graph_node(i8*, i8*, i64)" ·
    emit "declare void @qadav_graph_link(i8*, i8*, i8*, double)" ·
    emit "declare i8* @qadav_graph_trace(i8*, i8*, i64)" ·
    emit "declare void @qadav_graph_print(i8*)" ·
    emit "declare i8* @qadav_procedure_create(i8*)" ·
    emit "declare void @qadav_procedure_free(i8*)" ·
    emit "declare i8* @qadav_qeeh_create(i32, double*)" ·
